[Desktop Entry]
Type=Application
Name=Windows VM
Comment=Start the Windows VM and connect to it
Exec=win-vm
Icon=computer
# FreeRDP's window, so it shows with this entry's name and icon (Strand's workspace chips)
StartupWMClass=com.freerdp.client.sdl3
Terminal=false
Keywords=vm;windows;virtual;machine;
Categories=System;Emulator;
