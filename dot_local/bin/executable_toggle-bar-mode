#!/usr/bin/env python3
"""Toggle Quickshell bar between sidebar and topbar mode."""

import json
import subprocess
import sys
from pathlib import Path


def fail(message: str) -> None:
    # Invoked from a keybind (Super+Shift+T) — stderr goes nowhere, so notify.
    print(message, file=sys.stderr)
    subprocess.Popen(
        ["notify-send", "-a", "Bar Mode", "-u", "critical", "Bar Mode", message],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    sys.exit(1)


def chezmoi_root() -> Path:
    try:
        result = subprocess.run(
            ["chezmoi", "source-path"], capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            return Path(result.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path.home() / ".local/share/chezmoi"


# Write both copies like theme-switch does, so `chezmoi apply` doesn't revert the toggle
live = Path.home() / ".config/palette/active.json"
source = chezmoi_root() / "dot_config/palette/active.json"

try:
    data = json.loads(live.read_text())
except FileNotFoundError:
    fail(f"{live} missing — run theme-switch first.")
except json.JSONDecodeError as e:
    fail(f"{live} is corrupt ({e}) — re-run theme-switch.")

qs = data.setdefault("_quickshell", {})
current = qs.get("barMode", "side")
qs["barMode"] = "top" if current == "side" else "side"

# Quickshell watches the live copy — write temp + rename (like theme-switch's
# write_json_atomic) so it never observes a partial file.
for palette in (live, source):
    tmp = palette.with_name(palette.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(palette)

print(f"Bar mode: {qs['barMode']}")
