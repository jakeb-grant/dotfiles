#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""
Monitor Profile Application Tool

Applies saved monitor profiles to Hyprland configuration.
Generates ~/.config/hypr/monitors.conf and optionally applies via hyprctl.

Usage:
    monitor-apply <profile-name>       Apply a saved profile
    monitor-apply --detect              Auto-detect and apply matching profile
    monitor-apply --current             Show currently active profile
    monitor-apply --list                List all available profiles
"""

import argparse
import json
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any


# ==============================================================================
# Configuration
# ==============================================================================

PROFILE_DIR = Path.home() / ".config" / "monitor-profiles"
METADATA_FILE = PROFILE_DIR / ".metadata.json"
OUTPUT_CONFIG = Path.home() / ".config" / "hypr" / "monitors.conf"


# ==============================================================================
# Default Configuration
# ==============================================================================

def ensure_default_config() -> None:
    """Ensure monitors.conf exists with default auto setup if missing."""
    if OUTPUT_CONFIG.exists():
        return

    OUTPUT_CONFIG.parent.mkdir(parents=True, exist_ok=True)

    default_config = """# Default monitor configuration
# This uses Hyprland's automatic monitor detection and positioning.
# To customize, use: monitor-mgr

# Automatic monitor setup
monitor = ,preferred,auto,1
"""

    try:
        with open(OUTPUT_CONFIG, "w") as f:
            f.write(default_config)
    except IOError:
        pass  # Silently fail, Hyprland will handle it


# ==============================================================================
# Profile Loading
# ==============================================================================

def load_profile(profile_name: str) -> dict[str, Any] | None:
    """Load a monitor profile from JSON file."""
    profile_file = PROFILE_DIR / f"{profile_name}.json"

    if not profile_file.exists():
        return None

    try:
        with open(profile_file) as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError) as e:
        print(f"Error loading profile '{profile_name}': {e}", file=sys.stderr)
        return None


def list_profiles() -> list[str]:
    """List all available monitor profiles."""
    if not PROFILE_DIR.exists():
        return []

    profiles = []
    for file in PROFILE_DIR.glob("*.json"):
        if file.name != ".metadata.json":
            profiles.append(file.stem)

    return sorted(profiles)


def load_metadata() -> dict[str, Any]:
    """Load metadata file, returns default if not found."""
    if not METADATA_FILE.exists():
        return {"active_profile": None, "last_modified": None}

    try:
        with open(METADATA_FILE) as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return {"active_profile": None, "last_modified": None}


def save_metadata(metadata: dict[str, Any]) -> None:
    """Save metadata file."""
    METADATA_FILE.parent.mkdir(parents=True, exist_ok=True)

    with open(METADATA_FILE, "w") as f:
        json.dump(metadata, f, indent=2)


# ==============================================================================
# Monitor Detection
# ==============================================================================

def detect_monitors() -> list[dict[str, Any]]:
    """Detect current monitor setup from hyprctl."""
    try:
        result = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            capture_output=True,
            text=True,
            timeout=5
        )

        if result.returncode != 0:
            return []

        monitors = json.loads(result.stdout)

        return [
            {
                "name": m["name"],
                "enabled": not m.get("disabled", False),
                "resolution": f"{m['width']}x{m['height']}",
                "refresh_rate": round(m["refreshRate"], 2),
                "position": {"x": m["x"], "y": m["y"]},
                "scale": m["scale"],
                "transform": m.get("transform", 0),
                "mode": f"{m['width']}x{m['height']}@{round(m['refreshRate'])}",
            }
            for m in monitors
        ]
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError, KeyError) as e:
        print(f"Error detecting monitors: {e}", file=sys.stderr)
        return []


def find_matching_profile(connected_monitors: list[str]) -> str | None:
    """Find profile matching current monitor setup."""
    profiles = list_profiles()
    connected_set = set(connected_monitors)

    for profile_name in profiles:
        profile = load_profile(profile_name)
        if not profile:
            continue

        profile_monitors = set(m["name"] for m in profile.get("monitors", []))

        if profile_monitors == connected_set:
            return profile_name

    return None


# ==============================================================================
# Config Generation
# ==============================================================================

def generate_hyprland_config(profile: dict[str, Any]) -> str:
    """Generate Hyprland monitor configuration from profile."""
    lines = [
        f"# Generated by monitor-apply from profile: {profile['name']}",
        f"# {profile.get('description', 'No description')}",
        f"# Last updated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        "",
        "# Monitor configurations",
    ]

    # Monitor settings
    for monitor in profile.get("monitors", []):
        if monitor.get("enabled", True):
            mode = monitor.get("mode", "preferred")
            pos_x = monitor["position"]["x"]
            pos_y = monitor["position"]["y"]
            pos = f"{pos_x}x{pos_y}"
            scale = monitor.get("scale", 1.0)
            lines.append(f"monitor = {monitor['name']},{mode},{pos},{scale}")
        else:
            lines.append(f"monitor = {monitor['name']},disable")

    # Fallback for unmapped monitors
    lines.append("monitor = ,preferred,auto,1")
    lines.append("")

    # Workspace assignments
    if workspaces := profile.get("workspaces"):
        lines.append("# Workspace assignments")
        for ws in workspaces:
            default = ",default:true" if ws.get("default") else ""
            lines.append(f"workspace = {ws['id']}, monitor:{ws['monitor']}{default}")
        lines.append("")

    # Lid switch handling
    if lid := profile.get("lid_switch"):
        if lid.get("enabled"):
            lines.append("# Lid switch handling")
            monitor = lid["monitor"]
            on_open = lid.get("on_open", "preferred,0x0,1")
            lines.append(
                f'bindl = ,switch:on:Lid Switch,exec,hyprctl keyword monitor "{monitor},disable"'
            )
            lines.append(
                f'bindl = ,switch:off:Lid Switch,exec,hyprctl keyword monitor "{monitor},{on_open}"'
            )

    return "\n".join(lines)


# ==============================================================================
# Profile Application
# ==============================================================================

def apply_profile_runtime(profile: dict[str, Any]) -> bool:
    """Apply profile to running Hyprland via hyprctl."""
    success = True

    # Apply monitor configurations
    for monitor in profile.get("monitors", []):
        if monitor.get("enabled", True):
            mode = monitor.get("mode", "preferred")
            pos_x = monitor["position"]["x"]
            pos_y = monitor["position"]["y"]
            pos = f"{pos_x}x{pos_y}"
            scale = monitor.get("scale", 1.0)
            cmd = f"{monitor['name']},{mode},{pos},{scale}"
        else:
            cmd = f"{monitor['name']},disable"

        try:
            result = subprocess.run(
                ["hyprctl", "keyword", "monitor", cmd],
                capture_output=True,
                timeout=5
            )
            if result.returncode != 0:
                print(f"Warning: Failed to apply monitor {monitor['name']}", file=sys.stderr)
                success = False
        except (subprocess.TimeoutExpired, FileNotFoundError):
            print(f"Warning: Could not apply monitor {monitor['name']}", file=sys.stderr)
            success = False

    # Move workspaces to monitors
    for ws in profile.get("workspaces", []):
        try:
            subprocess.run(
                ["hyprctl", "dispatch", "moveworkspacetomonitor", str(ws["id"]), ws["monitor"]],
                capture_output=True,
                timeout=5
            )
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass  # Non-critical

    return success


def apply_profile(profile_name: str, runtime: bool = True) -> bool:
    """Apply a monitor profile."""
    profile = load_profile(profile_name)

    if not profile:
        print(f"Error: Profile '{profile_name}' not found", file=sys.stderr)
        print(f"Available profiles: {', '.join(list_profiles())}", file=sys.stderr)
        return False

    # Generate configuration file
    config_content = generate_hyprland_config(profile)

    OUTPUT_CONFIG.parent.mkdir(parents=True, exist_ok=True)

    try:
        with open(OUTPUT_CONFIG, "w") as f:
            f.write(config_content)
        print(f"Generated config: {OUTPUT_CONFIG}")
    except IOError as e:
        print(f"Error writing config file: {e}", file=sys.stderr)
        return False

    # Apply runtime if Hyprland is running
    if runtime:
        try:
            subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True, check=True)
            if apply_profile_runtime(profile):
                print(f"Applied profile '{profile_name}' to running Hyprland")
            else:
                print(f"Applied profile '{profile_name}' with some warnings", file=sys.stderr)
        except (subprocess.CalledProcessError, FileNotFoundError):
            print("Hyprland not running - config generated only")

    # Update metadata
    metadata = load_metadata()
    metadata["active_profile"] = profile_name
    metadata["last_modified"] = datetime.now().isoformat()
    save_metadata(metadata)

    return True


# ==============================================================================
# Main
# ==============================================================================

def main() -> int:
    """Main entry point."""
    # Ensure default config exists
    ensure_default_config()

    parser = argparse.ArgumentParser(
        description="Apply Hyprland monitor profiles",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    group = parser.add_mutually_exclusive_group()
    group.add_argument("profile", nargs="?", help="Profile name to apply")
    group.add_argument("--detect", action="store_true", help="Auto-detect and apply matching profile")
    group.add_argument("--current", action="store_true", help="Show currently active profile")
    group.add_argument("--list", action="store_true", help="List all available profiles")

    parser.add_argument("--no-runtime", action="store_true", help="Generate config only, don't apply via hyprctl")

    args = parser.parse_args()

    # List profiles
    if args.list:
        profiles = list_profiles()
        if not profiles:
            print("No profiles found")
            return 1

        metadata = load_metadata()
        active = metadata.get("active_profile")

        print("Available profiles:")
        for profile in profiles:
            marker = " (active)" if profile == active else ""
            print(f"  - {profile}{marker}")
        return 0

    # Show current profile
    if args.current:
        metadata = load_metadata()
        active = metadata.get("active_profile")

        if active:
            print(f"Active profile: {active}")
            return 0
        else:
            print("No active profile")
            return 1

    # Auto-detect
    if args.detect:
        monitors = detect_monitors()
        if not monitors:
            print("Error: Could not detect monitors", file=sys.stderr)
            return 1

        monitor_names = [m["name"] for m in monitors]
        print(f"Detected monitors: {', '.join(monitor_names)}")

        profile_name = find_matching_profile(monitor_names)
        if not profile_name:
            print("No matching profile found", file=sys.stderr)
            return 1

        print(f"Found matching profile: {profile_name}")
        return 0 if apply_profile(profile_name, not args.no_runtime) else 1

    # Apply specific profile
    if args.profile:
        return 0 if apply_profile(args.profile, not args.no_runtime) else 1

    # No arguments
    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
