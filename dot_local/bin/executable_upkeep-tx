#!/usr/bin/env bash
# upkeep-tx: the package changes of Strand's Upkeep window (~/.config/strand/upkeep.strand).
# The window reads everything else itself, and follows what a change prints as Strand
# follows any job's output; this changes the system, checks first, and runs the update
# check that can take longer than an action that answers may.
#
#   upkeep-tx updates          checkupdates (its own copy of the sync db, no root) into
#                              ~/.cache/upkeep/updates.json: {"updates": ["name old -> new"…],
#                              "fail": why or null, "at": when}; a failed check keeps the
#                              last list and says why
#   upkeep-tx check OP [PKG…]  what would stop OP to ask, found without root and changing
#                              nothing: lines "ask <why>" (a question pacman would ask:
#                              a replacement, a conflict, a provider to choose), "fail <why>"
#                              (pacman refuses it as it stands), "also <name>" (removed
#                              with it: purge's dependencies nothing else needs), "aur <names>"
#                              (built from PKGBUILDs) and "note <text>"
#   upkeep-tx run OP [PKG…]    OP with no questions: pacman through pkexec (Strand's polkit
#                              prompt asks the password), the AUR through yay --sudo pkexec
#                              with its menus answered None (no PKGBUILD review). It first
#                              checks, and stops with 3 where pacman would ask. What the
#                              program prints comes out as it is, line by line; then its
#                              summary, on stderr, each line starting "upkeep-tx: " (why it
#                              failed, a replacement pacman took without asking). Exits 0
#                              done, 1 failed, 3 it would have asked, 126 the password was
#                              cancelled
#   upkeep-tx kitty OP [PKG…]  `term` in a Kitty window (class upkeep-term), waited for; then
#                              its summary as `run`'s ("yay exited with status 1 in Kitty")
#                              and 0 done, 1 not
#   upkeep-tx term OP [PKG…]   OP in this terminal with every question asked (sudo pacman,
#                              or yay with its diffs and all), then waits for Enter
#
# OP: upgrade (everything: -Syu; PKGs the AUR updates, if any), update (PKGs, -S --needed),
# install (-S), reinstall (-S), rebuild (-S --rebuild), remove (-R), purge (-Rns), clean
# (paccache -r). Each PKG is one name, an argument of its own.
set -u

# ~/.cache/upkeep whatever XDG_CACHE_HOME says: the window reads updates.json from there
CACHE="$HOME/.cache/upkeep"
# checkupdates' copy of the sync db, synced without root: what an upgrade would do is read
# from it. Every checkupdates here takes its lock, so two never sync it at once
SYNCDB="$CACHE/syncdb"
UPDATES="$CACHE/updates.json"
# what runs as root, written out: never a program found on PATH
PKEXEC=/usr/bin/pkexec
SUDO=/usr/bin/sudo
PACMAN=/usr/bin/pacman
PACCACHE=/usr/bin/paccache
STDBUF=/usr/bin/stdbuf

# a line of the summary, which the window reads from the run's last lines
say() { printf 'upkeep-tx: %s\n' "$*" >&2; }

# yay's flags for a run with no questions, root through pkexec and the pacman above. Its
# sudo flags put stdbuf after pkexec, so pacman's output comes line by line (pkexec drops
# stdbuf's preload)
YAY_QUIET=(--sudo "$PKEXEC" --sudoflags "$STDBUF -oL -eL" --pacman "$PACMAN" --noconfirm
  --answerclean None --answerdiff None --answeredit None --answerupgrade None --removemake --color never)

# the PKGs split into those in a sync repo and those only in the AUR
split_pkgs() {
  local all p
  REPO=() AUR=()
  all=$(pacman -Slq 2>/dev/null)
  for p in "$@"; do
    if grep -qFx -- "$p" <<<"$all"; then REPO+=("$p"); else AUR+=("$p"); fi
  done
}

# checkupdates over the copy, waiting $1 s at most (0: as long as it takes); its list in
# CU_OUT, why it failed in CU_ERR
checkupdates_db() {
  local t=() err code
  CU_OUT="" CU_ERR=""
  [ "${1:-0}" -gt 0 ] && t=(timeout "$1")
  mkdir -p "$CACHE" || { CU_ERR="could not make $CACHE"; return 1; }
  command -v checkupdates >/dev/null || { CU_ERR="checkupdates not found (install pacman-contrib)"; return 1; }
  err=$(mktemp)
  CU_OUT=$(CHECKUPDATES_DB="$SYNCDB" "${t[@]}" flock "$CACHE/syncdb.lock" checkupdates --nocolor 2>"$err")
  code=$?
  case $code in
    0) ;;
    2) CU_OUT="" ;;
    124) CU_ERR="checkupdates took longer than $1 s" ;;
    *) CU_ERR=$(grep -m1 . "$err" || echo "checkupdates failed (exit status $code)") ;;
  esac
  rm -f "$err"
  [ -z "$CU_ERR" ]
}

updates() {
  local tmp last='{}'
  checkupdates_db 0
  [ -f "$UPDATES" ] && last=$(cat "$UPDATES" 2>/dev/null)
  [ -n "$last" ] || last='{}'
  tmp=$(mktemp "$CACHE/.updates.XXXXXX") || exit 1
  # a failed check keeps the last list
  jq -n --arg out "$CU_OUT" --arg fail "$CU_ERR" --arg at "$(date -Iseconds)" --argjson last "$last" \
    '{updates: (if $fail == "" then ($out | split("\n") | map(select(. != ""))) else ($last.updates // []) end),
      fail: (if $fail == "" then null else $fail end), at: $at}' >"$tmp" 2>/dev/null ||
    jq -n --arg fail "$CU_ERR" --arg at "$(date -Iseconds)" '{updates: [], fail: (if $fail == "" then "could not write the list" else $fail end), at: $at}' >"$tmp"
  mv -f "$tmp" "$UPDATES"
}

# what pacman would ask: its questions as it prints them, --noconfirm answering
# them with their defaults in a run that only prints
questions() {
  grep -E ':: (Replace .* with .*\?|There are [0-9]+ providers available|.* are in conflict)|conflicting dependencies' |
    sed -e 's/^:: //' -e 's/ *\[[YyNn]\/[YyNn]\] *$//' | sort -u
}

# -Qi / -Si records as lines: name, version, provides, conflicts (tab-separated, each
# list space-separated)
rels() {
  awk -F' *: ' '
    function emit() { if (n != "") print n "\t" v "\t" p "\t" c; n = v = p = c = "" }
    function list(s) { if (s == "None") return ""; gsub(/  +/, " ", s); return s }
    /^Name /           { n = $2 }
    /^Version /        { v = $2 }
    /^Provides /       { p = list($2) }
    /^Conflicts With / { c = list($2) }
    /^$/               { emit() }
    END                { emit() }'
}

# does the package $2 (version $3, providing $4) satisfy the dependency $1
satisfies() {
  local dep=$1 dn op dv p pn
  dn=${dep%%[<>=]*}; op=${dep#"$dn"}; dv=${op##*[<>=]}; op=${op%"$dv"}
  [ "$2" = "$dn" ] && ver_ok "$3" "$op" "$dv" && return 0
  for p in $4; do
    pn=${p%%=*}
    [ "$pn" = "$dn" ] || continue
    [ -z "$op" ] && return 0
    [ "$p" != "$pn" ] && ver_ok "${p#*=}" "$op" "$dv" && return 0
  done
  return 1
}
ver_ok() {
  local r
  [ -z "$2" ] && return 0
  r=$(vercmp "$1" "$3" 2>/dev/null) || return 0
  case $2 in
    '<') [ "$r" -lt 0 ] ;; '<=') [ "$r" -le 0 ] ;; '=') [ "$r" -eq 0 ] ;;
    '>=') [ "$r" -ge 0 ] ;; '>') [ "$r" -gt 0 ] ;; *) return 0 ;;
  esac
}

# pacman's dry run doesn't look for conflicts, so they are found here: each target's
# Conflicts With against what is installed (its name or what it provides), and what is
# installed against each target, versions compared where a conflict names one. A package
# the change itself upgrades is left out. $1 the dbpath for -Si ("" the system's), then
# the targets; "ask X and Y are in conflict" for each
conflicts() {
  local db=$1 dbo=() tgt inst
  shift
  [ $# -gt 0 ] || return 0
  [ -n "$db" ] && dbo=(--dbpath "$db")
  tgt=$(LC_ALL=C pacman -Si "${dbo[@]}" -- "$@" 2>/dev/null | rels)
  inst=$(LC_ALL=C pacman -Qi 2>/dev/null | rels)
  awk -F'\t' '
    function dname(d) { sub(/[<>=].*/, "", d); return d }
    NR == FNR { tn[++nt] = $1; tv[nt] = $2; tp[nt] = $3; tc[nt] = $4; is_t[$1] = 1; next }
    is_t[$1] { next }
    {
      ni++; in_[ni] = $1; iv[ni] = $2; ip[ni] = $3
      by[$1] = by[$1] " " ni
      k = split($3, ps, " "); for (j = 1; j <= k; j++) by[dname(ps[j])] = by[dname(ps[j])] " " ni
      k = split($4, cs, " "); for (j = 1; j <= k; j++) { cn = dname(cs[j]); rev[cn] = rev[cn] "\034" ni "\035" cs[j] }
    }
    END {
      for (t = 1; t <= nt; t++) {
        # the target names something installed
        k = split(tc[t], cs, " ")
        for (j = 1; j <= k; j++) {
          m = split(by[dname(cs[j])], is, " ")
          for (x = 1; x <= m; x++) { i = is[x]; print tn[t] "\t" in_[i] "\t" cs[j] "\t" in_[i] "\t" iv[i] "\t" ip[i] }
        }
        # something installed names the target, or what it provides
        k = split(tn[t] " " tp[t], names, " ")
        for (j = 1; j <= k; j++) {
          m = split(rev[dname(names[j])], rs, "\034")
          for (x = 2; x <= m; x++) {
            split(rs[x], pr, "\035"); i = pr[1]
            print tn[t] "\t" in_[i] "\t" pr[2] "\t" tn[t] "\t" tv[t] "\t" tp[t]
          }
        }
      }
    }' <(printf '%s\n' "$tgt") <(printf '%s\n' "$inst") | sort -u |
    while IFS=$'\t' read -r t i dep pn pv pp; do
      [ -n "$t" ] && satisfies "$dep" "$pn" "$pv" "$pp" && echo "ask $t and $i are in conflict"
    done | sort -u
}

# CHECK_WAIT: how long the update check's copy may take to sync (the window's dialog
# waits 6 s; a run, as long as it takes)
check() {
  local op=${1:-} out f n
  shift
  split_pkgs "$@"
  case $op in
    upgrade)
      # synced first, so a replacement published since the last check is seen
      if checkupdates_db "${CHECK_WAIT:-6}"; then
        out=$(LC_ALL=C pacman -Sup --dbpath "$SYNCDB" --logfile /dev/null --noconfirm --print-format '%n' </dev/null 2>&1)
        questions <<<"$out" | sed 's/^/ask /'
        grep -E '^error:' <<<"$out" | head -3 | sed 's/^error: */fail /'
        # shellcheck disable=SC2046
        conflicts "$SYNCDB" $(grep -E '^[A-Za-z0-9@_+][A-Za-z0-9@._+-]*$' <<<"$out")
      else
        echo "ask the update check's copy of the sync database could not be synced ($CU_ERR), so what pacman would ask is unknown"
      fi
      [ $# -gt 0 ] && echo "aur $*" ;;
    update | install | reinstall | rebuild)
      if [ ${#REPO[@]} -gt 0 ]; then
        out=$(LC_ALL=C pacman -Sp --noconfirm --print-format '%n' -- "${REPO[@]}" </dev/null 2>&1)
        questions <<<"$out" | sed 's/^/ask /'
        grep -E '^error:' <<<"$out" | head -3 | sed 's/^error: */fail /'
        conflicts "" "${REPO[@]}"
      fi
      [ ${#AUR[@]} -gt 0 ] && echo "aur ${AUR[*]}" ;;
    remove | purge)
      # -Rsp, not -Rnsp: pacman refuses --nosave with --print (n only drops the saved settings)
      f=-Rp; [ "$op" = purge ] && f=-Rsp
      out=$(LC_ALL=C pacman $f --noconfirm --print-format '%n' -- "$@" </dev/null 2>&1)
      grep -E '^(error:|:: removing)' <<<"$out" | head -4 | sed -e 's/^error: */fail /' -e 's/^:: /fail /'
      if ! grep -qE '^error:' <<<"$out"; then
        grep -E '^[A-Za-z0-9@_+][A-Za-z0-9@._+-]*$' <<<"$out" | while IFS= read -r n; do
          printf '%s\n' "$@" | grep -qFx -- "$n" || echo "also $n"
        done
      fi ;;
    clean)
      paccache -d 2>/dev/null | grep -E 'finished dry run|no candidate' | sed 's/^==> */note /' ;;
    *) echo "fail unknown change: $op" ;;
  esac
  return 0
}

title() {
  local op=$1 n s=s
  shift
  n=$#; [ "$n" = 1 ] && s=
  case $op in
    upgrade) echo "Updating everything" ;;
    update) echo "Updating $n package$s" ;;
    install) echo "Installing $n package$s" ;;
    reinstall) echo "Reinstalling $n package$s" ;;
    rebuild) echo "Rebuilding $n package$s" ;;
    remove) echo "Removing $n package$s" ;;
    purge) echo "Removing $n package$s with their dependencies" ;;
    clean) echo "Cleaning the package cache" ;;
    *) echo "$op" ;;
  esac
}

# the command for OP into CMD: quiet (no questions, root through pkexec) or asking (a
# terminal, root through sudo), the AUR's through yay
command_for() {
  local op=$1 mode=$2 pac aur need=()
  shift 2
  split_pkgs "$@"
  if [ "$mode" = quiet ]; then
    pac=("$PKEXEC" "$STDBUF" -oL -eL "$PACMAN" --noconfirm --color never)
    aur=(yay "${YAY_QUIET[@]}")
  else
    pac=("$SUDO" "$PACMAN")
    aur=(yay --sudo "$SUDO" --pacman "$PACMAN")
  fi
  case $op in
    upgrade) if [ $# -gt 0 ]; then CMD=("${aur[@]}" -Syu); else CMD=("${pac[@]}" -Syu); fi ;;
    update | install | reinstall)
      [ "$op" = update ] && need=(--needed)
      if [ ${#AUR[@]} -gt 0 ]; then CMD=("${aur[@]}" -S "${need[@]}" -- "$@"); else CMD=("${pac[@]}" -S "${need[@]}" -- "$@"); fi ;;
    rebuild) CMD=("${aur[@]}" -S --rebuild -- "$@") ;;
    remove) CMD=("${pac[@]}" -R -- "$@") ;;
    purge) CMD=("${pac[@]}" -Rns -- "$@") ;;
    clean) if [ "$mode" = quiet ]; then CMD=("$PKEXEC" "$STDBUF" -oL -eL "$PACCACHE" -r); else CMD=("$SUDO" "$PACCACHE" -r); fi ;;
    *) return 1 ;;
  esac
}

run() {
  local op=${1:-} asks code out rep why
  shift
  asks=$(CHECK_WAIT=0 check "$op" "$@" | sed -n 's/^ask //p')
  if [ -n "$asks" ]; then
    while IFS= read -r why; do say "pacman would ask: $why"; done <<<"$asks"
    exit 3
  fi
  command_for "$op" quiet "$@" || { say "unknown change: $op"; exit 1; }
  out=$(mktemp) || exit 1
  # each stream comes out as it is, a copy of each kept apart to read at the end (in one
  # file a line of one would land inside a bar the other is still drawing). Line by line
  # as they come: a program's output is buffered when it is not on a terminal (stdbuf here
  # for yay; after pkexec for pacman, whose preload pkexec drops)
  { "$STDBUF" -oL -eL "${CMD[@]}" </dev/null 2>&1 >&3 3>&- | tee "$out.err" >&2; exit "${PIPESTATUS[0]}"; } 3>&1 |
    tee "$out"
  code=${PIPESTATUS[0]}
  # a replacement pacman took without asking (published after the check): said, not hidden
  rep=$(grep -E '^:: Replace .* with ' "$out" | sed -e 's/^:: Replace //' -e 's/ *\[[YyNn]\/[YyNn]\].*$//' -e 's/?$//' | sort -u)
  [ -n "$rep" ] && say "pacman replaced without asking (published after the check): $(paste -sd ';' <<<"$rep" | sed 's/;/; /g')"
  case $code in
    0) ;;
    126) say "The password was cancelled" ;;
    127) say "Not allowed: polkit refused, or pkexec could not run it" ;;
    *)
      if cat "$out" "$out.err" | grep -qE 'are in conflict|unresolvable package conflicts'; then
        # what pacman would have asked, but --noconfirm answered no to
        code=3
        why=$(cat "$out" "$out.err" | questions | grep '?$' | sed 's/^/pacman would ask: /')
      else
        # pacman's (or yay's) last reasons, most on stderr, then the files it names
        why=$(cat "$out" "$out.err" | grep -E '^(error|==> ERROR|-> )' | grep -v '^-> \(Found\|Downloading\|Building\|Creating\)' | tail -3
          grep -m3 'exists in filesystem' "$out")
      fi
      [ -z "$why" ] && why=$(cat "$out" "$out.err" | grep -v '^\s*$' | tail -2)
      while IFS= read -r rep; do [ -n "$rep" ] && say "$rep"; done <<<"$why" ;;
  esac
  rm -f "$out" "$out.err"
  [ "$code" -gt 0 ] && [ "$code" -ne 126 ] && [ "$code" -ne 3 ] && exit 1
  exit "$code"
}

# UPKEEP_TX_STATUS (set by `kitty`): the file where term leaves the exit status of the
# command and its name, since Kitty does not pass them on
term() {
  local op=${1:-} code prog
  shift
  command_for "$op" ask "$@" || { echo "unknown change: $op"; exit 1; }
  # named by what sudo runs, not sudo
  prog=$(basename "${CMD[0]}"); [ "$prog" = sudo ] && prog=$(basename "${CMD[1]}")
  printf '\e[1m%s\e[0m\n\n' "$(title "$op" "$@"): ${CMD[*]}"
  "${CMD[@]}"
  code=$?
  [ -n "${UPKEEP_TX_STATUS:-}" ] && printf '%s %s\n' "$code" "$prog" >"$UPKEEP_TX_STATUS"
  [ "$code" -ne 0 ] && printf '\n%s exited with status %s\n' "$prog" "$code"
  read -r -p "Press Enter to close..." _
  exit "$code"
}

# Kitty exits with its own status, not its command's, so term leaves that in a file
kitty_run() {
  local st code prog
  st=$(mktemp) || exit 1
  UPKEEP_TX_STATUS=$st kitty --class upkeep-term --title Upkeep -e "$0" term "$@"
  code=$?
  if [ "$code" -ne 0 ]; then
    rm -f "$st"
    say "Kitty failed (exit status $code)"
    exit 1
  fi
  read -r code prog <"$st"
  rm -f "$st"
  case ${code:-} in
    0) exit 0 ;;
    "") say "Kitty was closed before it ended: whether the change took is unknown" ;;
    *) say "$prog exited with status $code in Kitty" ;;
  esac
  exit 1
}

case ${1:-} in
  updates) updates ;;
  check) shift; check "$@" ;;
  run) shift; run "$@" ;;
  kitty) shift; kitty_run "$@" ;;
  term) shift; term "$@" ;;
  *) sed -n '2,/^set -u/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; exit 2 ;;
esac
