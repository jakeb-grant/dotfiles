#!/bin/bash
# Windows VM management script

set -euo pipefail

COMPOSE_DIR="$HOME/.config/windows-vm"
COMPOSE_FILE="$COMPOSE_DIR/docker-compose.yaml"

notify() {
    local urgency="${2:-normal}"
    echo "$1"
    # || true: no notification daemon (headless/SSH) shouldn't kill the script
    notify-send -a "Windows VM" -u "$urgency" "Windows VM" "$1" || true
}

ensure_docker() {
    # Check if user is in docker group
    if ! groups | grep -q '\bdocker\b'; then
        notify "Adding $USER to docker group..."
        pkexec usermod -aG docker "$USER"
        notify "Added to docker group. Log out and back in, then run this again." critical
        exit 1
    fi

    # Check if docker daemon is running
    if ! systemctl is-active --quiet docker; then
        notify "Starting docker daemon..."
        pkexec systemctl start docker
    fi

    # Ensure the host-side shared folder exists before the bind mount. Creating
    # it here (vs. letting Docker auto-create it) keeps it owned by us, and makes
    # the setup reproducible on a fresh machine without tracking its contents.
    mkdir -p "$HOME/WinShared"
}

is_running() {
    # grep without -q consumes all input — -q's early exit could SIGPIPE
    # docker under pipefail and misreport a running VM as stopped
    docker compose -f "$COMPOSE_FILE" ps --status running 2>/dev/null | grep windows >/dev/null
}

connect() {
    notify "Connecting to VM..."
    sdl-freerdp3 /v:localhost /u:Docker /p:admin /clipboard /sound /cert:ignore +dynamic-resolution +geometry /gdi:hw -grab-keyboard -decorations &
}

show_help() {
    cat <<EOF
Windows VM management script

Usage: win-vm [command]

Commands:
  (none)     Start VM and connect via RDP (default)
  start      Start VM in background
  stop       Stop VM gracefully
  restart    Restart VM
  status     Show VM status
  open       Connect to VM via RDP

Access:
  RDP:       localhost:3389 (user: Docker, pass: admin)
  Browser:   http://localhost:8006 (fallback)

Data:       ~/Windows
EOF
}

case "${1:-start-and-open}" in
    start)
        ensure_docker
        docker compose -f "$COMPOSE_FILE" up -d
        notify "VM starting... Access at http://localhost:8006"
        ;;
    stop)
        if ! systemctl is-active --quiet docker; then
            notify "Docker is not running."
            exit 0
        fi
        if ! is_running; then
            notify "VM is not running."
            exit 0
        fi
        docker compose -f "$COMPOSE_FILE" down
        notify "VM stopped."
        ;;
    restart)
        if ! systemctl is-active --quiet docker || ! is_running; then
            notify "VM is not running."
            exit 0
        fi
        docker compose -f "$COMPOSE_FILE" restart
        notify "VM restarted."
        ;;
    status)
        if ! systemctl is-active --quiet docker; then
            echo "Docker is not running."
            exit 0
        fi
        if is_running; then
            echo "Windows VM is running."
            echo "  Browser: http://localhost:8006"
            echo "  RDP:     localhost:3389"
        else
            echo "Windows VM is not running."
        fi
        ;;
    open)
        if ! systemctl is-active --quiet docker || ! is_running; then
            notify "VM is not running. Start it with 'win-vm start'."
            exit 1
        fi
        connect
        ;;
    start-and-open)
        ensure_docker
        if is_running; then
            connect
        else
            docker compose -f "$COMPOSE_FILE" up -d
            notify "Starting VM... Waiting for RDP to become available"
            for i in $(seq 1 60); do
                if timeout 1 bash -c 'echo > /dev/tcp/localhost/3389' 2>/dev/null; then
                    sleep 2  # Brief settle after port opens
                    connect
                    exit 0
                fi
                sleep 2
            done
            notify "VM timed out. Try 'win-vm open' or check http://localhost:8006" critical
        fi
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
