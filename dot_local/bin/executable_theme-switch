#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "jinja2",
# ]
# ///
"""
Theme Switching System

Reads palette JSON files and applies them across all apps.
Palette JSONs are the single source of truth for all theme colors.

Usage: theme-switch [THEME]
"""

import asyncio
import json
import shutil
import sys
from pathlib import Path

from jinja2 import BaseLoader, Environment

# =============================================================================
# Configuration
# =============================================================================

CHEZMOI_SOURCE_DIR = Path.home() / ".local/share/chezmoi/dot_config"
PALETTE_DIR = CHEZMOI_SOURCE_DIR / "palette"
TEMPLATE_DIR = CHEZMOI_SOURCE_DIR / "theme-templates"
DEFAULT_THEME = "catppuccin-mocha"


# =============================================================================
# Color Helpers
# =============================================================================


def hex_to_rgb(color: str) -> tuple[int, int, int]:
    h = color.lstrip("#")
    return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))


def strip_hash(color: str) -> str:
    return color.lstrip("#")


def opacity_to_hex(opacity: float) -> str:
    return f"{int(opacity * 255):02x}"


# =============================================================================
# Jinja2 Filters
# =============================================================================


def filter_hex(color: str) -> str:
    h = strip_hash(color)
    return f"#{h[:6]}"


def filter_hex_alpha(color: str, opacity: float = 1.0) -> str:
    h = strip_hash(color)
    return f"#{h[:6]}{opacity_to_hex(opacity)}"


def filter_rgb(color: str) -> str:
    r, g, b = hex_to_rgb(color)
    return f"rgb({r}, {g}, {b})"


def filter_rgba(color: str, opacity: float = 1.0) -> str:
    r, g, b = hex_to_rgb(color)
    return f"rgba({r}, {g}, {b}, {opacity:.2f})"


def filter_rgb_values(color: str) -> str:
    r, g, b = hex_to_rgb(color)
    return f"{r}, {g}, {b}"


def filter_hypr_rgb(color: str) -> str:
    h = strip_hash(color)
    return f"rgb({h[:6]})"


def filter_hypr_rgba(color: str, opacity: float = 1.0) -> str:
    h = strip_hash(color)
    return f"rgba({h[:6]}{opacity_to_hex(opacity)})"


def filter_strip(color: str) -> str:
    return strip_hash(color)


# =============================================================================
# Template Processing
# =============================================================================


def create_jinja_env() -> Environment:
    env = Environment(
        loader=BaseLoader(),
        variable_start_string="{<",
        variable_end_string=">}",
        block_start_string="{%<",
        block_end_string=">%}",
        comment_start_string="{#<",
        comment_end_string=">#}",
        keep_trailing_newline=True,
    )

    env.filters["hex"] = filter_hex
    env.filters["hex_alpha"] = filter_hex_alpha
    env.filters["rgb"] = filter_rgb
    env.filters["rgba"] = filter_rgba
    env.filters["rgb_values"] = filter_rgb_values
    env.filters["hypr_rgb"] = filter_hypr_rgb
    env.filters["hypr_rgba"] = filter_hypr_rgba
    env.filters["strip"] = filter_strip

    return env


def load_palette(theme_name: str) -> dict:
    palette_file = PALETTE_DIR / f"{theme_name}.json"

    if not palette_file.exists():
        print(f"Error: Palette not found: {theme_name}")
        print("Available palettes:")
        for f in sorted(PALETTE_DIR.glob("*.json")):
            if f.name != "active.json":
                print(f"  {f.stem}")
        sys.exit(1)

    with open(palette_file) as f:
        return json.load(f)


def process_templates(env: Environment, palette_data: dict) -> None:
    for template_file in TEMPLATE_DIR.rglob("*.theme"):
        relative = template_file.relative_to(TEMPLATE_DIR)
        output_name = relative.with_suffix(".tmpl")
        output_path = CHEZMOI_SOURCE_DIR / output_name

        print(f"    {relative} -> {output_name}")

        output_path.parent.mkdir(parents=True, exist_ok=True)

        template_content = template_file.read_text()
        template = env.from_string(template_content)
        result = template.render(**palette_data)

        output_path.write_text(result)


# =============================================================================
# Direct Config Writers
# =============================================================================

GHOSTTY_CONFIG = Path.home() / ".config/ghostty/config"


def update_ghostty(palette_data: dict) -> None:
    theme_name = palette_data.get("_ghostty_theme", "")
    if not theme_name:
        print("    Warning: No _ghostty_theme in palette, skipping Ghostty")
        return

    if not GHOSTTY_CONFIG.exists():
        print("    Warning: Ghostty config not found, skipping")
        return

    opacity = palette_data.get("_blur_opacity", 0.9)

    lines = GHOSTTY_CONFIG.read_text().splitlines()
    new_lines = []
    found_theme = False
    found_opacity = False
    for line in lines:
        if line.startswith("theme =") or line.startswith("theme="):
            new_lines.append(f"theme = {theme_name}")
            found_theme = True
        elif line.startswith("background-opacity =") or line.startswith("background-opacity="):
            new_lines.append(f"background-opacity = {opacity}")
            found_opacity = True
        else:
            new_lines.append(line)

    if not found_theme:
        new_lines.insert(0, f"theme = {theme_name}")
    if not found_opacity:
        new_lines.insert(1, f"background-opacity = {opacity}")

    GHOSTTY_CONFIG.write_text("\n".join(new_lines) + "\n")
    print(f"    Ghostty theme: {theme_name}, opacity: {opacity}")


ZED_SETTINGS = Path.home() / ".config/zed/settings.json"


def update_zed(palette_data: dict) -> None:
    theme_dark = palette_data.get("_zed_theme_dark", "")
    theme_light = palette_data.get("_zed_theme_light", "")
    if not theme_dark and not theme_light:
        print("    Warning: No _zed_theme in palette, skipping Zed")
        return

    if not ZED_SETTINGS.exists():
        print("    Warning: Zed settings not found, skipping")
        return

    with open(ZED_SETTINGS) as f:
        settings = json.load(f)

    if "theme" not in settings:
        settings["theme"] = {}

    if theme_dark:
        settings["theme"]["dark"] = theme_dark
    if theme_light:
        settings["theme"]["light"] = theme_light

    variant = palette_data.get("_variant", "dark")
    settings["theme"]["mode"] = variant

    with open(ZED_SETTINGS, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")

    active = theme_dark if variant == "dark" else theme_light
    print(f"    Zed theme: {active} ({variant})")


BTOP_CONFIG = Path.home() / ".config/btop/btop.conf"


def update_btop(palette_data: dict) -> None:
    theme_name = palette_data.get("_btop_theme", "")
    if not theme_name:
        print("    Warning: No _btop_theme in palette, skipping btop")
        return

    if not BTOP_CONFIG.exists():
        print("    Warning: btop config not found, skipping")
        return

    lines = BTOP_CONFIG.read_text().splitlines()
    new_lines = []
    found = False
    for line in lines:
        if line.startswith("color_theme =") or line.startswith("color_theme="):
            new_lines.append(f'color_theme = "{theme_name}"')
            found = True
        else:
            new_lines.append(line)

    if not found:
        new_lines.insert(0, f'color_theme = "{theme_name}"')

    BTOP_CONFIG.write_text("\n".join(new_lines) + "\n")
    print(f"    btop theme: {theme_name}")


PANE_FM_CONFIG = Path.home() / ".config/pane-fm/config.toml"


def update_pane_fm(palette_data: dict) -> None:
    theme_name = palette_data.get("_pane_fm_theme", "")
    if not theme_name:
        print("    Warning: No _pane_fm_theme in palette, skipping pane-fm")
        return

    if not PANE_FM_CONFIG.exists():
        print("    Warning: pane-fm config not found, skipping")
        return

    variant = palette_data.get("_variant", "dark")
    light_icons = "true" if variant == "light" else "false"

    lines = PANE_FM_CONFIG.read_text().splitlines()
    new_lines = []
    found_theme = False
    found_icons = False
    for line in lines:
        stripped = line.lstrip("# ")
        if stripped.startswith("theme =") or stripped.startswith("theme="):
            new_lines.append(f'theme = "{theme_name}"')
            found_theme = True
        elif stripped.startswith("light_icons =") or stripped.startswith("light_icons="):
            new_lines.append(f"light_icons = {light_icons}")
            found_icons = True
        else:
            new_lines.append(line)

    if not found_theme:
        new_lines.insert(0, f'theme = "{theme_name}"')
    if not found_icons:
        new_lines.insert(1, f"light_icons = {light_icons}")

    PANE_FM_CONFIG.write_text("\n".join(new_lines) + "\n")
    print(f"    pane-fm theme: {theme_name}, light_icons: {light_icons}")


# =============================================================================
# Application Reloading
# =============================================================================


async def run_async(cmd: list[str]) -> bool:
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL,
        )
        await proc.wait()
        return proc.returncode == 0
    except (OSError, FileNotFoundError):
        return False


async def reload_hyprland() -> None:
    await run_async(["hyprctl", "reload"])
    print("    Hyprland reloaded")


async def reload_ghostty() -> None:
    await run_async(["pkill", "-USR2", "ghostty"])
    print("    Ghostty reloaded")


async def reload_btop() -> None:
    await run_async(["pkill", "-x", "btop"])
    print("    btop killed (will use new theme on next launch)")


async def set_gtk_theme(palette_data: dict) -> None:
    scheme = palette_data.get("_gtk_color_scheme")
    if not scheme:
        return

    await run_async([
        "gsettings", "set", "org.gnome.desktop.interface",
        "color-scheme", scheme
    ])
    print(f"    GTK color scheme: {scheme}")


async def send_notification(theme_name: str) -> None:
    await run_async([
        "notify-send",
        f"Theme: {theme_name.replace('-', ' ').title()}",
        "Some apps may need a restart to apply changes.",
    ])


async def reload_all(palette_data: dict) -> None:
    print("==> Reloading applications...")
    await asyncio.gather(
        reload_hyprland(),
        reload_ghostty(),
        reload_btop(),
        set_gtk_theme(palette_data),
    )


# =============================================================================
# Main
# =============================================================================


async def main() -> None:
    theme_name = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_THEME

    # 1. Load palette
    print(f"==> Loading palette: {theme_name}")
    palette_data = load_palette(theme_name)

    # 2. Copy palette → active.json (both chezmoi source and live config)
    #    Preserve barMode from current active.json so toggling survives theme switches
    print("==> Updating active palette...")
    live_palette = Path.home() / ".config/palette/active.json"
    active_bar_mode = None
    if live_palette.exists():
        try:
            with open(live_palette) as f:
                active_data = json.load(f)
            active_bar_mode = active_data.get("_quickshell", {}).get("barMode")
        except (json.JSONDecodeError, OSError):
            pass

    src = PALETTE_DIR / f"{theme_name}.json"
    with open(src) as f:
        new_palette = json.load(f)
    if active_bar_mode:
        new_palette.setdefault("_quickshell", {})["barMode"] = active_bar_mode
    live_palette.parent.mkdir(parents=True, exist_ok=True)
    for active_path in [PALETTE_DIR / "active.json", live_palette]:
        with open(active_path, "w") as f:
            json.dump(new_palette, f, indent=2)

    # 3. Process Jinja2 .theme templates → .tmpl files
    print("==> Processing theme templates...")
    env = create_jinja_env()
    process_templates(env, palette_data)

    # 4. Apply chezmoi (only theme-dependent configs, not large static files)
    print("==> Applying chezmoi (themed configs)...")
    themed_targets = [
        "~/.config/hypr",
        "~/.config/gtk-3.0",
        "~/.config/gtk-4.0",
        "~/.config/yazi",
        "~/.config/phylax",
        "~/.config/zed/settings.json",
        "~/.config/pane-fm",
        "~/.config/palette/active.json",
    ]
    proc = await asyncio.create_subprocess_exec(
        "chezmoi", "apply", "--force", *themed_targets
    )
    await proc.wait()

    # 5. Write app configs directly (after chezmoi so they aren't overwritten)
    print("==> Updating app configs...")
    update_ghostty(palette_data)
    update_btop(palette_data)
    update_zed(palette_data)
    update_pane_fm(palette_data)

    # 6. Reload apps in parallel
    await reload_all(palette_data)
    await send_notification(theme_name)

    print(f"==> Theme switched to: {theme_name}")


if __name__ == "__main__":
    asyncio.run(main())
