#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
Theme Switching System

Reads palette JSON files and applies them across all apps.
Palette JSONs are the single source of truth for all theme colors.

Usage: theme-switch [THEME]       (no THEME: the one in use, again)
       theme-switch --list [--json]
"""

import asyncio
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


def notify(message: str, urgency: str = "normal") -> None:
    print(message, flush=True)
    subprocess.Popen(
        ["notify-send", "-a", "Theme Switch", "-u", urgency, "Theme Switch", message],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

# =============================================================================
# Configuration
# =============================================================================

def _chezmoi_root() -> Path:
    try:
        result = subprocess.run(
            ["chezmoi", "source-path"], capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            return Path(result.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path.home() / ".local/share/chezmoi"


CHEZMOI_ROOT = _chezmoi_root()
CHEZMOI_SOURCE_DIR = CHEZMOI_ROOT / "dot_config"
PALETTE_DIR = CHEZMOI_SOURCE_DIR / "palette"
DEFAULT_THEME = "catppuccin-mocha"


# =============================================================================
# Color Helpers
# =============================================================================


def hex_to_rgb(color: str) -> tuple[int, int, int]:
    h = color.lstrip("#")
    return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))


def strip_hash(color: str) -> str:
    return color.lstrip("#")


def hex_to_hsl(color: str) -> tuple[int, int, int]:
    r, g, b = (c / 255.0 for c in hex_to_rgb(color))
    max_c, min_c = max(r, g, b), min(r, g, b)
    l = (max_c + min_c) / 2.0

    if max_c == min_c:
        return (0, 0, round(l * 100))

    d = max_c - min_c
    s = d / (2.0 - max_c - min_c) if l > 0.5 else d / (max_c + min_c)

    if max_c == r:
        h = (g - b) / d + (6 if g < b else 0)
    elif max_c == g:
        h = (b - r) / d + 2
    else:
        h = (r - g) / d + 4

    return (round(h * 60), round(s * 100), round(l * 100))


def contrast(a: str, b: str) -> float:
    def lum(color: str) -> float:
        c = [x / 255 for x in hex_to_rgb(color)]
        c = [x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4 for x in c]
        return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    hi, lo = sorted((lum(a), lum(b)), reverse=True)
    return (hi + 0.05) / (lo + 0.05)


# =============================================================================
# Palettes
# =============================================================================


def load_palette(theme_name: str) -> dict:
    palette_file = PALETTE_DIR / f"{theme_name}.json"

    if not palette_file.exists():
        available = ", ".join(f.stem for f in sorted(PALETTE_DIR.glob("*.json")) if f.name != "active.json")
        notify(f"Palette not found: {theme_name}. Available: {available}", "critical")
        sys.exit(1)

    with open(palette_file) as f:
        return json.load(f)


def accent_of(p: dict) -> str:
    """The palette's accent: its `_accent`, else `blue`. The one place it is
    derived; everything else reads `_accent` from active.json or `--list`."""
    return p.get("_accent") or p.get("blue", "")


# What the Strand launcher's Themes page reads of each palette (`--list --json`)
LIST_ROLES = [
    "base", "crust", "mantle", "surface0", "surface1", "surface2", "overlay0",
    "subtext0", "text", "lavender", "mauve", "red", "peach", "yellow", "green",
    "teal", "blue", "pink",
]


def list_themes(as_json: bool = False) -> None:
    """One `slug  name` line per palette, or with `as_json` `{"all": [...]}` with
    each palette's roles, accent and variant (the Strand launcher's Themes page).
    Swatch order: base, accent, red, green, yellow, mauve."""
    themes = []
    for palette_file in sorted(PALETTE_DIR.glob("*.json")):
        if palette_file.name == "active.json":
            continue
        try:
            p = json.loads(palette_file.read_text())
            name = p.get("_name", "")
            if not name:
                continue
            swatches = [
                p.get("base", ""), accent_of(p), p.get("red", ""),
                p.get("green", ""), p.get("yellow", ""), p.get("mauve", ""),
            ]
        except Exception:
            # A malformed palette should drop itself from the list, not the
            # files sorted after it.
            continue
        if not as_json:
            print(f"{palette_file.stem:24}{name}")
            continue
        theme = {role: p[role] for role in LIST_ROLES if role in p}
        theme.update(
            slug=palette_file.stem, name=name, colors=swatches,
            accent=accent_of(p), dark=p.get("_variant") != "light",
        )
        themes.append(theme)
    if as_json:
        print(json.dumps({"all": themes}, separators=(",", ":")))


# The 26 color roles every palette must define (Catppuccin naming).
REQUIRED_ROLES = [
    "crust", "mantle", "base", "surface0", "surface1", "surface2",
    "overlay0", "overlay1", "overlay2", "subtext0", "subtext1", "text",
    "rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach",
    "yellow", "green", "teal", "sky", "sapphire", "blue", "lavender",
]

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")


def installed_zed_themes() -> set[str]:
    names = set()
    for theme_file in (CHEZMOI_SOURCE_DIR / "zed" / "themes").glob("*.json"):
        try:
            data = json.loads(theme_file.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        names.update(t.get("name", "") for t in data.get("themes", []))
    return names


def validate_palette(theme_name: str, palette_data: dict) -> None:
    errors = []

    for role in REQUIRED_ROLES:
        value = palette_data.get(role)
        if value is None:
            errors.append(f"missing role: {role}")
        elif not isinstance(value, str) or not HEX_RE.match(value):
            errors.append(f"bad hex for {role}: {value!r}")

    # The accent is parsed by hex_to_hsl before the active.json writes —
    # validate it here so a typo gets the notify+exit path, not a traceback.
    accent = palette_data.get("_accent", "")
    if accent and (not isinstance(accent, str) or not HEX_RE.match(accent)):
        errors.append(f"bad hex for _accent: {accent!r}")

    if palette_data.get("_variant") not in ("dark", "light"):
        errors.append(f"_variant must be dark or light, not {palette_data.get('_variant')!r}")

    zed_theme = palette_data.get("_zed_theme", "")
    if zed_theme not in installed_zed_themes():
        errors.append(f"_zed_theme {zed_theme!r} not found in zed/themes/*.json")

    if not (CHEZMOI_SOURCE_DIR / "kitty" / "themes" / f"{theme_name}.conf").is_file():
        errors.append(f"no kitty/themes/{theme_name}.conf")

    if errors:
        notify(f"Palette {theme_name} failed validation:\n" + "\n".join(errors), "critical")
        sys.exit(1)


# =============================================================================
# Direct Config Writers
# =============================================================================

# Files whose consumers hot-reload via an inotify watch on the file's inode.
# chezmoi applies files by atomic rename, which replaces the inode and kills
# the watch — hot reload works for the first switch of a session (the dying
# watch's last event) and never again. Syncing each target in place *before*
# apply keeps chezmoi's rename away from these files entirely: apply sees no
# diff, the inode never changes, and the in-place write is a plain IN_MODIFY
# the watcher survives.
INODE_WATCHED_TARGETS = [
    "~/.config/zed/settings.json",           # Zed settings hot-reload
]


def keep_unsynced_edits(target: str) -> None:
    """Zed writes settings.json itself (a setting changed in its UI, a migration).
    Before the switch re-renders it, a live file that changed since chezmoi last
    wrote it (`chezmoi status`'s first column) holds such an edit: keep a copy as
    settings.json.bak and say so, so it can be carried into the template rather
    than lost. A template edit alone doesn't count, as it would against a fresh render."""
    path = Path(target.replace("~", str(Path.home()), 1))
    try:
        result = subprocess.run(
            ["chezmoi", "status", target], capture_output=True, text=True, timeout=15
        )
    except (OSError, subprocess.TimeoutExpired):
        return
    if result.returncode != 0 or not path.exists() or not result.stdout.startswith("M"):
        return
    backup = path.with_name(path.name + ".bak")
    shutil.copyfile(path, backup)
    notify(f"{path.name} had changes of its own, kept in {backup}: move them into the template", "normal")


def sync_rendered_in_place(target: str) -> None:
    try:
        result = subprocess.run(
            ["chezmoi", "cat", target], capture_output=True, text=True, timeout=15
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is None or result.returncode != 0:
        print(f"    Warning: chezmoi cat {target} failed, leaving it to apply")
        return
    path = Path(target.replace("~", str(Path.home()), 1))
    if path.exists() and path.read_text() == result.stdout:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as f:
        f.write(result.stdout)
    print(f"    {path.name} synced in place (hot reload)")


CHROME_POLICY_DIRS = [
    Path("/etc/chromium/policies/managed"),
    Path("/etc/opt/chrome/policies/managed"),
]


def update_chromium(palette_data: dict) -> None:
    seed_color = palette_data["base"]

    variant = palette_data.get("_variant", "dark")
    color_scheme = 1 if variant == "light" else 2
    scheme_label = "light" if variant == "light" else "dark"

    policy = {
        "BrowserThemeColor": seed_color,
        "ThemeColorScheme": color_scheme,
    }
    policy_text = json.dumps(policy, indent=2) + "\n"

    found_dir = False
    for policy_dir in CHROME_POLICY_DIRS:
        if not policy_dir.exists():
            continue
        found_dir = True
        try:
            (policy_dir / "theme.json").write_text(policy_text)
            print(f"    {policy_dir.parent.parent.name}: seed {seed_color}, scheme: {scheme_label}")
        except PermissionError:
            print(
                f"    Warning: No write permission to {policy_dir}, skipping"
                " — re-run setup-chromium-policies (bash \"$(chezmoi source-path)/run_once_setup-chromium-policies.sh\") to restore ACLs"
            )

    if not found_dir:
        print("    Warning: No Chromium/Chrome policy dirs found, skipping")


# =============================================================================
# Application Reloading
# =============================================================================


async def run_async(cmd: list[str]) -> bool:
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL,
        )
        await proc.wait()
        return proc.returncode == 0
    except (OSError, FileNotFoundError):
        return False


async def reload_hyprland() -> None:
    await run_async(["hyprctl", "reload"])
    print("    Hyprland reloaded")


async def reload_kitty() -> None:
    if await run_async(["pkill", "-USR1", "-x", "kitty"]):
        print("    Kitty reloaded")


async def reload_btop() -> None:
    # SIGUSR2: btop reloads its config and theme (it no longer saves its config
    # on exit, save_config_on_exit = false, so nothing races the apply)
    if await run_async(["pkill", "-USR2", "-x", "btop"]):
        print("    btop reloaded")


async def set_gtk_theme(palette_data: dict) -> None:
    # GTK3 ignores color-scheme; adw-gtk3 is its light/dark base, recoloured
    # by gtk-3.0/gtk.css's @define-color block
    gtk3_theme = "adw-gtk3" if palette_data.get("_variant") == "light" else "adw-gtk3-dark"
    await run_async([
        "gsettings", "set", "org.gnome.desktop.interface",
        "gtk-theme", gtk3_theme
    ])
    print(f"    GTK3 theme: {gtk3_theme}")

    scheme = f"prefer-{palette_data['_variant']}"
    await run_async([
        "gsettings", "set", "org.gnome.desktop.interface",
        "color-scheme", scheme
    ])
    print(f"    GTK color scheme: {scheme}")


async def reload_chromium() -> None:
    for browser, process in [("chromium", "chromium"), ("google-chrome-stable", "chrome")]:
        if shutil.which(browser) and await run_async(["pgrep", "-x", process]):
            await run_async([browser, "--refresh-platform-policy"])
            print(f"    {browser} policy refreshed")


async def reload_portal() -> None:
    proc = await asyncio.create_subprocess_exec(
        "systemctl", "--user", "restart", "xdg-desktop-portal-gtk",
    )
    await proc.wait()
    print("    xdg-desktop-portal-gtk restarted")


async def set_gtk_then_portal(palette_data: dict) -> None:
    # The portal restart only after the gsettings writes: one landing while the
    # portal restarts is never seen as a change by the new instance
    await set_gtk_theme(palette_data)
    await reload_portal()


async def reload_all(palette_data: dict) -> None:
    print("==> Reloading applications...")
    await asyncio.gather(
        reload_hyprland(),
        reload_kitty(),
        reload_btop(),
        set_gtk_then_portal(palette_data),
        reload_chromium(),
    )


# =============================================================================
# Main
# =============================================================================


def write_json_atomic(path: Path, data: dict) -> None:
    # Strand watches active.json — write via temp + rename so it never
    # observes a partial file.
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    tmp.replace(path)


async def main() -> None:
    # One switch at a time: a second waits, then runs whole, so the last one
    # asked for wins everywhere (chezmoi's state lock would fail it otherwise)
    lock = open(Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "theme-switch.lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)

    live_palette = Path.home() / ".config/palette/active.json"
    theme_name = sys.argv[1] if len(sys.argv) > 1 else None
    if theme_name in ("-h", "--help"):
        print(__doc__.strip().split("\n\n")[-1])
        print("Themes:", ", ".join(f.stem for f in sorted(PALETTE_DIR.glob("*.json")) if f.name != "active.json"))
        return
    if theme_name is None:
        try:
            theme_name = json.loads(live_palette.read_text()).get("_slug") or DEFAULT_THEME
        except (json.JSONDecodeError, OSError):
            theme_name = DEFAULT_THEME

    # 1. Load and validate palette
    print(f"Switching to {theme_name}...")
    palette_data = load_palette(theme_name)
    validate_palette(theme_name, palette_data)
    # before active.json changes, so the render compared is the one in use
    for target in INODE_WATCHED_TARGETS:
        keep_unsynced_edits(target)

    # 2. Copy palette → active.json (both chezmoi source and live config)
    print("==> Updating active palette...")

    # Derived keys, before the active.json writes — chezmoi templates read them
    # straight from active.json: the theme's slug, the accent with its HSL
    # (obsidian), and what reads best on the accent (crust, base or text)
    palette_data["_slug"] = theme_name
    accent = accent_of(palette_data)
    palette_data["_accent"] = accent
    palette_data["_accent_h"], palette_data["_accent_s"], palette_data["_accent_l"] = hex_to_hsl(accent)
    palette_data["_on_accent"] = max(
        (palette_data[r] for r in ("crust", "base", "text")), key=lambda c: contrast(c, accent)
    )

    live_palette.parent.mkdir(parents=True, exist_ok=True)
    for active_path in [PALETTE_DIR / "active.json", live_palette]:
        write_json_atomic(active_path, palette_data)

    # 3. Write Chromium's policy, and sync inode-watched targets in place so
    #    their hot-reload watches survive
    print("==> Updating app configs...")
    update_chromium(palette_data)
    for target in INODE_WATCHED_TARGETS:
        sync_rendered_in_place(target)

    # 4. Apply chezmoi (only theme-dependent configs, not large static files)
    print("==> Applying chezmoi (themed configs)...")
    themed_targets = [
        "~/.config/hypr",
        "~/.config/gtk-3.0",
        "~/.config/gtk-4.0",
        "~/.config/yazi",
        "~/.config/zed/settings.json",
        "~/.config/kitty",
        "~/.config/btop",
        "~/.config/qt5ct/colors",
        "~/knowledge/.obsidian",
    ]
    proc = await asyncio.create_subprocess_exec(
        "chezmoi", "apply", "--force", *themed_targets
    )
    await proc.wait()
    if proc.returncode != 0:
        notify(
            f"chezmoi apply failed (exit {proc.returncode}) — app configs are stale. "
            "Fix and re-run theme-switch.",
            "critical",
        )
        sys.exit(1)

    # 5. Reload apps in parallel
    await reload_all(palette_data)

    notify(f"Switched to {palette_data.get('_name') or theme_name}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        list_themes(as_json="--json" in sys.argv[2:])
    else:
        asyncio.run(main())
