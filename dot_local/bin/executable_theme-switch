#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
Theme Switching System

Reads palette JSON files and applies them across all apps.
Palette JSONs are the single source of truth for all theme colors.

Usage: theme-switch [THEME]
"""

import asyncio
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


def notify(message: str, urgency: str = "normal") -> None:
    print(message, flush=True)
    subprocess.Popen(
        ["notify-send", "-a", "Theme Switch", "-u", urgency, "Theme Switch", message],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

# =============================================================================
# Configuration
# =============================================================================

def _chezmoi_root() -> Path:
    try:
        result = subprocess.run(
            ["chezmoi", "source-path"], capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            return Path(result.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path.home() / ".local/share/chezmoi"


CHEZMOI_ROOT = _chezmoi_root()
CHEZMOI_SOURCE_DIR = CHEZMOI_ROOT / "dot_config"
PALETTE_DIR = CHEZMOI_SOURCE_DIR / "palette"
DEFAULT_THEME = "catppuccin-mocha"


# =============================================================================
# Color Helpers
# =============================================================================


def hex_to_rgb(color: str) -> tuple[int, int, int]:
    h = color.lstrip("#")
    return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))


def strip_hash(color: str) -> str:
    return color.lstrip("#")


def hex_to_hsl(color: str) -> tuple[int, int, int]:
    r, g, b = (c / 255.0 for c in hex_to_rgb(color))
    max_c, min_c = max(r, g, b), min(r, g, b)
    l = (max_c + min_c) / 2.0

    if max_c == min_c:
        return (0, 0, round(l * 100))

    d = max_c - min_c
    s = d / (2.0 - max_c - min_c) if l > 0.5 else d / (max_c + min_c)

    if max_c == r:
        h = (g - b) / d + (6 if g < b else 0)
    elif max_c == g:
        h = (b - r) / d + 2
    else:
        h = (r - g) / d + 4

    return (round(h * 60), round(s * 100), round(l * 100))


# =============================================================================
# Palettes
# =============================================================================


def load_palette(theme_name: str) -> dict:
    palette_file = PALETTE_DIR / f"{theme_name}.json"

    if not palette_file.exists():
        available = ", ".join(f.stem for f in sorted(PALETTE_DIR.glob("*.json")) if f.name != "active.json")
        notify(f"Palette not found: {theme_name}. Available: {available}", "critical")
        sys.exit(1)

    with open(palette_file) as f:
        return json.load(f)


def list_themes() -> None:
    """Print one `file|name|swatch...` line per palette (Quickshell launcher
    themes menu). Swatch order: base, accent, red, green, yellow, mauve."""
    for palette_file in sorted(PALETTE_DIR.glob("*.json")):
        if palette_file.name == "active.json":
            continue
        try:
            p = json.loads(palette_file.read_text())
            name = p.get("_name", "")
            if not name:
                continue
            accent = p.get("_quickshell", {}).get("accent", p.get("blue", ""))
            swatches = "|".join([
                p.get("base", ""), accent, p.get("red", ""),
                p.get("green", ""), p.get("yellow", ""), p.get("mauve", ""),
            ])
        except Exception:
            # A malformed palette should drop itself from the menu, not the
            # files sorted after it.
            continue
        print(f"{palette_file.name}|{name}|{swatches}")


# The 26 color roles every palette must define (Catppuccin naming).
REQUIRED_ROLES = [
    "crust", "mantle", "base", "surface0", "surface1", "surface2",
    "overlay0", "overlay1", "overlay2", "subtext0", "subtext1", "text",
    "rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach",
    "yellow", "green", "teal", "sky", "sapphire", "blue", "lavender",
]

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")


def installed_zed_themes() -> set[str]:
    names = set()
    for theme_file in (CHEZMOI_SOURCE_DIR / "zed" / "themes").glob("*.json"):
        try:
            data = json.loads(theme_file.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        names.update(t.get("name", "") for t in data.get("themes", []))
    return names


def validate_palette(theme_name: str, palette_data: dict) -> None:
    errors = []

    for role in REQUIRED_ROLES:
        value = palette_data.get(role)
        if value is None:
            errors.append(f"missing role: {role}")
        elif not isinstance(value, str) or not HEX_RE.match(value):
            errors.append(f"bad hex for {role}: {value!r}")

    # The accent is parsed by hex_to_hsl before the active.json writes —
    # validate it here so a typo gets the notify+exit path, not a traceback.
    accent = (palette_data.get("_quickshell") or {}).get("accent", "")
    if accent and (not isinstance(accent, str) or not HEX_RE.match(accent)):
        errors.append(f"bad hex for _quickshell.accent: {accent!r}")

    zed_names = installed_zed_themes()
    variant = palette_data.get("_variant", "dark")
    for key in ("_zed_theme_dark", "_zed_theme_light"):
        value = palette_data.get(key, "")
        if value and value not in zed_names:
            errors.append(f"{key} {value!r} not found in zed/themes/*.json")
    if not palette_data.get(f"_zed_theme_{variant}", ""):
        errors.append(f"_zed_theme_{variant} is empty but _variant is {variant!r}")

    if errors:
        notify(f"Palette {theme_name} failed validation:\n" + "\n".join(errors), "critical")
        sys.exit(1)


# =============================================================================
# Direct Config Writers
# =============================================================================

HYPR_PALETTE_LUA = CHEZMOI_SOURCE_DIR / "hypr" / "palette.lua"


def update_palette_lua(palette_data: dict) -> None:
    # Hex roles only — keys starting with `_` are meta (e.g. _name, _variant).
    roles = {k: strip_hash(v) for k, v in palette_data.items()
             if not k.startswith("_") and isinstance(v, str) and v.startswith("#")}
    lines = [
        "-- Auto-generated by theme-switch. Do not edit.",
        "-- Source of truth: ~/.config/palette/active.json",
        "",
        "local hex = {",
    ]
    for name in sorted(roles):
        lines.append(f'  {name} = "{roles[name]}",')
    lines += [
        "}",
        "",
        "local function alpha(o)",
        "  return string.format(\"%02x\", math.floor((o or 1.0) * 255))",
        "end",
        "",
        "local p = {}",
        "for name, h in pairs(hex) do",
        "  p[name] = h",
        '  p[name .. "_rgb"]  = function()  return "rgb("  .. h .. ")" end',
        '  p[name .. "_rgba"] = function(o) return "rgba(" .. h .. alpha(o) .. ")" end',
        "end",
        "return p",
        "",
    ]
    HYPR_PALETTE_LUA.parent.mkdir(parents=True, exist_ok=True)
    HYPR_PALETTE_LUA.write_text("\n".join(lines))
    print(f"    palette.lua: {len(roles)} roles")


# These write into the chezmoi *source*; `chezmoi apply` propagates to ~/.config,
# so a plain `chezmoi apply` never reverts the theme.
GHOSTTY_CONFIG = CHEZMOI_SOURCE_DIR / "ghostty" / "config"


def rewrite_config_keys(path: Path, replacements: dict[str, str]) -> bool:
    """Replace `key = value` lines in a config file, inserting missing keys at the top.

    replacements maps key -> full replacement line.
    """
    if not path.exists():
        print(f"    Warning: {path} not found, skipping")
        return False

    new_lines = []
    found = set()
    for line in path.read_text().splitlines():
        for key, replacement in replacements.items():
            if line.startswith(f"{key} =") or line.startswith(f"{key}="):
                new_lines.append(replacement)
                found.add(key)
                break
        else:
            new_lines.append(line)

    # Fallback only — the source configs commit these keys, and top-of-file
    # insertion is wrong for keys that belong inside a TOML section.
    missing = [line for key, line in replacements.items() if key not in found]
    for i, replacement in enumerate(missing):
        print(f"    Warning: {path.name} was missing a managed key, inserted at top: {replacement}")
        new_lines.insert(i, replacement)

    path.write_text("\n".join(new_lines) + "\n")
    return True


def update_ghostty(palette_data: dict) -> None:
    theme_name = palette_data.get("_ghostty_theme", "")
    if not theme_name:
        print("    Warning: No _ghostty_theme in palette, skipping Ghostty")
        return

    opacity = palette_data.get("_blur_opacity", 0.9)
    if rewrite_config_keys(GHOSTTY_CONFIG, {
        "theme": f"theme = {theme_name}",
        "background-opacity": f"background-opacity = {opacity}",
    }):
        print(f"    Ghostty theme: {theme_name}, opacity: {opacity}")


# Files whose consumers hot-reload via an inotify watch on the file's inode.
# chezmoi applies files by atomic rename, which replaces the inode and kills
# the watch — hot reload works for the first switch of a session (the dying
# watch's last event) and never again. Syncing each target in place *before*
# apply keeps chezmoi's rename away from these files entirely: apply sees no
# diff, the inode never changes, and the in-place write is a plain IN_MODIFY
# the watcher survives.
INODE_WATCHED_TARGETS = [
    "~/.config/zed/settings.json",           # Zed settings hot-reload
    "~/.config/pane-fm/themes/palette.css",  # pane-fm theme watcher
]


def sync_rendered_in_place(target: str) -> None:
    try:
        result = subprocess.run(
            ["chezmoi", "cat", target], capture_output=True, text=True, timeout=15
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is None or result.returncode != 0:
        print(f"    Warning: chezmoi cat {target} failed, leaving it to apply")
        return
    path = Path(target.replace("~", str(Path.home()), 1))
    if path.exists() and path.read_text() == result.stdout:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as f:
        f.write(result.stdout)
    print(f"    {path.name} synced in place (hot reload)")


CHROME_POLICY_DIRS = [
    Path("/etc/chromium/policies/managed"),
    Path("/etc/opt/chrome/policies/managed"),
]


def update_chromium(palette_data: dict) -> None:
    seed_color = palette_data.get("_chromium_seed_color", "")
    if not seed_color:
        print("    Warning: No _chromium_seed_color in palette, skipping Chromium/Chrome")
        return

    variant = palette_data.get("_variant", "dark")
    color_scheme = 1 if variant == "light" else 2
    scheme_label = "light" if variant == "light" else "dark"

    policy = {
        "BrowserThemeColor": seed_color,
        "ThemeColorScheme": color_scheme,
    }
    policy_text = json.dumps(policy, indent=2) + "\n"

    found_dir = False
    for policy_dir in CHROME_POLICY_DIRS:
        if not policy_dir.exists():
            continue
        found_dir = True
        try:
            (policy_dir / "theme.json").write_text(policy_text)
            print(f"    {policy_dir.parent.parent.name}: seed {seed_color}, scheme: {scheme_label}")
        except PermissionError:
            print(
                f"    Warning: No write permission to {policy_dir}, skipping"
                " — re-run setup-chromium-policies (bash \"$(chezmoi source-path)/run_once_setup-chromium-policies.sh\") to restore ACLs"
            )

    if not found_dir:
        print("    Warning: No Chromium/Chrome policy dirs found, skipping")


# =============================================================================
# Application Reloading
# =============================================================================


async def run_async(cmd: list[str]) -> bool:
    try:
        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL,
        )
        await proc.wait()
        return proc.returncode == 0
    except (OSError, FileNotFoundError):
        return False


async def reload_hyprland() -> None:
    await run_async(["hyprctl", "reload"])
    print("    Hyprland reloaded")


async def reload_ghostty() -> None:
    await run_async(["pkill", "-USR2", "ghostty"])
    print("    Ghostty reloaded")


async def reload_btop() -> None:
    if not await run_async(["pkill", "-x", "btop"]):
        return  # nothing to kill
    # pkill returns before btop finishes its SIGTERM shutdown, which writes
    # btop.conf — wait until it's actually gone so that save can't land after
    # chezmoi apply and drift btop.conf from the source.
    for _ in range(20):
        if not await run_async(["pgrep", "-x", "btop"]):
            break
        await asyncio.sleep(0.1)
    print("    btop killed (will use new theme on next launch)")


async def set_gtk_theme(palette_data: dict) -> None:
    scheme = palette_data.get("_gtk_color_scheme")
    if not scheme:
        return

    await run_async([
        "gsettings", "set", "org.gnome.desktop.interface",
        "color-scheme", scheme
    ])
    print(f"    GTK color scheme: {scheme}")


async def reload_chromium() -> None:
    for browser, process in [("chromium", "chromium"), ("google-chrome-stable", "chrome")]:
        if shutil.which(browser) and await run_async(["pgrep", "-x", process]):
            await run_async([browser, "--refresh-platform-policy"])
            print(f"    {browser} policy refreshed")


async def reload_portal() -> None:
    proc = await asyncio.create_subprocess_exec(
        "systemctl", "--user", "restart", "xdg-desktop-portal-gtk",
    )
    await proc.wait()
    print("    xdg-desktop-portal-gtk restarted")


async def reload_all(palette_data: dict) -> None:
    print("==> Reloading applications...")
    await asyncio.gather(
        reload_hyprland(),
        reload_ghostty(),
        set_gtk_theme(palette_data),
        reload_chromium(),
        reload_portal(),
    )


# =============================================================================
# Main
# =============================================================================


def write_json_atomic(path: Path, data: dict) -> None:
    # Quickshell watches active.json — write via temp + rename so it never
    # observes a partial file.
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    tmp.replace(path)


async def main() -> None:
    theme_name = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_THEME

    # 1. Load and validate palette
    notify(f"Switching to {theme_name}...")
    palette_data = load_palette(theme_name)
    validate_palette(theme_name, palette_data)

    # 2. Copy palette → active.json (both chezmoi source and live config)
    #    Preserve barMode from current active.json so toggling survives theme switches
    print("==> Updating active palette...")
    live_palette = Path.home() / ".config/palette/active.json"
    active_bar_mode = None
    if live_palette.exists():
        try:
            with open(live_palette) as f:
                active_data = json.load(f)
            active_bar_mode = active_data.get("_quickshell", {}).get("barMode")
        except (json.JSONDecodeError, OSError):
            pass

    if active_bar_mode:
        palette_data.setdefault("_quickshell", {})["barMode"] = active_bar_mode

    # Derive accent + its HSL before the active.json writes — chezmoi templates
    # (gtk, obsidian) read these straight from active.json.
    accent = palette_data.get("_quickshell", {}).get("accent") or palette_data.get("blue", "")
    if accent:
        palette_data["_accent"] = accent
        h, s, l = hex_to_hsl(accent)
        palette_data["_accent_h"] = h
        palette_data["_accent_s"] = s
        palette_data["_accent_l"] = l

    live_palette.parent.mkdir(parents=True, exist_ok=True)
    for active_path in [PALETTE_DIR / "active.json", live_palette]:
        write_json_atomic(active_path, palette_data)

    # 3. Regenerate the Hyprland palette module
    update_palette_lua(palette_data)

    # 4. Update direct-write app configs in the chezmoi source, and sync
    #    inode-watched targets in place so their hot-reload watches survive
    print("==> Updating app configs...")
    update_ghostty(palette_data)
    update_chromium(palette_data)
    for target in INODE_WATCHED_TARGETS:
        sync_rendered_in_place(target)

    # 5. Apply chezmoi (only theme-dependent configs, not large static files).
    #    btop saves its config on clean shutdown — kill it first so its
    #    exit-save can't overwrite the freshly applied theme.
    await reload_btop()
    print("==> Applying chezmoi (themed configs)...")
    themed_targets = [
        "~/.config/hypr",
        "~/.config/gtk-3.0",
        "~/.config/gtk-4.0",
        "~/.config/yazi",
        "~/.config/phylax",
        "~/.config/zed/settings.json",
        "~/.config/ghostty",
        "~/.config/btop",
        "~/.config/pane-fm",
        "~/knowledge/.obsidian",
    ]
    proc = await asyncio.create_subprocess_exec(
        "chezmoi", "apply", "--force", *themed_targets
    )
    await proc.wait()
    if proc.returncode != 0:
        notify(
            f"chezmoi apply failed (exit {proc.returncode}) — app configs are stale. "
            "Fix and re-run theme-switch.",
            "critical",
        )
        sys.exit(1)

    # 6. Reload apps in parallel
    await reload_all(palette_data)

    notify(f"Switched to {theme_name.replace('-', ' ').title()}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        list_themes()
    else:
        asyncio.run(main())
