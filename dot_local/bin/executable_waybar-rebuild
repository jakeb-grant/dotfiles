#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""
Waybar module for detecting packages that need rebuilding.
Click-to-check model: left-click refreshes, right-click runs fix.
"""

import json
import subprocess
import sys
from pathlib import Path

CACHE_FILE = Path.home() / ".cache" / "waybar-rebuild" / "status.json"

# Apps to check for rebuild issues
# Format: (name, command, error_patterns, rebuild_command)
CHECKS = [
    (
        "elephant",
        ["timeout", "3", "elephant"],
        ["plugin was built with a different version"],
        "yay -S --rebuild $(pacman -Qqm | grep elephant)",
    ),
]


def load_cache() -> dict | None:
    """Load cached status if it exists."""
    try:
        if CACHE_FILE.exists():
            with open(CACHE_FILE) as f:
                return json.load(f)
    except (json.JSONDecodeError, OSError):
        pass
    return None


def save_cache(data: dict) -> None:
    """Save status to cache."""
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CACHE_FILE, "w") as f:
        json.dump(data, f)


def signal_waybar() -> None:
    """Send signal to waybar to refresh the module."""
    try:
        subprocess.run(["pkill", "-RTMIN+9", "waybar"], check=False)
    except (subprocess.SubprocessError, FileNotFoundError):
        pass


def check_app(name: str, command: list[str], error_patterns: list[str]) -> bool:
    """Check if an app has rebuild-related errors. Returns True if issues found."""
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            start_new_session=True,
        )

        for pattern in error_patterns:
            if pattern in result.stderr:
                return True

        return False
    except (subprocess.SubprocessError, FileNotFoundError):
        return False


def run_checks() -> list[tuple[str, str]]:
    """Run all checks and return list of (name, rebuild_command) for issues."""
    issues = []

    for name, command, patterns, rebuild_cmd in CHECKS:
        if check_app(name, command, patterns):
            issues.append((name, rebuild_cmd))

    return issues


def build_output(issues: list[tuple[str, str]]) -> dict:
    """Build waybar JSON output from issues list."""
    actions = "Left-click: Refresh\nRight-click: Fix"

    if issues:
        tooltip_lines = ["Packages need rebuild:", ""]
        tooltip_lines.extend(f"  • {name}" for name, _ in issues)
        tooltip_lines.append("")
        tooltip_lines.append(actions)

        return {
            "text": f"󱁤 {len(issues)}",
            "tooltip": "\n".join(tooltip_lines),
            "class": "needs-rebuild",
            "alt": "needs-rebuild"
        }
    else:
        return {
            "text": "󱁤",
            "tooltip": f"No rebuild issues detected\n\n{actions}",
            "class": "ok",
            "alt": "ok"
        }


def do_check():
    """Run checks and update cache."""
    issues = run_checks()
    output = build_output(issues)
    save_cache(output)
    return output


def do_fix():
    """Run rebuild commands for all detected issues."""
    # Show fixing state
    fixing = {
        "text": "󱁤",
        "tooltip": "Rebuild in progress...",
        "class": "fixing",
        "alt": "fixing"
    }
    save_cache(fixing)
    signal_waybar()

    issues = run_checks()

    if not issues:
        print("No rebuild issues detected.")
        # Update cache with clean state
        do_check()
        signal_waybar()
        return

    print(f"Found {len(issues)} issue(s) to fix:\n")

    failed = []
    for name, rebuild_cmd in issues:
        print(f"==> Rebuilding {name}...")
        print(f"    Running: {rebuild_cmd}\n")
        result = subprocess.run(rebuild_cmd, shell=True)
        if result.returncode != 0:
            failed.append(name)
        print()

    # Recheck and update cache
    do_check()
    signal_waybar()

    if failed:
        print(f"\nWarning: Failed to rebuild: {', '.join(failed)}")
        print("Check the output above for errors.")
    else:
        print("\nDone. All issues fixed.")


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == "fix":
            do_fix()
            return
        elif sys.argv[1] == "check":
            # Show checking state immediately
            checking = {
                "text": "󰑓",
                "tooltip": "Checking for rebuild issues...",
                "class": "checking",
                "alt": "checking"
            }
            save_cache(checking)
            signal_waybar()

            # Run actual check
            do_check()
            signal_waybar()
            return

    # Default: show cached state or idle
    cached = load_cache()
    if cached:
        output = cached
    else:
        output = {
            "text": "󱁤",
            "tooltip": "Left-click: Check for rebuild issues\nRight-click: Fix",
            "class": "idle",
            "alt": "idle"
        }

    print(json.dumps(output))


if __name__ == "__main__":
    main()
