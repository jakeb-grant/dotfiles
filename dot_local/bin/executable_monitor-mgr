"""
Monitor Profile Manager TUI

Interactive terminal UI for managing Hyprland monitor profiles.
Includes visual monitor arrangement editor.
"""

import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

from textual import on
from textual.app import App, ComposeResult
from textual.containers import Container, Horizontal, VerticalScroll
from textual.screen import Screen
from textual.widgets import Button, DataTable, Input, Label, Static

# ==============================================================================
# Configuration
# ==============================================================================

PROFILE_DIR = Path.home() / ".config" / "monitor-profiles"
METADATA_FILE = PROFILE_DIR / ".metadata.json"


# ==============================================================================
# Helper Functions
# ==============================================================================


def load_metadata() -> dict[str, Any]:
    """Load metadata file."""
    if not METADATA_FILE.exists():
        return {"active_profile": None, "last_modified": None}

    try:
        with open(METADATA_FILE) as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return {"active_profile": None, "last_modified": None}


def save_metadata(metadata: dict[str, Any]) -> bool:
    """Save metadata file. Returns True on success."""
    try:
        METADATA_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(METADATA_FILE, "w") as f:
            json.dump(metadata, f, indent=2)
        return True
    except IOError:
        return False


def list_profiles() -> list[str]:
    """List all available profiles."""
    if not PROFILE_DIR.exists():
        return []

    profiles = []
    for file in PROFILE_DIR.glob("*.json"):
        if file.name != ".metadata.json":
            profiles.append(file.stem)

    return sorted(profiles)


def load_profile(profile_name: str) -> dict[str, Any] | None:
    """Load a profile from disk."""
    profile_file = PROFILE_DIR / f"{profile_name}.json"

    if not profile_file.exists():
        return None

    try:
        with open(profile_file) as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return None


def save_profile(profile: dict[str, Any]) -> bool:
    """Save a profile to disk."""
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)

    profile_file = PROFILE_DIR / f"{profile['name']}.json"

    try:
        with open(profile_file, "w") as f:
            json.dump(profile, f, indent=2)
        return True
    except IOError:
        return False


def delete_profile(profile_name: str) -> bool:
    """Delete a profile from disk."""
    profile_file = PROFILE_DIR / f"{profile_name}.json"

    try:
        profile_file.unlink()
        return True
    except (FileNotFoundError, IOError):
        return False


def detect_docks() -> list[dict[str, Any]]:
    """Detect connected Thunderbolt docks using boltctl."""
    try:
        result = subprocess.run(
            ["boltctl", "list"], capture_output=True, text=True, timeout=5
        )
        if result.returncode != 0:
            return []

        docks = []
        current_dock: dict[str, Any] = {}

        for line in result.stdout.splitlines():
            stripped = line.strip()
            # New device entry - handle both unicode bullet and asterisk
            if line.lstrip().startswith(("●", "*")) and not line.lstrip().startswith("|-"):
                # Save previous device if exists
                if current_dock.get("uuid"):
                    docks.append(current_dock)
                # Extract name after the marker
                name_part = re.split(r"[●*]", line, maxsplit=1)[1].strip() if re.search(r"[●*]", line) else ""
                current_dock = {"name": name_part}
            # Parse field lines (format: "|- field:  value" or "field: value")
            elif ":" in stripped:
                # Remove tree drawing characters
                clean = re.sub(r"^[|`\-\s]+", "", stripped)
                if ":" in clean:
                    key, _, value = clean.partition(":")
                    key = key.strip().lower()
                    value = value.strip()
                    if key == "name":
                        current_dock["name"] = value
                    elif key == "uuid":
                        current_dock["uuid"] = value
                    elif key == "vendor":
                        current_dock["vendor"] = value
                    elif key == "type":
                        current_dock["type"] = value
                    elif key == "status":
                        current_dock["status"] = value

        # Don't forget the last one
        if current_dock.get("uuid"):
            docks.append(current_dock)

        # Filter to only peripherals (actual docks, not host controllers)
        return [d for d in docks if d.get("type") == "peripheral"]

    except (subprocess.TimeoutExpired, FileNotFoundError):
        return []


def get_dock_for_profile(profile_name: str) -> str | None:
    """Get the dock UUID linked to a profile, if any."""
    metadata = load_metadata()
    dock_profiles = metadata.get("dock_profiles", {})
    for uuid, name in dock_profiles.items():
        if name == profile_name:
            return uuid
    return None


def link_profile_to_dock(profile_name: str, dock_uuid: str) -> bool:
    """Link a profile to a dock UUID."""
    metadata = load_metadata()
    if "dock_profiles" not in metadata:
        metadata["dock_profiles"] = {}
    metadata["dock_profiles"][dock_uuid] = profile_name
    return save_metadata(metadata)


def unlink_profile_from_dock(profile_name: str) -> bool:
    """Remove dock linking for a profile."""
    metadata = load_metadata()
    dock_profiles = metadata.get("dock_profiles", {})
    # Find and remove any dock linked to this profile
    to_remove = [uuid for uuid, name in dock_profiles.items() if name == profile_name]
    for uuid in to_remove:
        del dock_profiles[uuid]
    metadata["dock_profiles"] = dock_profiles
    return save_metadata(metadata)


def detect_monitors() -> list[dict[str, Any]]:
    """Detect current monitor setup from hyprctl."""
    try:
        result = subprocess.run(
            ["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5
        )

        if result.returncode != 0:
            return []

        monitors = json.loads(result.stdout)

        return [
            {
                "name": m["name"],
                "enabled": True,
                "resolution": f"{m['width']}x{m['height']}",
                "refresh_rate": round(m["refreshRate"], 2),
                "position": {"x": m["x"], "y": m["y"]},
                "scale": m["scale"],
                "transform": m.get("transform", 0),
                "mode": f"{m['width']}x{m['height']}@{round(m['refreshRate'])}",
            }
            for m in monitors
        ]
    except (
        subprocess.TimeoutExpired,
        json.JSONDecodeError,
        FileNotFoundError,
        KeyError,
    ):
        return []


def apply_profile(profile_name: str) -> bool:
    """Apply a profile using monitor-apply."""
    try:
        result = subprocess.run(
            ["monitor-apply", profile_name], capture_output=True, timeout=10
        )
        return result.returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


# ==============================================================================
# Monitor Arrangement Screen
# ==============================================================================


class MonitorOrderCanvas(Static):
    """Canvas for reordering monitors and assigning workspaces."""

    def __init__(
        self,
        monitors: list[dict[str, Any]],
        workspaces: list[dict[str, Any]],
        selected_index: int = 0,
    ) -> None:
        super().__init__()
        self.monitors = monitors
        self.workspaces = workspaces
        self.selected_index = selected_index

    def render(self) -> str:
        """Render the monitor order display."""
        if not self.monitors:
            return "No monitors configured"

        lines = []
        lines.append("Monitor Order (Left to Right)")
        lines.append("=" * 80)
        lines.append("")

        for i, monitor in enumerate(self.monitors):
            selected = ">>> " if i == self.selected_index else "    "
            name = monitor["name"]
            res = monitor["resolution"]
            enabled = monitor.get("enabled", True)
            status = "" if enabled else " [DISABLED]"

            # Find all workspaces assigned to this monitor
            if enabled:
                ws_ids = sorted([ws["id"] for ws in self.workspaces if ws["monitor"] == name])
                ws_str = ", ".join(str(w) for w in ws_ids) if ws_ids else "—"
            else:
                ws_str = "—"

            lines.append(
                f"{selected}[{i + 1}] {name:10} | {res:12} | Workspaces: {ws_str}{status}"
            )

        lines.append("")
        lines.append("Visual Layout:")
        monitor_strs = []
        for m in self.monitors:
            if m.get("enabled", True):
                monitor_strs.append(f"[{m['name']}]")
            else:
                monitor_strs.append(f"[{m['name']} OFF]")
        layout = "  " + "  ".join(monitor_strs)
        lines.append(layout)
        lines.append("")
        lines.append("Controls:")
        lines.append("  ↑↓      : Select monitor")
        lines.append("  ←→      : Move monitor left/right in order")
        lines.append("  d       : Toggle disable (keeps in config but turns off)")
        lines.append("  x/Del   : Remove monitor from profile entirely")
        lines.append("  1-9, 0  : Toggle workspace on selected monitor (0 = WS 10)")

        return "\n".join(lines)


class MonitorArrangement(Screen):
    """Screen for arranging monitor order and workspace assignments."""

    BINDINGS = [
        ("up", "select_prev", "Previous"),
        ("down", "select_next", "Next"),
        ("left", "move_left", "Move Left"),
        ("right", "move_right", "Move Right"),
        ("d", "toggle_disable", "Disable"),
        ("x", "remove_monitor", "Remove"),
        ("delete", "remove_monitor", "Remove"),
        ("1", "assign_workspace('1')", "WS 1"),
        ("2", "assign_workspace('2')", "WS 2"),
        ("3", "assign_workspace('3')", "WS 3"),
        ("4", "assign_workspace('4')", "WS 4"),
        ("5", "assign_workspace('5')", "WS 5"),
        ("6", "assign_workspace('6')", "WS 6"),
        ("7", "assign_workspace('7')", "WS 7"),
        ("8", "assign_workspace('8')", "WS 8"),
        ("9", "assign_workspace('9')", "WS 9"),
        ("0", "assign_workspace('10')", "WS 10"),
        ("escape", "cancel", "Cancel"),
        ("enter", "save", "Save"),
    ]

    def __init__(
        self, monitors: list[dict[str, Any]], workspaces: list[dict[str, Any]]
    ) -> None:
        super().__init__()
        self.monitors = monitors.copy()
        self.workspaces = workspaces.copy() if workspaces else []
        self.selected_index = 0

    def compose(self) -> ComposeResult:
        """Compose the arrangement UI."""
        yield Label("Monitor Profile Manager - Arrange Monitors")
        yield MonitorOrderCanvas(self.monitors, self.workspaces, self.selected_index)

        with Horizontal():
            yield Button("Save (Enter)", id="save_btn", variant="success")
            yield Button("Cancel (Esc)", id="cancel_btn")

    def action_select_prev(self) -> None:
        """Select previous monitor."""
        if self.monitors:
            self.selected_index = (self.selected_index - 1) % len(self.monitors)
            self.refresh_canvas()

    def action_select_next(self) -> None:
        """Select next monitor."""
        if self.monitors:
            self.selected_index = (self.selected_index + 1) % len(self.monitors)
            self.refresh_canvas()

    def action_move_left(self) -> None:
        """Move selected monitor left in order."""
        if not self.monitors or self.selected_index <= 0:
            return

        # Swap with previous monitor
        self.monitors[self.selected_index], self.monitors[self.selected_index - 1] = (
            self.monitors[self.selected_index - 1],
            self.monitors[self.selected_index],
        )

        self.selected_index -= 1
        self._recalculate_positions()
        self.refresh_canvas()

    def action_toggle_disable(self) -> None:
        """Toggle the selected monitor between enabled and disabled."""
        if not self.monitors:
            return

        monitor = self.monitors[self.selected_index]
        current = monitor.get("enabled", True)
        monitor["enabled"] = not current

        if monitor["enabled"]:
            self.notify(f"Enabled {monitor['name']}", severity="information")
        else:
            # Remove workspaces from disabled monitor
            self.workspaces = [ws for ws in self.workspaces if ws["monitor"] != monitor["name"]]
            self.notify(f"Disabled {monitor['name']}", severity="information")

        self.refresh_canvas()

    def action_remove_monitor(self) -> None:
        """Remove the selected monitor from the profile."""
        if not self.monitors:
            return

        if len(self.monitors) <= 1:
            self.notify("Cannot remove the last monitor", severity="warning")
            return

        monitor_name = self.monitors[self.selected_index]["name"]

        # Remove the monitor
        del self.monitors[self.selected_index]

        # Remove any workspaces assigned to this monitor
        self.workspaces = [ws for ws in self.workspaces if ws["monitor"] != monitor_name]

        # Adjust selected index if needed
        if self.selected_index >= len(self.monitors):
            self.selected_index = len(self.monitors) - 1

        self._recalculate_positions()
        self.notify(f"Removed {monitor_name}", severity="information")
        self.refresh_canvas()

    def action_move_right(self) -> None:
        """Move selected monitor right in order."""
        if not self.monitors or self.selected_index >= len(self.monitors) - 1:
            return

        # Swap with next monitor
        self.monitors[self.selected_index], self.monitors[self.selected_index + 1] = (
            self.monitors[self.selected_index + 1],
            self.monitors[self.selected_index],
        )

        self.selected_index += 1
        self._recalculate_positions()
        self.refresh_canvas()

    def _recalculate_positions(self) -> None:
        """Recalculate monitor positions based on order."""
        x_offset = 0
        for monitor in self.monitors:
            if monitor.get("enabled", True):
                monitor["position"]["x"] = x_offset
                monitor["position"]["y"] = 0
                width = int(monitor["resolution"].split("x")[0])
                x_offset += width

    def _assign_workspace(self, ws_num: int) -> None:
        """Toggle workspace assignment for selected monitor."""
        if not self.monitors or not (0 <= self.selected_index < len(self.monitors)):
            return

        monitor_name = self.monitors[self.selected_index]["name"]

        # Check if this workspace is already assigned to this monitor
        existing = next(
            (ws for ws in self.workspaces if ws["id"] == ws_num and ws["monitor"] == monitor_name),
            None
        )

        if existing:
            # Toggle off - remove from this monitor
            self.workspaces = [ws for ws in self.workspaces if not (ws["id"] == ws_num and ws["monitor"] == monitor_name)]
            self.notify(
                f"Removed workspace {ws_num} from {monitor_name}", severity="information"
            )
        else:
            # Remove from any other monitor first
            self.workspaces = [ws for ws in self.workspaces if ws["id"] != ws_num]
            # Assign to this monitor
            self.workspaces.append({"id": ws_num, "monitor": monitor_name, "default": False})
            self.notify(
                f"Assigned workspace {ws_num} to {monitor_name}", severity="information"
            )

        # Sort workspaces by id for cleaner display
        self.workspaces.sort(key=lambda ws: ws["id"])

        self.refresh_canvas()

    def action_assign_workspace(self, ws_num: str) -> None:
        """Assign workspace by number key."""
        self._assign_workspace(int(ws_num))

    def refresh_canvas(self) -> None:
        """Refresh the canvas display."""
        canvas = self.query_one(MonitorOrderCanvas)
        canvas.monitors = self.monitors
        canvas.workspaces = self.workspaces
        canvas.selected_index = self.selected_index
        canvas.refresh()

    def action_save(self) -> None:
        """Save the arrangement and return."""
        # Set the lowest workspace on each monitor as the default
        monitor_mins: dict[str, int] = {}
        for ws in self.workspaces:
            mon = ws["monitor"]
            if mon not in monitor_mins or ws["id"] < monitor_mins[mon]:
                monitor_mins[mon] = ws["id"]

        for ws in self.workspaces:
            ws["default"] = ws["id"] == monitor_mins.get(ws["monitor"])

        self.dismiss((self.monitors, self.workspaces))

    def action_cancel(self) -> None:
        """Cancel and return without saving."""
        self.dismiss(None)

    @on(Button.Pressed, "#save_btn")
    def on_save_button(self) -> None:
        self.action_save()

    @on(Button.Pressed, "#cancel_btn")
    def on_cancel_button(self) -> None:
        self.action_cancel()


# ==============================================================================
# Profile Editor Screen
# ==============================================================================


class ProfileEditor(Screen):
    """Screen for editing a monitor profile."""

    BINDINGS = [
        ("d", "detect", "Detect"),
        ("a", "arrange", "Arrange"),
        ("l", "link_dock", "Link Dock"),
        ("s", "save", "Save"),
        ("escape", "cancel", "Cancel"),
        ("tab", "focus_next_input", "Next field"),
        ("shift+tab", "focus_prev_input", "Previous field"),
    ]

    def action_focus_next_input(self) -> None:
        """Focus next input field only."""
        self.focus_next("Input")

    def action_focus_prev_input(self) -> None:
        """Focus previous input field only."""
        self.focus_previous("Input")

    def __init__(self, profile: dict[str, Any] | None = None) -> None:
        super().__init__()
        self.profile = profile or self._create_empty_profile()
        self.original_name = profile["name"] if profile else None

    def _create_empty_profile(self) -> dict[str, Any]:
        """Create an empty profile template."""
        return {
            "name": "new-profile",
            "description": "",
            "monitors": [],
            "workspaces": [],
            "lid_switch": {
                "enabled": False,
                "monitor": "eDP-1",
                "on_close": "disable",
                "on_open": "preferred,0x0,1",
            },
        }

    def _get_dock_status_text(self) -> str:
        """Get dock link status text for display."""
        profile_name = self.profile.get("name", "")
        linked_dock = get_dock_for_profile(profile_name) if self.original_name else None
        connected_docks = detect_docks()

        lines = []

        if linked_dock:
            # Find dock info if it's connected
            dock_info = next((d for d in connected_docks if d["uuid"] == linked_dock), None)
            if dock_info:
                lines.append(f"  Linked: {dock_info.get('name', 'Unknown')} (connected)")
            else:
                lines.append(f"  Linked: {linked_dock[:16]}... (not connected)")
        else:
            lines.append("  Not linked to any dock")

        if connected_docks:
            lines.append(f"  Connected docks: {len(connected_docks)}")
            for dock in connected_docks:
                name = dock.get("name", "Unknown")
                lines.append(f"    - {name}")
        else:
            lines.append("  No docks connected")

        return "\n".join(lines)

    def _refresh_dock_display(self) -> None:
        """Refresh the dock status display."""
        dock_display = self.query_one("#dock_display", Static)
        dock_display.update(self._get_dock_status_text())

    def compose(self) -> ComposeResult:
        """Compose the editor UI."""
        yield Label("Monitor Profile Manager - Edit Profile")

        with VerticalScroll():
            yield Label("Profile Name:")
            yield Input(
                value=self.profile["name"], placeholder="profile-name", id="name_input"
            )

            yield Label("Description:")
            yield Input(
                value=self.profile.get("description", ""),
                placeholder="Brief description",
                id="desc_input",
            )

            yield Label(f"\nMonitors ({len(self.profile.get('monitors', []))}):", id="monitors_label")
            monitors_text = (
                "\n".join(
                    [
                        f"  {m['name']}: {m['resolution']} at ({m['position']['x']}, {m['position']['y']})"
                        for m in self.profile.get("monitors", [])
                    ]
                )
                or "  No monitors configured"
            )
            yield Static(monitors_text, id="monitors_display")

            yield Label("\nWorkspaces:")
            workspaces_text = (
                "\n".join(
                    [
                        f"  Workspace {ws['id']} → {ws['monitor']}{' (default)' if ws.get('default') else ''}"
                        for ws in self.profile.get("workspaces", [])
                    ]
                )
                or "  No workspaces configured"
            )
            yield Static(workspaces_text, id="workspaces_display")

            # Dock linking section
            yield Label("\nDock Link:")
            yield Static(self._get_dock_status_text(), id="dock_display")

            with Horizontal():
                yield Button("Detect (d)", id="detect_btn", variant="primary")
                yield Button("Arrange (a)", id="arrange_btn", variant="primary")
                yield Button("Link Dock (l)", id="link_btn", variant="primary")
                yield Button("Save (s)", id="save_btn", variant="success")
                yield Button("Cancel (Esc)", id="cancel_btn")

    def _arrange_monitors_left_to_right(self, monitors: list[dict[str, Any]]) -> None:
        """Arrange monitors left-to-right with no overlap."""
        x_offset = 0
        for monitor in monitors:
            if monitor.get("enabled", True):
                monitor["position"]["x"] = x_offset
                monitor["position"]["y"] = 0
                # Get width from resolution
                res = monitor.get("resolution", "1920x1080")
                width = int(res.split("x")[0])
                x_offset += width

    @on(Button.Pressed, "#detect_btn")
    def action_detect(self) -> None:
        """Auto-detect current monitor setup."""
        monitors = detect_monitors()

        if not monitors:
            self.notify("Could not detect monitors", severity="error")
            return

        # Sort monitors: external first, laptop last
        monitors.sort(key=lambda m: (1 if "eDP" in m["name"] else 0, m["name"]))

        # Arrange left-to-right with no overlap
        self._arrange_monitors_left_to_right(monitors)

        # Update profile with detected monitors
        self.profile["monitors"] = monitors

        # Auto-assign workspaces
        self.profile["workspaces"] = [
            {"id": i + 1, "monitor": m["name"], "default": True}
            for i, m in enumerate(monitors[:10])
        ]

        # Enable lid switch for laptop monitor
        for monitor in monitors:
            if "eDP" in monitor["name"]:
                pos = monitor["position"]
                mode = monitor.get("mode", "preferred")
                self.profile["lid_switch"] = {
                    "enabled": True,
                    "monitor": monitor["name"],
                    "on_close": "disable",
                    "on_open": f"{mode},{pos['x']}x{pos['y']},1",
                }
                break

        self.notify(f"Detected {len(monitors)} monitors", severity="information")
        self._refresh_display()

    @on(Button.Pressed, "#arrange_btn")
    def action_arrange(self) -> None:
        """Open the monitor arrangement screen."""
        if not self.profile.get("monitors"):
            self.notify("Detect monitors first", severity="warning")
            return

        def on_arrangement_saved(
            result: tuple[list[dict[str, Any]], list[dict[str, Any]]] | None,
        ) -> None:
            """Callback when arrangement screen is closed."""
            if result:
                monitors, workspaces = result
                self.profile["monitors"] = monitors
                self.profile["workspaces"] = workspaces
                self.notify(
                    "Monitor arrangement and workspaces updated", severity="information"
                )
                self._refresh_display()

        self.app.push_screen(
            MonitorArrangement(
                self.profile["monitors"], self.profile.get("workspaces", [])
            ),
            on_arrangement_saved,
        )

    @on(Button.Pressed, "#link_btn")
    def action_link_dock(self) -> None:
        """Link or unlink this profile to/from a connected dock."""
        profile_name = self.profile.get("name", "")

        # Check if already linked
        linked_dock = get_dock_for_profile(profile_name) if self.original_name else None

        if linked_dock:
            # Unlink
            if unlink_profile_from_dock(profile_name):
                self.notify(f"Unlinked profile from dock", severity="information")
            else:
                self.notify("Failed to unlink", severity="error")
            self._refresh_dock_display()
            return

        # Try to link to a connected dock
        connected_docks = detect_docks()

        if not connected_docks:
            self.notify("No docks connected", severity="warning")
            return

        if len(connected_docks) == 1:
            # Only one dock, link directly
            dock = connected_docks[0]
            if link_profile_to_dock(profile_name, dock["uuid"]):
                self.notify(f"Linked to {dock.get('name', 'dock')}", severity="information")
            else:
                self.notify("Failed to link", severity="error")
            self._refresh_dock_display()
        else:
            # Multiple docks - just use the first for now
            # TODO: Could add a dock selection screen
            dock = connected_docks[0]
            if link_profile_to_dock(profile_name, dock["uuid"]):
                self.notify(f"Linked to {dock.get('name', 'dock')}", severity="information")
            else:
                self.notify("Failed to link", severity="error")
            self._refresh_dock_display()

    def _refresh_display(self) -> None:
        """Refresh the monitor and workspace displays."""
        # Update monitors label with count
        monitors_label = self.query_one("#monitors_label", Label)
        monitors_label.update(f"\nMonitors ({len(self.profile.get('monitors', []))}):")

        # Update monitors list
        monitors_display = self.query_one("#monitors_display", Static)
        monitors_text = (
            "\n".join(
                [
                    f"  {m['name']}: {m['resolution']} at ({m['position']['x']}, {m['position']['y']})"
                    for m in self.profile.get("monitors", [])
                ]
            )
            or "  No monitors configured"
        )
        monitors_display.update(monitors_text)

        # Update workspaces
        workspaces_display = self.query_one("#workspaces_display", Static)
        workspaces_text = (
            "\n".join(
                [
                    f"  Workspace {ws['id']} → {ws['monitor']}{' (default)' if ws.get('default') else ''}"
                    for ws in self.profile.get("workspaces", [])
                ]
            )
            or "  No workspaces configured"
        )
        workspaces_display.update(workspaces_text)

    @on(Button.Pressed, "#save_btn")
    def action_save(self) -> None:
        """Save the profile."""
        name_input = self.query_one("#name_input", Input)
        desc_input = self.query_one("#desc_input", Input)

        profile_name = name_input.value.strip()
        if not profile_name:
            self.notify("Profile name cannot be empty", severity="error")
            return

        # Validate profile name (filesystem-safe)
        if not re.match(r'^[a-zA-Z0-9_-]+$', profile_name):
            self.notify("Profile name can only contain letters, numbers, dashes, and underscores", severity="error")
            return

        # Handle rename: delete old file if name changed
        if self.original_name and self.original_name != profile_name:
            delete_profile(self.original_name)

        # Update profile
        self.profile["name"] = profile_name
        self.profile["description"] = desc_input.value.strip()

        # Save to disk
        if save_profile(self.profile):
            self.notify(f"Saved profile '{profile_name}'", severity="information")
            self.app.pop_screen()
        else:
            self.notify("Failed to save profile", severity="error")

    @on(Button.Pressed, "#cancel_btn")
    def action_cancel(self) -> None:
        """Cancel editing."""
        self.app.pop_screen()


# ==============================================================================
# Confirmation Screen
# ==============================================================================


class ConfirmDelete(Screen):
    """Confirmation screen for deleting a profile."""

    BINDINGS = [
        ("y", "confirm", "Yes"),
        ("n", "cancel", "No"),
        ("escape", "cancel", "Cancel"),
    ]

    def __init__(self, profile_name: str) -> None:
        super().__init__()
        self.profile_name = profile_name

    def compose(self) -> ComposeResult:
        """Compose the confirmation UI."""
        yield Label(f"Delete profile '{self.profile_name}'?", classes="confirm-title")
        with Horizontal():
            yield Button("Yes (y)", id="yes_btn", variant="error")
            yield Button("No (n)", id="no_btn", variant="primary")

    def action_confirm(self) -> None:
        """Confirm deletion."""
        self.dismiss(True)

    def action_cancel(self) -> None:
        """Cancel deletion."""
        self.dismiss(False)

    @on(Button.Pressed, "#yes_btn")
    def on_yes(self) -> None:
        self.action_confirm()

    @on(Button.Pressed, "#no_btn")
    def on_no(self) -> None:
        self.action_cancel()


# ==============================================================================
# Profile List Screen
# ==============================================================================


class ProfileList(Screen):
    """Main screen showing list of profiles."""

    BINDINGS = [
        ("n", "new_profile", "New"),
        ("e", "edit_profile", "Edit"),
        ("d", "delete_profile", "Delete"),
        ("a", "apply_profile", "Apply"),
        ("r", "refresh", "Refresh"),
        ("q", "quit", "Quit"),
    ]

    def compose(self) -> ComposeResult:
        """Compose the profile list UI."""
        with Container(id="table_container"):
            table = DataTable(id="profile_table", cursor_type="row")
            table.add_column("Name", key="name")
            table.add_column("Description", key="description")
            table.add_column("Monitors", key="monitors")
            table.add_column("Status", key="status")
            yield table

        with Horizontal(id="button_bar"):
            yield Button("New (n)", id="new_btn", variant="primary")
            yield Button("Edit (e)", id="edit_btn", variant="warning")
            yield Button("Delete (d)", id="delete_btn", variant="error")
            yield Button("Apply (a)", id="apply_btn", variant="success")
            yield Button("Refresh (r)", id="refresh_btn")
            yield Button("Quit (q)", id="quit_btn")

    def on_mount(self) -> None:
        """Populate table on mount."""
        container = self.query_one("#table_container", Container)
        container.border_title = "Profiles"
        self.refresh_table()

    def on_screen_resume(self) -> None:
        """Refresh table when returning from another screen."""
        self.refresh_table()

    def refresh_table(self) -> None:
        """Refresh the profile table."""
        table = self.query_one("#profile_table", DataTable)
        table.clear()

        metadata = load_metadata()
        active = metadata.get("active_profile")

        profiles = list_profiles()

        for profile_name in profiles:
            profile = load_profile(profile_name)
            if not profile:
                continue

            description = profile.get("description", "")
            monitor_count = len(profile.get("monitors", []))
            status = "✓ Active" if profile_name == active else ""

            table.add_row(
                profile_name, description, str(monitor_count), status, key=profile_name
            )

    def action_new_profile(self) -> None:
        """Create a new profile."""
        self.app.push_screen(ProfileEditor())

    def action_edit_profile(self) -> None:
        """Edit the selected profile."""
        table = self.query_one("#profile_table", DataTable)
        if table.cursor_row is None or table.row_count == 0:
            self.notify("No profile selected", severity="warning")
            return

        row_key = table.get_row_at(table.cursor_row)
        if row_key is None:
            return

        profile_name = str(row_key[0])
        profile = load_profile(profile_name)

        if profile:
            self.app.push_screen(ProfileEditor(profile))
        else:
            self.notify(f"Could not load profile '{profile_name}'", severity="error")

    def action_delete_profile(self) -> None:
        """Delete the selected profile with confirmation."""
        table = self.query_one("#profile_table", DataTable)
        if table.cursor_row is None or table.row_count == 0:
            self.notify("No profile selected", severity="warning")
            return

        row_key = table.get_row_at(table.cursor_row)
        if row_key is None:
            return

        profile_name = str(row_key[0])

        def on_confirm(confirmed: bool) -> None:
            """Handle confirmation result."""
            if confirmed:
                if delete_profile(profile_name):
                    self.notify(f"Deleted profile '{profile_name}'", severity="information")
                    self.refresh_table()
                else:
                    self.notify(f"Failed to delete profile '{profile_name}'", severity="error")

        self.app.push_screen(ConfirmDelete(profile_name), on_confirm)

    def action_apply_profile(self) -> None:
        """Apply the selected profile."""
        table = self.query_one("#profile_table", DataTable)
        if table.cursor_row is None or table.row_count == 0:
            self.notify("No profile selected", severity="warning")
            return

        row_key = table.get_row_at(table.cursor_row)
        if row_key is None:
            return

        profile_name = str(row_key[0])

        if apply_profile(profile_name):
            self.notify(f"Applied profile '{profile_name}'", severity="information")
            self.refresh_table()
        else:
            self.notify(f"Failed to apply profile '{profile_name}'", severity="error")

    def action_refresh(self) -> None:
        """Refresh the profile list."""
        self.refresh_table()
        self.notify("Refreshed", severity="information")

    def action_quit(self) -> None:
        """Quit the application."""
        self.app.exit()

    @on(Button.Pressed, "#new_btn")
    def on_new_button(self) -> None:
        self.action_new_profile()

    @on(Button.Pressed, "#edit_btn")
    def on_edit_button(self) -> None:
        self.action_edit_profile()

    @on(Button.Pressed, "#delete_btn")
    def on_delete_button(self) -> None:
        self.action_delete_profile()

    @on(Button.Pressed, "#apply_btn")
    def on_apply_button(self) -> None:
        self.action_apply_profile()

    @on(Button.Pressed, "#refresh_btn")
    def on_refresh_button(self) -> None:
        self.action_refresh()

    @on(Button.Pressed, "#quit_btn")
    def on_quit_button(self) -> None:
        self.action_quit()


