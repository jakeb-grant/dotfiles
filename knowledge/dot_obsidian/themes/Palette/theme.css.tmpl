{{- $p := include "dot_config/palette/active.json" | fromJson -}}
/* Obsidian theme - colors from palette/active.json (chezmoi template) */

/* one mapping, crust to text, for either mode: Obsidian follows the system
   colour scheme, which theme-switch sets by _variant */
.theme-dark, .theme-light {
  --color-base-00: {{ $p.crust }};
  --color-base-10: {{ $p.mantle }};
  --color-base-20: {{ $p.base }};
  --color-base-25: {{ $p.surface0 }};
  --color-base-30: {{ $p.surface1 }};
  --color-base-35: {{ $p.surface1 }};
  --color-base-40: {{ $p.surface2 }};
  --color-base-50: {{ $p.overlay0 }};
  --color-base-60: {{ $p.overlay1 }};
  --color-base-70: {{ $p.subtext0 }};
  --color-base-100: {{ $p.text }};

  --accent-h: {{ $p._accent_h }};
  --accent-s: {{ $p._accent_s }}%;
  --accent-l: {{ $p._accent_l }}%;

  --color-red: {{ $p.red }};
  --color-red-rgb: {{ template "rgb_values" $p.red }};
  --color-orange: {{ $p.peach }};
  --color-orange-rgb: {{ template "rgb_values" $p.peach }};
  --color-yellow: {{ $p.yellow }};
  --color-yellow-rgb: {{ template "rgb_values" $p.yellow }};
  --color-green: {{ $p.green }};
  --color-green-rgb: {{ template "rgb_values" $p.green }};
  --color-cyan: {{ $p.teal }};
  --color-cyan-rgb: {{ template "rgb_values" $p.teal }};
  --color-blue: {{ $p.blue }};
  --color-blue-rgb: {{ template "rgb_values" $p.blue }};
  --color-purple: {{ $p.mauve }};
  --color-purple-rgb: {{ template "rgb_values" $p.mauve }};
  --color-pink: {{ $p.pink }};
  --color-pink-rgb: {{ template "rgb_values" $p.pink }};

  --titlebar-background: {{ $p.crust }};
  --titlebar-background-focused: {{ $p.crust }};
}
