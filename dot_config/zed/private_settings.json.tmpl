{{- $p := include "dot_config/palette/active.json" | fromJson -}}
{
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font Propo",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono"
  },
  "theme": {
    "mode": "{{ $p._variant }}",
    "dark": "{{ $p._zed_theme }}",
    "light": "{{ $p._zed_theme }}"
  },
  "theme_overrides": {
    "{{ $p._zed_theme }}": {
      "text.accent": "{{ $p._accent }}",
      "icon.accent": "{{ $p._accent }}",
      "border.focused": "{{ $p._accent }}66",
      "players": [{ "cursor": "{{ $p._accent }}", "background": "{{ $p._accent }}", "selection": "{{ $p._accent }}3d" }]
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "auto_install_extensions": {
    "toml": true,
    "html": true,
    "svelte": true,
    "dockerfile": true,
    "sql": true,
    "material-icon-theme": true
  },
  "auto_update_extensions": {
    "strand": false
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "load_direnv": "shell_hook"
}
