{{- $p := include "dot_config/palette/active.json" | fromJson -}}
/* GTK4/libadwaita colors from palette/active.json (chezmoi template); the block
   is .chezmoitemplates/gtk-colors, shared with gtk-3.0. */

{{ template "gtk-colors" $p }}

/* adw-gtk3's GTK4 tweaks pin plain (non-libadwaita) GTK4 apps to GNOME's blue;
   point them back at the accent above */
:root { --accent-bg-color: @accent_bg_color; }
