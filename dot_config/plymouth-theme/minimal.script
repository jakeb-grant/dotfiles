# Minimal Plymouth Theme - Simple and reliable

# Set solid dark background
Window.SetBackgroundTopColor(0.10, 0.10, 0.10);
Window.SetBackgroundBottomColor(0.10, 0.10, 0.10);

# Screen dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Simple spinner using dots
NUM_DOTS = 12;
DOT_RADIUS = 30;

for (i = 0; i < NUM_DOTS; i++) {
    dots[i] = Sprite();
}

# Animation state
global.angle = 0;

fun refresh_callback() {
    global.angle = global.angle + 0.15;

    for (i = 0; i < NUM_DOTS; i++) {
        # Calculate position in circle
        a = (i * 3.14159 * 2 / NUM_DOTS) + global.angle;

        # Manual sin/cos approximation using lookup
        # Normalize angle to 0-2pi range
        while (a > 6.28318) a = a - 6.28318;
        while (a < 0) a = a + 6.28318;

        # Simple sin/cos using quarter values
        if (a < 1.5708) {
            cos_val = 1 - (a * a / 2);
            sin_val = a - (a * a * a / 6);
        } else if (a < 3.14159) {
            a2 = a - 1.5708;
            cos_val = -a2 + (a2 * a2 * a2 / 6);
            sin_val = 1 - (a2 * a2 / 2);
        } else if (a < 4.71239) {
            a2 = a - 3.14159;
            cos_val = -1 + (a2 * a2 / 2);
            sin_val = -a2 + (a2 * a2 * a2 / 6);
        } else {
            a2 = a - 4.71239;
            cos_val = a2 - (a2 * a2 * a2 / 6);
            sin_val = -1 + (a2 * a2 / 2);
        }

        x = screen_width / 2 + cos_val * DOT_RADIUS;
        y = screen_height / 2 + sin_val * DOT_RADIUS;

        # Fade based on position
        opacity = 0.3 + (i / NUM_DOTS) * 0.7;

        dot_image = Image.Text("●", 0.5, 0.5, 0.5, 1, "Sans 10");
        dots[i].SetImage(dot_image);
        dots[i].SetPosition(x - 5, y - 5, 2);
        dots[i].SetOpacity(opacity);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# Password prompt
fun display_password_callback(prompt_text, num_bullets) {
    # Hide spinner dots during password entry
    for (i = 0; i < NUM_DOTS; i++) {
        dots[i].SetOpacity(0);
    }

    # Prompt label
    prompt_image = Image.Text(prompt_text, 0.53, 0.53, 0.53, 1, "Sans 14");
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(screen_width / 2 - prompt_image.GetWidth() / 2, screen_height / 2 - 50, 10);

    # Password bullets
    bullet_text = "";
    for (i = 0; i < num_bullets; i++) {
        bullet_text = bullet_text + "● ";
    }

    if (num_bullets > 0) {
        bullet_image = Image.Text(bullet_text, 1, 1, 1, 1, "Sans 18");
        bullet_sprite.SetImage(bullet_image);
        bullet_sprite.SetPosition(screen_width / 2 - bullet_image.GetWidth() / 2, screen_height / 2, 10);
    } else {
        # Clear bullets
        empty_image = Image.Text(" ", 1, 1, 1, 1, "Sans 18");
        bullet_sprite.SetImage(empty_image);
        bullet_sprite.SetPosition(screen_width / 2, screen_height / 2, 10);
    }
}

prompt_sprite = Sprite();
bullet_sprite = Sprite();

Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Messages
message_sprite = Sprite();

fun message_callback(text) {
    image = Image.Text(text, 0.53, 0.53, 0.53, 1, "Sans 12");
    message_sprite.SetImage(image);
    message_sprite.SetPosition(screen_width / 2 - image.GetWidth() / 2, screen_height * 0.8, 5);
}

Plymouth.SetMessageFunction(message_callback);

# Quit
fun quit_callback() {
}

Plymouth.SetQuitFunction(quit_callback);
