● /* Window */
window.auth-window.background,
window.auth-window {
    background-color: #dce0e8;
}

/* Typography */
.auth-header {
    color: #4c4f69;
    font-weight: bold;
}

.auth-message {
    color: #4c4f69;
}

.auth-retry {
    color: #4c4f69;
}

/* Identity dropdown */
dropdown.auth-identity > button.toggle {
    background: none;
    background-color: #e6e9ef;
    border-color: #bcc0cc;
    border-radius: 8px;
    color: #4c4f69;
}

dropdown.auth-identity > popover.menu > contents,
dropdown.auth-identity listview {
    background-color: #e6e9ef;
    border-color: #bcc0cc;
}

dropdown.auth-identity listview > row:hover,
dropdown.auth-identity listview > row:selected {
    background-color: #eff1f5;
}

dropdown.auth-identity listview > row:focus:not(:hover) {
    background-color: transparent;
}

/* Password entry */
.auth-password {
    background: #e6e9ef;
    border-color: #bcc0cc;
    border-radius: 8px;
    color: #4c4f69;
}

entry.auth-password:focus-within {
    outline-color: #ccd0da;
}

/* Buttons */
.auth-buttons {
    margin-top: 4px;
}

.auth-cancel,
.auth-confirm {
    background: #e6e9ef;
    border-color: #bcc0cc;
    color: #4c4f69;
}

.auth-cancel:hover,
.auth-confirm:hover {
    background: #eff1f5;
}
