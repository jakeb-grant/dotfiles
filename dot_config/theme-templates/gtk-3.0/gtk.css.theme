/* GTK3 color overrides - Generated from theme template */

@define-color window_bg_color {< crust >};
@define-color window_fg_color {< text >};
@define-color view_bg_color {< crust >};
@define-color view_fg_color {< text >};
@define-color accent_bg_color {< surface0 >};
@define-color accent_fg_color {< crust >};
@define-color accent_color {< surface0 >};
@define-color headerbar_bg_color {< crust >};
@define-color headerbar_fg_color {< text >};
@define-color headerbar_backdrop_color {< crust >};
@define-color card_bg_color {< mantle >};
@define-color card_fg_color {< text >};
@define-color popover_bg_color {< mantle >};
@define-color popover_fg_color {< text >};
@define-color dialog_bg_color {< mantle >};
@define-color dialog_fg_color {< text >};
@define-color sidebar_bg_color {< crust >};
@define-color sidebar_fg_color {< text >};
@define-color sidebar_backdrop_color {< crust >};
@define-color sidebar_shade_color rgba(0, 0, 0, 0.07);
@define-color secondary_sidebar_bg_color {< crust >};
@define-color secondary_sidebar_fg_color {< text >};
@define-color secondary_sidebar_backdrop_color {< crust >};
@define-color secondary_sidebar_shade_color rgba(0, 0, 0, 0.07);

/* Semantic colors */
@define-color error_bg_color {< red >};
@define-color error_fg_color {< crust >};
@define-color error_color {< red >};
@define-color warning_bg_color {< yellow >};
@define-color warning_fg_color {< crust >};
@define-color warning_color {< yellow >};
@define-color success_bg_color {< green >};
@define-color success_fg_color {< crust >};
@define-color success_color {< green >};

/* Borders and separators */
@define-color borders {< surface1 >};
@define-color shade_color rgba(0, 0, 0, 0.07);
@define-color scrollbar_outline_color {< surface1 >};
