# Yazi Theme - Generated from theme template

[mgr]
cwd = { fg = "{< text >}" }
hovered = { bg = "{< surface1 >}" }
preview_hovered = { bg = "{< surface0 >}" }
find_keyword = { fg = "{< yellow >}", bold = true }
find_position = { fg = "{< mauve >}", italic = true }
marker_copied = { fg = "{< green >}", bg = "{< green >}" }
marker_cut = { fg = "{< red >}", bg = "{< red >}" }
marker_marked = { fg = "{< teal >}", bg = "{< teal >}" }
marker_selected = { fg = "{< yellow >}", bg = "{< yellow >}" }
count_copied = { fg = "{< crust >}", bg = "{< green >}" }
count_cut = { fg = "{< crust >}", bg = "{< red >}" }
count_selected = { fg = "{< crust >}", bg = "{< yellow >}" }
border_style = { fg = "{< surface1 >}" }

[tabs]
active = { fg = "{< text >}", bg = "{< surface1 >}" }
inactive = { fg = "{< subtext0 >}", bg = "{< mantle >}" }

[mode]
normal_main = { fg = "{< crust >}", bg = "{< blue >}", bold = true }
normal_alt = { fg = "{< blue >}", bg = "{< mantle >}" }
select_main = { fg = "{< crust >}", bg = "{< green >}", bold = true }
select_alt = { fg = "{< green >}", bg = "{< mantle >}" }
unset_main = { fg = "{< crust >}", bg = "{< mauve >}", bold = true }
unset_alt = { fg = "{< mauve >}", bg = "{< mantle >}" }

[status]
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }
overall = { fg = "{< text >}", bg = "{< mantle >}" }
perm_read = { fg = "{< green >}" }
perm_write = { fg = "{< yellow >}" }
perm_exec = { fg = "{< red >}" }
perm_sep = { fg = "{< subtext0 >}" }

[pick]
border = { fg = "{< surface1 >}" }
active = { fg = "{< text >}" }
inactive = { fg = "{< subtext0 >}" }

[input]
border = { fg = "{< surface1 >}" }
title = { fg = "{< text >}" }
value = { fg = "{< text >}" }
selected = { bg = "{< surface1 >}" }

[confirm]
border = { fg = "{< surface1 >}" }
title = { fg = "{< text >}", bold = true }
content = { fg = "{< text >}" }
list = { fg = "{< text >}" }
btn_yes = { bg = "{< green >}", fg = "{< crust >}" }
btn_no = { bg = "{< red >}", fg = "{< crust >}" }
btn_labels = ["Yes", "No"]

[cmp]
border = { fg = "{< surface1 >}" }
active = { fg = "{< text >}", bg = "{< surface1 >}" }
inactive = { fg = "{< subtext0 >}" }
icon_file = ""
icon_folder = ""
icon_command = ""

[tasks]
border = { fg = "{< surface1 >}" }
title = { fg = "{< text >}" }
hovered = { bg = "{< surface1 >}" }

[which]
cols = 3
mask = { bg = "{< crust >}" }
cand = { fg = "{< teal >}" }
rest = { fg = "{< subtext0 >}" }
desc = { fg = "{< text >}" }
separator = "  "
separator_style = { fg = "{< surface1 >}" }

[help]
on = { fg = "{< teal >}" }
run = { fg = "{< text >}" }
desc = { fg = "{< subtext0 >}" }
hovered = { bg = "{< surface1 >}" }
footer = { fg = "{< subtext0 >}", bg = "{< mantle >}" }

[notify]
title_info = { fg = "{< sapphire >}" }
title_warn = { fg = "{< yellow >}" }
title_error = { fg = "{< red >}" }

[filetype]
rules = [
    # Directories
    { url = "*/", fg = "{< blue >}", bold = true },

    # Executables
    { mime = "application/x-executable", fg = "{< green >}" },
    { mime = "application/x-sharedlib", fg = "{< green >}" },

    # Archives
    { mime = "application/*zip*", fg = "{< mauve >}" },
    { mime = "application/x-tar", fg = "{< mauve >}" },
    { mime = "application/x-*compressed*", fg = "{< mauve >}" },
    { mime = "application/x-rar", fg = "{< mauve >}" },
    { mime = "application/x-7z*", fg = "{< mauve >}" },

    # Documents
    { mime = "application/pdf", fg = "{< red >}" },
    { mime = "application/*doc*", fg = "{< blue >}" },
    { mime = "application/*sheet*", fg = "{< green >}" },
    { mime = "application/*presentation*", fg = "{< yellow >}" },

    # Images
    { mime = "image/*", fg = "{< teal >}" },

    # Video
    { mime = "video/*", fg = "{< mauve >}" },

    # Audio
    { mime = "audio/*", fg = "{< yellow >}" },

    # Text/Code
    { mime = "text/*", fg = "{< text >}" },
    { mime = "application/json", fg = "{< yellow >}" },
    { mime = "application/javascript", fg = "{< yellow >}" },
    { mime = "application/x-yaml", fg = "{< teal >}" },

    # Symlinks
    { url = "*", is = "link", fg = "{< teal >}", italic = true },

    # Orphan links
    { url = "*", is = "orphan", fg = "{< red >}", italic = true },
]
