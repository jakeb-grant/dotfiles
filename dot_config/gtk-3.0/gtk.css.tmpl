/* GTK3 color overrides - Generated from theme template */

@define-color window_bg_color #dce0e8;
@define-color window_fg_color #4c4f69;
@define-color view_bg_color #dce0e8;
@define-color view_fg_color #4c4f69;
@define-color accent_bg_color #ccd0da;
@define-color accent_fg_color #dce0e8;
@define-color accent_color #ccd0da;
@define-color headerbar_bg_color #dce0e8;
@define-color headerbar_fg_color #4c4f69;
@define-color headerbar_backdrop_color #dce0e8;
@define-color card_bg_color #e6e9ef;
@define-color card_fg_color #4c4f69;
@define-color popover_bg_color #e6e9ef;
@define-color popover_fg_color #4c4f69;
@define-color dialog_bg_color #e6e9ef;
@define-color dialog_fg_color #4c4f69;
@define-color sidebar_bg_color #dce0e8;
@define-color sidebar_fg_color #4c4f69;
@define-color sidebar_backdrop_color #dce0e8;
@define-color sidebar_shade_color rgba(220, 224, 232, 0.50);
@define-color secondary_sidebar_bg_color #dce0e8;
@define-color secondary_sidebar_fg_color #4c4f69;
@define-color secondary_sidebar_backdrop_color #dce0e8;
@define-color secondary_sidebar_shade_color rgba(220, 224, 232, 0.50);

/* Semantic colors */
@define-color error_bg_color #d20f39;
@define-color error_fg_color #dce0e8;
@define-color error_color #d20f39;
@define-color warning_bg_color #df8e1d;
@define-color warning_fg_color #dce0e8;
@define-color warning_color #df8e1d;
@define-color success_bg_color #40a02b;
@define-color success_fg_color #dce0e8;
@define-color success_color #40a02b;

/* Borders and separators */
@define-color borders #bcc0cc;
@define-color shade_color rgba(220, 224, 232, 0.50);
@define-color scrollbar_outline_color #bcc0cc;

/* ===== GTK3 widget overrides (Adwaita doesn't use @define-color) ===== */

/* Base window and dialog backgrounds */
window, dialog, .background {
  background-color: #dce0e8;
  color: #4c4f69;
}

/* Header bars */
headerbar, .titlebar, headerbar .title {
  background-color: #dce0e8;
  background-image: none;
  color: #4c4f69;
  border-color: #ccd0da;
  box-shadow: none;
}

headerbar:hover, .titlebar:hover {
  background-color: #dce0e8;
  background-image: none;
}

headerbar:backdrop, .titlebar:backdrop {
  background-color: #dce0e8;
  background-image: none;
}

headerbar button, .titlebar button {
  background-color: #ccd0da;
  background-image: none;
  color: #4c4f69;
  border-color: #bcc0cc;
  box-shadow: none;
  -gtk-icon-shadow: none;
  text-shadow: none;
}

headerbar button:hover, .titlebar button:hover {
  background-color: #bcc0cc;
  background-image: none;
  box-shadow: none;
}

/* Sidebars / Places panel (file picker left panel) */
.sidebar, placessidebar, .places-sidebar, placessidebar row {
  background-color: #dce0e8;
  color: #4c4f69;
}

placessidebar row:selected {
  background-color: #ccd0da;
  color: #4c4f69;
}

placessidebar row:hover {
  background-color: #ccd0da;
}

/* Main content / file list area */
treeview, treeview.view, .view {
  background-color: #eff1f5;
  color: #4c4f69;
}

treeview header button, treeview.view header button {
  background-color: #e6e9ef;
  background-image: none;
  color: #5c5f77;
  border-color: #ccd0da;
}

/* Selection highlight */
treeview:selected, treeview.view:selected, .view:selected,
row:selected, *:selected {
  background-color: #ccd0da;
  background-image: none;
  color: #4c4f69;
}

treeview:hover, row:hover {
  background-color: #ccd0da;
}

/* Path bar / breadcrumbs */
.path-bar button, .linked.path-bar > button,
.path-bar .slider-button,
.linked.path-bar > button image,
.nautilus-path-bar button,
headerbar .path-bar button,
headerbar .linked > button {
  background-color: #ccd0da;
  background-image: none;
  color: #4c4f69;
  border-color: #bcc0cc;
  box-shadow: none;
  -gtk-icon-shadow: none;
  text-shadow: none;
}

.path-bar button:hover, .linked.path-bar > button:hover,
headerbar .path-bar button:hover,
headerbar .linked > button:hover {
  background-color: #bcc0cc;
  background-image: none;
  box-shadow: none;
}

.path-bar button:checked, .linked.path-bar > button:checked,
headerbar .path-bar button:checked,
headerbar .linked > button:checked {
  background-color: #bcc0cc;
  background-image: none;
  box-shadow: none;
  color: #4c4f69;
}

/* Text entries (filename input, search) */
entry {
  background-color: #eff1f5;
  color: #4c4f69;
  border-color: #bcc0cc;
  caret-color: #4c4f69;
}

entry:focus {
  border-color: #8c8fa1;
}

/* Buttons */
button {
  background-color: #ccd0da;
  background-image: none;
  color: #4c4f69;
  border-color: #bcc0cc;
  box-shadow: none;
  -gtk-icon-shadow: none;
  text-shadow: none;
}

button:hover {
  background-color: #bcc0cc;
  background-image: none;
  box-shadow: none;
}

button.suggested-action {
  background-color: #209fb5;
  background-image: none;
  color: #dce0e8;
}

button.suggested-action:hover {
  background-color: #209fb5;
  background-image: none;
  opacity: 0.8;
}

/* Scrollbars */
scrollbar slider {
  background-color: #bcc0cc;
}

scrollbar slider:hover {
  background-color: #acb0be;
}

/* Separators and borders */
separator {
  background-color: #ccd0da;
}

/* Pane borders */
paned > separator {
  background-color: #ccd0da;
  background-image: none;
  border: none;
  min-width: 1px;
  min-height: 1px;
}

/* All borders/frames */
frame > border, .frame {
  border-color: #ccd0da;
}

/* Headerbar bottom edge shadow/border */
headerbar, .titlebar {
  box-shadow: none;
  border-bottom: 1px solid #ccd0da;
}

headerbar:backdrop, .titlebar:backdrop {
  box-shadow: none;
  border-bottom: 1px solid #ccd0da;
}

/* Column header borders */
treeview header, treeview.view header {
  border-bottom: 1px solid #ccd0da;
}

treeview header button, treeview.view header button {
  border-color: #ccd0da;
  box-shadow: none;
}

/* Window decoration border */
decoration {
  border-color: #ccd0da;
  box-shadow: none;
}

/* Scrolled window borders */
scrolledwindow {
  border-color: #ccd0da;
}

scrolledwindow overshoot, scrolledwindow undershoot {
  background: none;
}

/* File chooser specific */
filechooser .view,
filechooser scrolledwindow {
  border-color: #ccd0da;
}

/* Generic border override */
*, *:backdrop {
  -GtkWidget-separator-color: #ccd0da;
  outline-color: #bcc0cc;
  border-color: #ccd0da;
}

/* Popovers and menus */
popover, popover.background, menu {
  background-color: #e6e9ef;
  color: #4c4f69;
}

menu menuitem:hover {
  background-color: #ccd0da;
}

/* Tooltips */
tooltip, tooltip.background {
  background-color: #ccd0da;
  color: #4c4f69;
}

/* Status bar at the bottom */
actionbar, .action-bar {
  background-color: #dce0e8;
  color: #4c4f69;
  border-top: 1px solid #ccd0da;
  box-shadow: none;
}

actionbar > revealer > box {
  border-top-color: #ccd0da;
  box-shadow: none;
}

/* Check buttons */
checkbutton check {
  background-color: #eff1f5;
  border-color: #bcc0cc;
}

checkbutton:checked check {
  background-color: #209fb5;
  border-color: #209fb5;
}
