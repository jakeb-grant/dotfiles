{{- $p := include "dot_config/palette/active.json" | fromJson -}}
/* GTK3 color overrides - colors from palette/active.json (chezmoi template) */

@define-color window_bg_color {{ $p.crust }};
@define-color window_fg_color {{ $p.text }};
@define-color view_bg_color {{ $p.crust }};
@define-color view_fg_color {{ $p.text }};
@define-color accent_bg_color {{ $p.surface0 }};
@define-color accent_fg_color {{ $p.crust }};
@define-color accent_color {{ $p.surface0 }};
@define-color headerbar_bg_color {{ $p.crust }};
@define-color headerbar_fg_color {{ $p.text }};
@define-color headerbar_backdrop_color {{ $p.crust }};
@define-color card_bg_color {{ $p.mantle }};
@define-color card_fg_color {{ $p.text }};
@define-color popover_bg_color {{ $p.mantle }};
@define-color popover_fg_color {{ $p.text }};
@define-color dialog_bg_color {{ $p.mantle }};
@define-color dialog_fg_color {{ $p.text }};
@define-color sidebar_bg_color {{ $p.crust }};
@define-color sidebar_fg_color {{ $p.text }};
@define-color sidebar_backdrop_color {{ $p.crust }};
@define-color sidebar_shade_color {{ template "rgba" (list $p.crust 0.5) }};
@define-color secondary_sidebar_bg_color {{ $p.crust }};
@define-color secondary_sidebar_fg_color {{ $p.text }};
@define-color secondary_sidebar_backdrop_color {{ $p.crust }};
@define-color secondary_sidebar_shade_color {{ template "rgba" (list $p.crust 0.5) }};

/* Semantic colors */
@define-color error_bg_color {{ $p.red }};
@define-color error_fg_color {{ $p.crust }};
@define-color error_color {{ $p.red }};
@define-color warning_bg_color {{ $p.yellow }};
@define-color warning_fg_color {{ $p.crust }};
@define-color warning_color {{ $p.yellow }};
@define-color success_bg_color {{ $p.green }};
@define-color success_fg_color {{ $p.crust }};
@define-color success_color {{ $p.green }};

/* Borders and separators */
@define-color borders {{ $p.surface1 }};
@define-color shade_color {{ template "rgba" (list $p.crust 0.5) }};
@define-color scrollbar_outline_color {{ $p.surface1 }};

/* ===== GTK3 widget overrides (Adwaita doesn't use @define-color) ===== */

/* Base window and dialog backgrounds */
window, dialog, .background {
  background-color: {{ $p.crust }};
  color: {{ $p.text }};
}

/* Header bars */
headerbar, .titlebar, headerbar .title {
  background-color: {{ $p.crust }};
  background-image: none;
  color: {{ $p.text }};
  border-color: {{ $p.surface0 }};
  box-shadow: none;
}

headerbar:hover, .titlebar:hover {
  background-color: {{ $p.crust }};
  background-image: none;
}

headerbar:backdrop, .titlebar:backdrop {
  background-color: {{ $p.crust }};
  background-image: none;
}

headerbar button, .titlebar button {
  background-color: {{ $p.surface0 }};
  background-image: none;
  color: {{ $p.text }};
  border-color: {{ $p.surface1 }};
  box-shadow: none;
  -gtk-icon-shadow: none;
  text-shadow: none;
}

headerbar button:hover, .titlebar button:hover {
  background-color: {{ $p.surface1 }};
  background-image: none;
  box-shadow: none;
}

/* Sidebars / Places panel (file picker left panel) */
.sidebar, placessidebar, .places-sidebar, placessidebar row {
  background-color: {{ $p.crust }};
  color: {{ $p.text }};
}

placessidebar row:selected {
  background-color: {{ $p.surface0 }};
  color: {{ $p.text }};
}

placessidebar row:hover {
  background-color: {{ $p.surface0 }};
}

/* Main content / file list area */
treeview, treeview.view, .view {
  background-color: {{ $p.base }};
  color: {{ $p.text }};
}

treeview header button, treeview.view header button {
  background-color: {{ $p.mantle }};
  background-image: none;
  color: {{ $p.subtext1 }};
  border-color: {{ $p.surface0 }};
}

/* Selection highlight */
treeview:selected, treeview.view:selected, .view:selected,
row:selected, *:selected {
  background-color: {{ $p.surface0 }};
  background-image: none;
  color: {{ $p.text }};
}

treeview:hover, row:hover {
  background-color: {{ $p.surface0 }};
}

/* Path bar / breadcrumbs */
.path-bar button, .linked.path-bar > button,
.path-bar .slider-button,
.linked.path-bar > button image,
.nautilus-path-bar button,
headerbar .path-bar button,
headerbar .linked > button {
  background-color: {{ $p.surface0 }};
  background-image: none;
  color: {{ $p.text }};
  border-color: {{ $p.surface1 }};
  box-shadow: none;
  -gtk-icon-shadow: none;
  text-shadow: none;
}

.path-bar button:hover, .linked.path-bar > button:hover,
headerbar .path-bar button:hover,
headerbar .linked > button:hover {
  background-color: {{ $p.surface1 }};
  background-image: none;
  box-shadow: none;
}

.path-bar button:checked, .linked.path-bar > button:checked,
headerbar .path-bar button:checked,
headerbar .linked > button:checked {
  background-color: {{ $p.surface1 }};
  background-image: none;
  box-shadow: none;
  color: {{ $p.text }};
}

/* Text entries (filename input, search) */
entry {
  background-color: {{ $p.base }};
  color: {{ $p.text }};
  border-color: {{ $p.surface1 }};
  caret-color: {{ $p.text }};
}

entry:focus {
  border-color: {{ $p.overlay1 }};
}

/* Buttons */
button {
  background-color: {{ $p.surface0 }};
  background-image: none;
  color: {{ $p.text }};
  border-color: {{ $p.surface1 }};
  box-shadow: none;
  -gtk-icon-shadow: none;
  text-shadow: none;
}

button:hover {
  background-color: {{ $p.surface1 }};
  background-image: none;
  box-shadow: none;
}

button.suggested-action {
  background-color: {{ $p._accent }};
  background-image: none;
  color: {{ $p.crust }};
}

button.suggested-action:hover {
  background-color: {{ $p._accent }};
  background-image: none;
  opacity: 0.8;
}

/* Scrollbars */
scrollbar slider {
  background-color: {{ $p.surface1 }};
}

scrollbar slider:hover {
  background-color: {{ $p.surface2 }};
}

/* Separators and borders */
separator {
  background-color: {{ $p.surface0 }};
}

/* Pane borders */
paned > separator {
  background-color: {{ $p.surface0 }};
  background-image: none;
  border: none;
  min-width: 1px;
  min-height: 1px;
}

/* All borders/frames */
frame > border, .frame {
  border-color: {{ $p.surface0 }};
}

/* Headerbar bottom edge shadow/border */
headerbar, .titlebar {
  box-shadow: none;
  border-bottom: 1px solid {{ $p.surface0 }};
}

headerbar:backdrop, .titlebar:backdrop {
  box-shadow: none;
  border-bottom: 1px solid {{ $p.surface0 }};
}

/* Column header borders */
treeview header, treeview.view header {
  border-bottom: 1px solid {{ $p.surface0 }};
}

treeview header button, treeview.view header button {
  border-color: {{ $p.surface0 }};
  box-shadow: none;
}

/* Window decoration border */
decoration {
  border-color: {{ $p.surface0 }};
  box-shadow: none;
}

/* Scrolled window borders */
scrolledwindow {
  border-color: {{ $p.surface0 }};
}

scrolledwindow overshoot, scrolledwindow undershoot {
  background: none;
}

/* File chooser specific */
filechooser .view,
filechooser scrolledwindow {
  border-color: {{ $p.surface0 }};
}

/* Generic border override */
*, *:backdrop {
  -GtkWidget-separator-color: {{ $p.surface0 }};
  outline-color: {{ $p.surface1 }};
  border-color: {{ $p.surface0 }};
}

/* Popovers and menus */
popover, popover.background, menu {
  background-color: {{ $p.mantle }};
  color: {{ $p.text }};
}

menu menuitem:hover {
  background-color: {{ $p.surface0 }};
}

/* Tooltips */
tooltip, tooltip.background {
  background-color: {{ $p.surface0 }};
  color: {{ $p.text }};
}

/* Status bar at the bottom */
actionbar, .action-bar {
  background-color: {{ $p.crust }};
  color: {{ $p.text }};
  border-top: 1px solid {{ $p.surface0 }};
  box-shadow: none;
}

actionbar > revealer > box {
  border-top-color: {{ $p.surface0 }};
  box-shadow: none;
}

/* Check buttons */
checkbutton check {
  background-color: {{ $p.base }};
  border-color: {{ $p.surface1 }};
}

checkbutton:checked check {
  background-color: {{ $p._accent }};
  border-color: {{ $p._accent }};
}
