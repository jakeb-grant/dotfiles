# Yazi Theme - Generated from theme template

[mgr]
cwd = { fg = "#4c4f69" }
hovered = { bg = "#bcc0cc" }
preview_hovered = { bg = "#ccd0da" }
find_keyword = { fg = "#df8e1d", bold = true }
find_position = { fg = "#8839ef", italic = true }
marker_copied = { fg = "#40a02b", bg = "#40a02b" }
marker_cut = { fg = "#d20f39", bg = "#d20f39" }
marker_marked = { fg = "#179299", bg = "#179299" }
marker_selected = { fg = "#df8e1d", bg = "#df8e1d" }
count_copied = { fg = "#dce0e8", bg = "#40a02b" }
count_cut = { fg = "#dce0e8", bg = "#d20f39" }
count_selected = { fg = "#dce0e8", bg = "#df8e1d" }
border_style = { fg = "#bcc0cc" }

[tabs]
active = { fg = "#4c4f69", bg = "#bcc0cc" }
inactive = { fg = "#6c6f85", bg = "#e6e9ef" }

[mode]
normal_main = { fg = "#dce0e8", bg = "#1e66f5", bold = true }
normal_alt = { fg = "#1e66f5", bg = "#e6e9ef" }
select_main = { fg = "#dce0e8", bg = "#40a02b", bold = true }
select_alt = { fg = "#40a02b", bg = "#e6e9ef" }
unset_main = { fg = "#dce0e8", bg = "#8839ef", bold = true }
unset_alt = { fg = "#8839ef", bg = "#e6e9ef" }

[status]
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }
overall = { fg = "#4c4f69", bg = "#e6e9ef" }
perm_read = { fg = "#40a02b" }
perm_write = { fg = "#df8e1d" }
perm_exec = { fg = "#d20f39" }
perm_sep = { fg = "#6c6f85" }

[pick]
border = { fg = "#bcc0cc" }
active = { fg = "#4c4f69" }
inactive = { fg = "#6c6f85" }

[input]
border = { fg = "#bcc0cc" }
title = { fg = "#4c4f69" }
value = { fg = "#4c4f69" }
selected = { bg = "#bcc0cc" }

[confirm]
border = { fg = "#bcc0cc" }
title = { fg = "#4c4f69", bold = true }
content = { fg = "#4c4f69" }
list = { fg = "#4c4f69" }
btn_yes = { bg = "#40a02b", fg = "#dce0e8" }
btn_no = { bg = "#d20f39", fg = "#dce0e8" }
btn_labels = ["Yes", "No"]

[cmp]
border = { fg = "#bcc0cc" }
active = { fg = "#4c4f69", bg = "#bcc0cc" }
inactive = { fg = "#6c6f85" }
icon_file = ""
icon_folder = ""
icon_command = ""

[tasks]
border = { fg = "#bcc0cc" }
title = { fg = "#4c4f69" }
hovered = { bg = "#bcc0cc" }

[which]
cols = 3
mask = { bg = "#dce0e8" }
cand = { fg = "#179299" }
rest = { fg = "#6c6f85" }
desc = { fg = "#4c4f69" }
separator = "  "
separator_style = { fg = "#bcc0cc" }

[help]
on = { fg = "#179299" }
run = { fg = "#4c4f69" }
desc = { fg = "#6c6f85" }
hovered = { bg = "#bcc0cc" }
footer = { fg = "#6c6f85", bg = "#e6e9ef" }

[notify]
title_info = { fg = "#209fb5" }
title_warn = { fg = "#df8e1d" }
title_error = { fg = "#d20f39" }

[filetype]
rules = [
    # Directories
    { url = "*/", fg = "#1e66f5", bold = true },

    # Executables
    { mime = "application/x-executable", fg = "#40a02b" },
    { mime = "application/x-sharedlib", fg = "#40a02b" },

    # Archives
    { mime = "application/*zip*", fg = "#8839ef" },
    { mime = "application/x-tar", fg = "#8839ef" },
    { mime = "application/x-*compressed*", fg = "#8839ef" },
    { mime = "application/x-rar", fg = "#8839ef" },
    { mime = "application/x-7z*", fg = "#8839ef" },

    # Documents
    { mime = "application/pdf", fg = "#d20f39" },
    { mime = "application/*doc*", fg = "#1e66f5" },
    { mime = "application/*sheet*", fg = "#40a02b" },
    { mime = "application/*presentation*", fg = "#df8e1d" },

    # Images
    { mime = "image/*", fg = "#179299" },

    # Video
    { mime = "video/*", fg = "#8839ef" },

    # Audio
    { mime = "audio/*", fg = "#df8e1d" },

    # Text/Code
    { mime = "text/*", fg = "#4c4f69" },
    { mime = "application/json", fg = "#df8e1d" },
    { mime = "application/javascript", fg = "#df8e1d" },
    { mime = "application/x-yaml", fg = "#179299" },

    # Symlinks
    { url = "*", is = "link", fg = "#179299", italic = true },

    # Orphan links
    { url = "*", is = "orphan", fg = "#d20f39", italic = true },
]
