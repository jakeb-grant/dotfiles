{{- $p := include "dot_config/palette/active.json" | fromJson -}}
# Yazi Theme - colors from palette/active.json (chezmoi template)

[mgr]
cwd = { fg = "{{ $p.text }}" }
hovered = { bg = "{{ $p.surface1 }}" }
preview_hovered = { bg = "{{ $p.surface0 }}" }
find_keyword = { fg = "{{ $p.yellow }}", bold = true }
find_position = { fg = "{{ $p.mauve }}", italic = true }
marker_copied = { fg = "{{ $p.green }}", bg = "{{ $p.green }}" }
marker_cut = { fg = "{{ $p.red }}", bg = "{{ $p.red }}" }
marker_marked = { fg = "{{ $p.teal }}", bg = "{{ $p.teal }}" }
marker_selected = { fg = "{{ $p.yellow }}", bg = "{{ $p.yellow }}" }
count_copied = { fg = "{{ $p.crust }}", bg = "{{ $p.green }}" }
count_cut = { fg = "{{ $p.crust }}", bg = "{{ $p.red }}" }
count_selected = { fg = "{{ $p.crust }}", bg = "{{ $p.yellow }}" }
border_style = { fg = "{{ $p.surface1 }}" }

[tabs]
active = { fg = "{{ $p.text }}", bg = "{{ $p.surface1 }}" }
inactive = { fg = "{{ $p.subtext0 }}", bg = "{{ $p.mantle }}" }

[mode]
normal_main = { fg = "{{ $p.crust }}", bg = "{{ $p.blue }}", bold = true }
normal_alt = { fg = "{{ $p.blue }}", bg = "{{ $p.mantle }}" }
select_main = { fg = "{{ $p.crust }}", bg = "{{ $p.green }}", bold = true }
select_alt = { fg = "{{ $p.green }}", bg = "{{ $p.mantle }}" }
unset_main = { fg = "{{ $p.crust }}", bg = "{{ $p.mauve }}", bold = true }
unset_alt = { fg = "{{ $p.mauve }}", bg = "{{ $p.mantle }}" }

[status]
sep_left = { open = "", close = "" }
sep_right = { open = "", close = "" }
overall = { fg = "{{ $p.text }}", bg = "{{ $p.mantle }}" }
perm_read = { fg = "{{ $p.green }}" }
perm_write = { fg = "{{ $p.yellow }}" }
perm_exec = { fg = "{{ $p.red }}" }
perm_sep = { fg = "{{ $p.subtext0 }}" }

[pick]
border = { fg = "{{ $p.surface1 }}" }
active = { fg = "{{ $p.text }}" }
inactive = { fg = "{{ $p.subtext0 }}" }

[input]
border = { fg = "{{ $p.surface1 }}" }
title = { fg = "{{ $p.text }}" }
value = { fg = "{{ $p.text }}" }
selected = { bg = "{{ $p.surface1 }}" }

[confirm]
border = { fg = "{{ $p.surface1 }}" }
title = { fg = "{{ $p.text }}", bold = true }
content = { fg = "{{ $p.text }}" }
list = { fg = "{{ $p.text }}" }
btn_yes = { bg = "{{ $p.green }}", fg = "{{ $p.crust }}" }
btn_no = { bg = "{{ $p.red }}", fg = "{{ $p.crust }}" }
btn_labels = ["Yes", "No"]

[cmp]
border = { fg = "{{ $p.surface1 }}" }
active = { fg = "{{ $p.text }}", bg = "{{ $p.surface1 }}" }
inactive = { fg = "{{ $p.subtext0 }}" }
icon_file = ""
icon_folder = ""
icon_command = ""

[tasks]
border = { fg = "{{ $p.surface1 }}" }
title = { fg = "{{ $p.text }}" }
hovered = { bg = "{{ $p.surface1 }}" }

[which]
cols = 3
mask = { bg = "{{ $p.crust }}" }
cand = { fg = "{{ $p.teal }}" }
rest = { fg = "{{ $p.subtext0 }}" }
desc = { fg = "{{ $p.text }}" }
separator = "  "
separator_style = { fg = "{{ $p.surface1 }}" }

[help]
on = { fg = "{{ $p.teal }}" }
run = { fg = "{{ $p.text }}" }
desc = { fg = "{{ $p.subtext0 }}" }
hovered = { bg = "{{ $p.surface1 }}" }
footer = { fg = "{{ $p.subtext0 }}", bg = "{{ $p.mantle }}" }

[notify]
title_info = { fg = "{{ $p.sapphire }}" }
title_warn = { fg = "{{ $p.yellow }}" }
title_error = { fg = "{{ $p.red }}" }

[filetype]
rules = [
    # Directories
    { url = "*/", fg = "{{ $p.blue }}", bold = true },

    # Executables
    { mime = "application/x-executable", fg = "{{ $p.green }}" },
    { mime = "application/x-sharedlib", fg = "{{ $p.green }}" },

    # Archives
    { mime = "application/*zip*", fg = "{{ $p.mauve }}" },
    { mime = "application/x-tar", fg = "{{ $p.mauve }}" },
    { mime = "application/x-*compressed*", fg = "{{ $p.mauve }}" },
    { mime = "application/x-rar", fg = "{{ $p.mauve }}" },
    { mime = "application/x-7z*", fg = "{{ $p.mauve }}" },

    # Documents
    { mime = "application/pdf", fg = "{{ $p.red }}" },
    { mime = "application/*doc*", fg = "{{ $p.blue }}" },
    { mime = "application/*sheet*", fg = "{{ $p.green }}" },
    { mime = "application/*presentation*", fg = "{{ $p.yellow }}" },

    # Images
    { mime = "image/*", fg = "{{ $p.teal }}" },

    # Video
    { mime = "video/*", fg = "{{ $p.mauve }}" },

    # Audio
    { mime = "audio/*", fg = "{{ $p.yellow }}" },

    # Text/Code
    { mime = "text/*", fg = "{{ $p.text }}" },
    { mime = "application/json", fg = "{{ $p.yellow }}" },
    { mime = "application/javascript", fg = "{{ $p.yellow }}" },
    { mime = "application/x-yaml", fg = "{{ $p.teal }}" },

    # Symlinks
    { url = "*", is = "link", fg = "{{ $p.teal }}", italic = true },

    # Orphan links
    { url = "*", is = "orphan", fg = "{{ $p.red }}", italic = true },
]
