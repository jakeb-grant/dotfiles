// island.strand: a small island at the top of each monitor. It never changes
// size. Left, that monitor's workspaces as numbered chips. Right, status, the date
// and the clock, each in its own place. When volume, the microphone or a backlight changes, all that fades away for a
// moment and the island shows that one level. Everything you would tune is in the first block.

// colour: whichever palette theme-switch last wrote, followed live, and `from`
// for anything that file doesn't say, or if it is ever missing or broken
service theme from file "~/.config/palette/active.json" {
  crust: color?; mantle: color?; base: color?; surface0: color?; surface1: color?; surface2: color?
  overlay0: color?; subtext0: color?; text: color?; _accent: color?; lavender: color?; mauve: color?
  red: color?; peach: color?; yellow: color?; green: color?; teal: color?; blue: color?; pink: color?
}
// the launcher's theme preview while you move over its Themes page, else the theme in use
let look = launcher.peek
use palette palette(
  from: material(seed: #89b4fa, dark: true),
  surface: look?.base ?? theme.base, surface_lowest: look?.crust ?? theme.crust, surface_low: look?.mantle ?? theme.mantle,
  surface_container: look?.surface0 ?? theme.surface0, surface_high: look?.surface1 ?? theme.surface1, surface_highest: look?.surface2 ?? theme.surface2,
  fg: look?.text ?? theme.text, fg_variant: look?.subtext0 ?? theme.subtext0, outline: look?.overlay0 ?? theme.overlay0, outline_variant: look?.surface1 ?? theme.surface1,
  accent: look?.accent ?? theme._accent, secondary: look?.lavender ?? theme.lavender, tertiary: look?.mauve ?? theme.mauve, error: look?.red ?? theme.red,
  red: look?.red ?? theme.red, orange: look?.peach ?? theme.peach, yellow: look?.yellow ?? theme.yellow, green: look?.green ?? theme.green,
  cyan: look?.teal ?? theme.teal, blue: look?.blue ?? theme.blue, magenta: look?.pink ?? theme.pink,
)
let ink    = $surface_lowest      // the island
let lit    = $fg                  // the workspace on screen, the clock
let edge   = $fg.alpha(0.09)      // its hairline
let dim    = $fg.alpha(0.70)      // status symbols
let used   = $fg.alpha(0.60)      // a workspace with windows
let empty  = $fg.alpha(0.30)      // an empty one
let track  = $fg.alpha(0.16)      // behind a volume or brightness bar
let warn   = $orange              // attention: a workspace, a low battery, no network
let danger = $red                 // a very low battery, a muted mic

// shape
let island_h = 34
let island_w = 640               // the launcher's width: it only drops out of it
let corner   = 12               // its corners (squircle): the launcher's and a notification's too
let left_w   = 300              // room for five workspaces, a few apps on each
let right_w  = 290              // room for every status symbol, the date and the clock
let pad      = 12               // inside the island's ends
let gap_top  = 6                // from the screen's edge to the island
let gap_low  = 2                // from the island to the windows
let chip_h   = 24               // a workspace's chip
let chip_gap = 3                // between chips
let app_size = 12               // an app's icon on a chip
let app_gap  = 3                // between them
let sym_size = 16               // status symbols
let sym_cell = 22               // the room each has
let wave_gap = 14               // the wave of what plays fills the middle, this short of either side
let wave_min = 48               // and shows while it has at least this
let wave_fade = 18              // its ends fading out over this
let level_w  = 260              // a volume or brightness bar, centred on the island
let level_h  = 4                // and its thickness
let level_side = 28             // the room either side of it: the symbol, and balance

// what it says
let clock_format = "%H:%M"
let date_format  = "%a %-d"
let sans = "IBM Plex Sans"
let mono = "JetBrainsMono Nerd Font"
let battery_low = 0.2
let battery_out = 0.1

// time
let glide = spring(520, 0.78)   // the workspaces
let soft  = spring(260, 1)      // colours
let swap_settle = 30ms          // how long a swap's news is gathered before it plays
let level_hold  = 1400ms        // a volume or brightness bar stays this long
let song_hold   = 1800ms        // a track you skipped to
let clear_out   = 110ms         // everything else fading away for it
let clear_back  = 240ms         // and coming back
let wake_up     = 1500ms        // readings this soon after starting are not changes

enum Moment { idle, vol, mic, bright, kbd, song }

// The media keys, bound in the compositor: strand toggle island.play_key (and
// next_key, prev_key). A track you skip to shows on the island for a moment; one
// that comes on its own only nudges the wave.
export state play_key = false
export state next_key = false
export state prev_key = false
state skipped = 0                // a skip just asked for: 1 on, -1 back
on change play_key { media.play_pause() }
on change next_key { skipped = 1; media.next() }
on change prev_key { skipped = -1; media.previous() }
on change skipped after 2s { skipped = 0 }

keyframes bump { 0%, 100% { scale: 1 }; 40% { scale: 1.18 }; duration: 420ms }

panel Island {
  screens: all; anchor: top; margin: gap_top, 0, 0
  size: auto
  exclusive: island_h + gap_low
  enter { y: -14; opacity: 0 }

  // The first readings as the shell starts are not changes.
  state armed = false
  after wake_up while true { armed = true }

  Body armed
}

component Body(armed: bool) {
  // The workspace drawn as on screen. A compositor may tell of the new one and
  // the old one a frame apart; one value here starts both together.
  let now = workspaces.slots(screen).find(w => w.active)?.id
  state shown: int? = null
  on change now after swap_settle { shown = now }

  // A level shows on every island when it changes, whatever changed it.
  state moment: Moment = idle
  state ticks = 0
  on change audio.sink.volume, audio.sink.muted {
    if armed { moment = vol; ticks += 1 }
  }
  on change audio.source.volume, audio.source.muted {
    if armed { moment = mic; ticks += 1 }
  }
  on change brightness.level {
    if armed { moment = bright; ticks += 1 }
  }
  on change brightness.keyboard {
    if armed { moment = kbd; ticks += 1 }
  }
  // something playing and heard; a gap between tracks (a player saying it stopped
  // for a moment) keeps the wave
  let wave_wanted = media.playing && !audio.sink.muted
  state wave_hold = false
  on change wave_wanted { if !wave_wanted { wave_hold = true } }
  on change wave_wanted after 600ms { wave_hold = false }
  // it sits over the island, apart from its layout, so nothing moves for it,
  // filling the room between the workspaces and the symbols as they are laid out
  // (gliding and stretching as they change), and shows while that room holds it
  let chips_end = chipbox.box.x + chipbox.box.width
  let wave_len = statbox.box.x - chips_end - 2 * wave_gap
  let wave_room = wave_len >= wave_min
  let waving = wave_wanted || wave_hold

  on change ticks after level_hold { if moment != song { moment = idle } }
  on change ticks after song_hold { if moment == song { moment = idle } }
  // a track you skipped to, or play and pause from the keys: what plays now
  on change media.title { if armed && skipped != 0 && !launcher.open && media.title != null { moment = song; ticks += 1 } }
  on change play_key { if armed && !launcher.open && media.title != null { moment = song; ticks += 1 } }

  // a click anywhere but a workspace (or a symbol, which opens its page) opens the launcher
  stack { width: island_w; height: island_h; bg: ink; border: 1, edge
    radius: corner; corners: squircle
    cursor: pointer
    on click { launcher.by_pointer = true; launcher.open = !launcher.open }
    shadow: 0 3px 10px $shadow.alpha(0.3)
    font: mono 12px 600

    row { height: island_h; pad: 0, pad; align: center
      opacity: (moment == idle ? 1 : 0) ~ (moment == idle ? clear_back : clear_out)
      // the launcher or a notification growing out of this island: it is the island
      // now, so nothing of this shows through it
      when (launcher.open || notify.shown) && screens.focused?.name == screen.name { opacity: 0 ~ 80ms }
      row { width: left_w; height: island_h; align: center; shrink: 0; clip: true
        row { id: chipbox; height: island_h; align: center; shrink: 0; Chips (shown ?? now) }
      }
      spacer {}
      row { width: right_w; height: island_h; justify: end; align: center; shrink: 0
        row { id: statbox; height: island_h; align: center; shrink: 0
          Status
          text clock.format(date_format) { color: $fg.alpha(0.55); margin: 0, 0, 0, 10; shrink: 0; font: sans 12px 500 }
          text clock.format(clock_format) { color: $fg.alpha(0.92); margin: 0, 0, 0, 7; shrink: 0; roll: true; font: mono 13px 600 }
        }
      }
    }

    // what plays, live, in the middle
    row { height: island_h; justify: center; align: center; hit: none
      opacity: (moment == idle ? 1 : 0) ~ (moment == idle ? clear_back : clear_out)
      when (launcher.open || notify.shown) && screens.focused?.name == screen.name { opacity: 0 ~ 80ms }
      // mounted while it plays; the room, measured, only fades it (a mount that
      // waited on the boxes would move them)
      if waving { PlayWave { room: wave_room; at: chips_end + wave_gap - (chipbox.box.x - pad); len: max(wave_len, wave_min) } }
    }

    // one's fade laid over the other's
    row { height: island_h; justify: center; align: center; hit: none
      stack { height: island_h; align: center; hit: none
        if moment == vol { Level volume_glyph() { value: audio.sink.muted ? 0.0 : audio.sink.volume } }
        if moment == mic { Level (audio.source.muted ? "mic_off" : "mic") { value: audio.source.muted ? 0.0 : audio.source.volume } }
        if moment == bright { Level "light_mode" { value: brightness.level } }
        if moment == kbd { Level "keyboard" { value: brightness.keyboard } }
        if moment == song { Song skipped }
      }
    }
  }
}

// a symbol and a bar, for a moment; the bar itself sits in the island's centre
component Level(glyph: text, value: float) {
  row { align: center; shrink: 0; hit: none
    enter { opacity: 0; scale: 0.96 }
    exit { opacity: 0 }
    row { width: level_side; justify: start; align: center; shrink: 0
      text glyph { width: sym_size; shrink: 0; font: "Material Symbols Rounded" sym_size; color: lit }
    }
    box { width: level_w; height: level_h; radius: full; shrink: 0; bg: track
      row {
        box { height: level_h; radius: full; bg: lit
          width: level_w * clamp(value, 0, 1) ~ glide
        }
      }
    }
    // the level as a figure, where the symbol's balance was
    text num(clamp(value, 0, 1) * 100, 0) { width: level_side; shrink: 0; align: end; roll: true
      color: $fg.alpha(0.6); font: mono 11px 600 }
  }
}

// The monitor's workspaces as numbered chips with the icons of the apps on
// each, largest window first (up to three); one accent highlight glides behind them to the one on screen. A scroll
// steps through them.
//
// The highlight is placed by sums of the chips' widths, so the chips change
// size only on its spring: one that comes (a workspace made) grows from
// nothing, one that goes shrinks to nothing, one that gets its first window
// widens, each on `glide`, and every chip carries the gap after it, so nothing
// in the row jumps while the highlight moves (Strand's own glide of siblings,
// on another curve, then has nothing to do).
component Chips(on: int?) {
  let chips = workspaces.slots(screen)
  let at = chips.index_of(ws => ws.id == (on ?? -1))
  // both layers from the left (each is as tall as the island), so the highlight's
  // sums line up with the chips
  stack { height: island_h; align: start
    on scroll(dy) {
      let i = clamp((at ?? 0) + (dy > 0 ? 1 : -1), 0, max(chips.len - 1, 0)).round()
      chips.skip(i).first?.focus()
    }
    // the highlight: the launcher's selection, small
    row { height: island_h; align: center
      box { height: chip_h; shrink: 0; width: chips.take(at ?? 0).sum(ws => chip_w(ws) + chip_gap) ~ glide }
      box { height: chip_h; radius: 7; shrink: 0
        width: chips.skip(at ?? 0).take(at == null ? 0 : 1).sum(ws => chip_w(ws)) ~ glide
        opacity: (at == null ? 0 : 1) ~ soft
        bg: $accent.alpha(0.18); border: 1, $accent.alpha(0.32) }
    }
    row { height: island_h; align: center
      for ws in chips key ws.id { Chip ws { lit: ws.id == (on ?? -1) } }
    }
  }
}

keyframes ping { 0%, 100% { scale: 1 }; 35% { scale: 1.45 }; duration: 520ms }

// the apps on a workspace, each once, by their largest window, biggest first: the
// order stays as focus comes and goes
fn apps_on(ws: Workspace) -> [text] {
  ws.windows.sort_by(w => -((w.rect?.width ?? 0) * (w.rect?.height ?? 0))).map(w => w.icon).distinct().take(3)
}

// its number from the left (7 px a digit) and its apps after it, so an app that
// comes is shown by the chip widening, with nothing in it moving
fn chip_w(ws: Workspace) -> float {
  17 + ws.name.len * 7 + apps_on(ws).len * (app_size + app_gap)
}

component Chip(ws: Workspace, lit: bool = false) {
  row { width: chip_w(ws) + chip_gap ~ glide; height: chip_h; shrink: 0; clip: true
    enter { width: 0; opacity: 0 }
    exit { width: 0; opacity: 0 }
    row { id: c; width: chip_w(ws) ~ glide; height: chip_h; radius: 7; gap: app_gap; pad: 0, 0, 0, 8; align: center; shrink: 0
      cursor: pointer
      on click { ws.focus() }
      bg: (!lit && c.hover ? $fg.alpha(0.07) : $fg.alpha(0)) ~ soft
      text ws.name { shrink: 0; margin: 0, 1, 0, 0; font: mono 11px 700
        color: (lit ? $accent : ws.urgent ? warn : ws.occupied ? used : empty) ~ soft
        // asking for attention: one pop, then it stays orange
        on change ws.urgent { if ws.urgent && !lit { play ping } } }
      for a in apps_on(ws) key a {
        image a { size: app_size; shrink: 0; opacity: (lit ? 1 : 0.8) ~ soft
          enter { opacity: 0 }
          exit { opacity: 0 } }
      }
    }
  }
}

// Wi-Fi, volume and the battery always in the same place, counted from the right.
// The ones only there while they are true (a Bluetooth device connected, a drive,
// a muted mic, …) sit to their left, so they never move them.
component Status {
  row { align: center; shrink: 0
    // a tray app that wants you, by its own icon: a click opens the Tray page
    for i in tray.items.filter(i => i.status == "NeedsAttention").take(2) key i.id {
      row { width: sym_cell; height: island_h; justify: center; align: center; shrink: 0; cursor: pointer
        enter { opacity: 0 }
        exit { opacity: 0 }
        on click { launcher.by_pointer = true; launcher.tray_key = !launcher.tray_key }
        image i.icon { size: 14; shrink: 0; opacity: 0.85 }
      }
    }
    // recording the screen: a click stops it
    if record.recording {
      row { cursor: pointer; on click { record.key = !record.key }
        Sym "radio_button_checked" { tint: danger }
      }
    }
    // notifications not yet opened or cleared, or do not disturb: a click opens their page
    if notifications.dnd || notifications.count > 0 {
      row { cursor: pointer; on click { launcher.by_pointer = true; launcher.notes_key = !launcher.notes_key }
        Sym (notifications.dnd ? "notifications_off" : "notifications_unread") {
          tint: notifications.dnd ? dim : $accent }
      }
    }
    // a muted microphone: a click opens the Sound page, where it unmutes
    if audio.source.muted {
      row { cursor: pointer; on click { launcher.by_pointer = true; launcher.sound_key = !launcher.sound_key }
        Sym "mic_off" { tint: danger }
      }
    }
    // a drive plugged in: a click opens its page, to mount it or eject it
    if drives.all.len > 0 {
      row { cursor: pointer; on click { launcher.by_pointer = true; launcher.drives_key = !launcher.drives_key }
        Sym "usb"
      }
    }
    // a Bluetooth device connected: a click opens its page
    if bluetooth.devices.any(d => d.connected) {
      row { cursor: pointer; on click { launcher.by_pointer = true; launcher.bt_key = !launcher.bt_key }
        Sym "bluetooth_connected"
      }
    }
    // a click opens its page of the launcher; a scroll on the volume sets it
    if network.available {
      row { cursor: pointer; on click { launcher.by_pointer = true; launcher.wifi_key = !launcher.wifi_key }
        Sym net_glyph() { tint: network.connected ? dim : warn }
      }
    }
    row { cursor: pointer
      on click { launcher.by_pointer = true; launcher.sound_key = !launcher.sound_key }
      on scroll(dy) { audio.sink.volume = clamp(audio.sink.volume - dy * 0.05, 0, 1) }
      Sym volume_glyph()
    }
    // the battery's figure while it runs low or charges
    if battery.present && (battery.percent < 0.3 || battery.charging) {
      text num(battery.percent * 100, 0) { color: battery_color(); shrink: 0; margin: 0, 0, 0, 4; font: mono 11px 600 }
    }
    if battery.present { Sym battery_glyph() { tint: battery_color() } }
  }
}

// what plays, live: a line in the accent, nudged when a track comes on its own; a
// only shown: a click goes through it to the island (the launcher)
// out of the island's flow (its size follows the boxes, so it may move none of
// them), from just past the workspaces to just short of the symbols
component PlayWave(room: bool, at: float, len: float) {
  row { place: absolute; x: at; y: 0; width: len; height: island_h; justify: center; align: center; hit: none
    opacity: (room ? 1 : 0) ~ soft
    enter { opacity: 0; scale: 0.85 }
    exit { opacity: 0; scale: 0.85 }
    on change media.title { if skipped == 0 { play bump } }
    // one line from the bass (left) to the highs (right), fading out at both ends
    // (a fade masks one edge, so one inside the other)
    row { mask: fade(left, wave_fade); grow: 1
      row { mask: fade(right, wave_fade); grow: 1
        spectrum audio.sink { bars: 40; style: line; smooth: 0.75; grow: 1; height: 18; color: $accent }
      }
    }
  }
}

// a track you skipped to: its art, title and artist, and whether it plays,
// coming in from the side you skipped to
component Song(dir: int) {
  row { width: island_w - 2 * pad; height: island_h; justify: center; align: center; gap: 10; hit: none
    enter { opacity: 0; x: dir * 16 }
    exit { opacity: 0 }
    if media.art != null {
      image media.art ?? "" { width: 22; height: 22; fit: cover; radius: 5; corners: squircle; shrink: 0 }
    } else {
      text "music_note" { width: 22; shrink: 0; font: "Material Symbols Rounded" sym_size; color: lit }
    }
    row { shrink: 1; align: center; max_width: 400
      text media.title ?? "" { color: lit; font: sans 13px 600; shrink: 1; ellipsis: end }
      if (media.artist ?? "") != "" {
        text " · " + (media.artist ?? "") { color: $fg.alpha(0.55); font: sans 12px 500; shrink: 2; ellipsis: end }
      }
    }
    text media.playing ? "play_arrow" : "pause" { width: sym_size; shrink: 0; font: "Material Symbols Rounded" sym_size; color: $fg.alpha(0.6) }
  }
}

component Sym(name: text, tint: color = dim) {
  // the name stays in its cell even with the font missing
  row { width: sym_cell; height: island_h; justify: center; align: center; shrink: 0; clip: true
    enter { opacity: 0 }
    exit { opacity: 0 }
    text name { width: sym_size; shrink: 0; font: "Material Symbols Rounded" sym_size; color: tint ~ soft }
  }
}

fn net_glyph() -> text {
  !network.connected ? "signal_wifi_off"
    : network.ssid == null ? "lan"
    : network.strength > 0.75 ? "signal_wifi_4_bar"
    : network.strength > 0.5 ? "network_wifi_3_bar"
    : network.strength > 0.25 ? "network_wifi_2_bar"
    : "network_wifi_1_bar"
}

fn volume_glyph() -> text {
  audio.sink.muted ? "volume_off"
    : audio.sink.volume > 0.5 ? "volume_up"
    : audio.sink.volume > 0 ? "volume_down"
    : "volume_mute"
}

fn battery_glyph() -> text {
  battery.charging ? "battery_charging_full"
    : battery.percent > 0.9 ? "battery_full"
    : battery.percent > 0.75 ? "battery_6_bar"
    : battery.percent > 0.6 ? "battery_5_bar"
    : battery.percent > 0.45 ? "battery_4_bar"
    : battery.percent > 0.3 ? "battery_3_bar"
    : battery.percent > battery_low ? "battery_2_bar"
    : battery.percent > battery_out ? "battery_1_bar"
    : "battery_alert"
}

fn battery_color() -> color {
  battery.charging ? dim
    : battery.percent < battery_out ? danger
    : battery.percent < battery_low ? warn
    : dim
}
