// record.strand: a recording of the focused monitor, every frame Hyprland draws,
// into ~/Videos. Start and stop it from the launcher, the island's red dot, or a
// key bound to: strand toggle record.key

permit exec "mkdir", "wf-recorder"

// the folder made first, if it isn't there; stopping wf-recorder finishes the
// file. -y: never stop to ask about a file; x264 at its fastest, so frames
// aren't dropped.
action videos(dir: path) -> text? ["mkdir", "-p", dir]
action rec(output: text, file: path) ["wf-recorder", "-y", "-o", output, "-c", "libx264",
  "-p", "preset=ultrafast", "-p", "crf=18", "-f", file]

export state key = false            // flipped by whatever starts or stops it
export let recording = rec.running
export let failed = rec.error       // why the last one didn't start or ended badly

on change key {
  if rec.running { rec.stop() }
  else {
    await videos("~/Videos")
    rec(screens.focused?.name ?? "", "~/Videos/strand-" + clock.format("%Y-%m-%d-%H%M%S") + ".mp4")
  }
}
