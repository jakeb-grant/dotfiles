// record.strand: a recording of the focused monitor, every frame Hyprland draws,
// into ~/Videos. Start and stop it from the launcher, the island's red dot, or a
// key bound to: strand toggle record.key

permit exec "sh"

// Strand passes `~` through as it is, so sh finds the home folder; `exec` leaves
// wf-recorder in its place, so stopping it finishes the file. -y: never stop to
// ask about a file; x264 at its fastest, so frames aren't dropped.
action rec(output: text, name: text) ["sh", "-c",
  "mkdir -p \"$HOME/Videos\" && exec wf-recorder -y -o \"$1\" -c libx264 -p preset=ultrafast -p crf=18 -f \"$HOME/Videos/$2\"",
  "sh", output, name]

export state key = false            // flipped by whatever starts or stops it
export let recording = rec.running
export let failed = rec.error       // why the last one didn't start or ended badly

on change key {
  if rec.running { rec.stop() }
  else { rec(screens.focused?.name ?? "", "strand-" + clock.format("%Y-%m-%d-%H%M%S") + ".mp4") }
}
