-- Cursor
-- ------------------------------------------------------------------------------
hl.config({ cursor = { hide_on_key_press = true } })
{{ if or (eq .graphics "nvidia") (eq .graphics "prime") -}}
hl.config({ cursor = { no_hardware_cursors = 1 } })
{{ end -}}

-- ------------------------------------------------------------------------------
-- Misc + Debug
-- ------------------------------------------------------------------------------
hl.config({
  misc = {
    disable_hyprland_logo    = true,
    disable_splash_rendering = true,
    force_default_wallpaper  = -1,
    -- a lock screen that dies (Strand's, or hyprlock as the fallback) can be taken over by
    -- another locker, from a text console, without ever unlocking the session:
    -- Ctrl+Alt+F2, log in, hyprctl -i 0 dispatch 'hl.dsp.exec_cmd("hyprlock")', Ctrl+Alt+F1
    allow_session_lock_restore = true,
  },
  ecosystem = {
    no_update_news  = true,
    no_donation_nag = true,
  },
  debug = {
    vfr = true,
  },
})

-- ------------------------------------------------------------------------------
-- Window Rules
-- ------------------------------------------------------------------------------
hl.window_rule({
  name           = "suppress-maximize",
  match          = { class = ".*" },
  suppress_event = "maximize",
})
hl.window_rule({
  name     = "no-focus-empty-xwayland-float",
  match    = { class = "^$", title = "^$", xwayland = true,
               float = true, fullscreen = false, pin = false },
  no_focus = true,
})
hl.window_rule({
  name  = "picture-in-picture",
  match = { title = "^Picture.in.[Pp]icture$" },
  float = true,
  pin   = true,
  size  = { 480, 270 },
  move  = { "monitor_w-500", "monitor_h-290" },
})

-- ------------------------------------------------------------------------------
-- Layer Rules
-- ------------------------------------------------------------------------------
-- From `strand compositor-rules`: Strand animates its own surfaces (enter, exit,
-- morph), so Hyprland's layer fade would play over them
hl.layer_rule({
  name    = "strand-no-anim",
  match   = { namespace = "^strand-.*$" },
  no_anim = true,
})
