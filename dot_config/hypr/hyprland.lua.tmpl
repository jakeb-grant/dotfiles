-- ==============================================================================
-- Hyprland Configuration
-- Hand-edited chezmoi template — Go-template blocks carry machine-specific GPU
-- config; palette colors come from require("palette"), generated by theme-switch.
-- ==============================================================================

-- ------------------------------------------------------------------------------
-- Programs
-- ------------------------------------------------------------------------------
local terminal     = "ghostty +new-window"
local editor       = "zeditor --wait"
local file_manager = "pane-fm"
local mod          = "SUPER"

-- ------------------------------------------------------------------------------
-- Environment Variables
-- ------------------------------------------------------------------------------
hl.env("EDITOR",                       "zeditor")
hl.env("VISUAL",                       "zeditor")
hl.env("GIT_EDITOR",                   "zeditor --wait")
hl.env("GDK_BACKEND",                  "wayland,x11")
hl.env("XCURSOR_THEME",                "Bibata-Modern-Classic")
hl.env("XCURSOR_SIZE",                 "24")
hl.env("HYPRCURSOR_SIZE",              "24")
hl.env("PATH",                         os.getenv("HOME") .. "/.local/bin:" .. (os.getenv("PATH") or ""))
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

{{ if eq .graphics "intel" -}}
-- Intel iGPU
hl.env("LIBVA_DRIVER_NAME", "iHD")
{{ end -}}
{{ if or (eq .graphics "nvidia") (eq .graphics "prime") -}}
-- NVIDIA environment variables
hl.env("LIBVA_DRIVER_NAME",             "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME",     "nvidia")
hl.env("NVD_BACKEND",                   "direct")
{{ if eq .graphics "prime" -}}
-- Multi-monitor support for hybrid graphics
hl.env("AQ_DRM_DEVICES", "/dev/dri/card1:/dev/dri/card0")
{{ end -}}
{{ end -}}

-- ------------------------------------------------------------------------------
-- Palette (generated by theme-switch from ~/.config/palette/active.json)
-- ------------------------------------------------------------------------------
local p = require("palette")

-- ------------------------------------------------------------------------------
-- Monitor Configuration
-- ------------------------------------------------------------------------------
-- Loaded from external file to persist across theme changes. A load failure
-- (usually a syntax error in a hand-edited monitors.lua) would otherwise
-- silently fall back to Hyprland's default auto-detection — surface it.
local mon_ok, mon_err = pcall(require, "monitors")
if not mon_ok then
  local msg = "monitors.lua failed to load: " .. tostring(mon_err)
  print(msg)
  hl.exec_cmd("notify-send -u critical Hyprland '" .. msg:gsub("'", "'\\''") .. "'")
end

-- ------------------------------------------------------------------------------
-- Autostart
-- ------------------------------------------------------------------------------
local autostart = {
  "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_ID XDG_SESSION_TYPE",
  "nm-applet --indicator",
  "phylax",
  "hyprctl setcursor Bibata-Modern-Classic 24",
  "awww-daemon",
  "wl-paste --watch cliphist store",
  "quickshell",
  "hypridle",
  "hyprpier daemon",
}
hl.on("hyprland.start", function()
  for _, cmd in ipairs(autostart) do hl.exec_cmd(cmd) end
end)

-- ------------------------------------------------------------------------------
-- Keybindings
-- ------------------------------------------------------------------------------

-- Applications
hl.bind(mod .. " + Space",         hl.dsp.global("quickshell:launcher"))
hl.bind(mod .. " + Return",        hl.dsp.exec_cmd(terminal))
hl.bind(mod .. " + SHIFT + B",     hl.dsp.exec_cmd("xdg-open https://"))
hl.bind(mod .. " + SHIFT + F",     hl.dsp.exec_cmd(file_manager))
hl.bind(mod .. " + SHIFT + Z",     hl.dsp.exec_cmd(editor))

-- Window management
hl.bind(mod .. " + W", hl.dsp.window.close())
hl.bind(mod .. " + T", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mod .. " + O", hl.dsp.window.pin())
hl.bind(mod .. " + P", hl.dsp.window.pseudo())
hl.bind(mod .. " + J", hl.dsp.layout("togglesplit"))
hl.bind(mod .. " + F", hl.dsp.window.fullscreen())
hl.bind(mod .. " + L", hl.dsp.global("quickshell:lock"))

-- Bar mode toggle
hl.bind(mod .. " + SHIFT + T", hl.dsp.exec_cmd("toggle-bar-mode"))

-- Notifications (Quickshell global shortcuts)
hl.bind(mod .. " + comma",         hl.dsp.global("quickshell:notif-dismiss"))
hl.bind(mod .. " + SHIFT + comma", hl.dsp.global("quickshell:notif-dismiss-all"))

-- Move focus + swap windows with arrow keys
local dirs = { left = "l", right = "r", up = "u", down = "d" }
for key, d in pairs(dirs) do
  hl.bind(mod .. " + " .. key,         hl.dsp.focus({ direction = d }))
  hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.swap({ direction = d }))
end

-- Resize windows (relative = true for delta-style resize, matching the legacy
-- `resizeactive 50 0` behavior; without the flag, x/y are treated as absolute).
hl.bind(mod .. " + equal",         hl.dsp.window.resize({ x =  50, y =   0, relative = true }), { repeating = true })
hl.bind(mod .. " + minus",         hl.dsp.window.resize({ x = -50, y =   0, relative = true }), { repeating = true })
hl.bind(mod .. " + SHIFT + equal", hl.dsp.window.resize({ x =   0, y =  50, relative = true }), { repeating = true })
hl.bind(mod .. " + SHIFT + minus", hl.dsp.window.resize({ x =   0, y = -50, relative = true }), { repeating = true })

-- Switch workspaces + move active window to workspace
for digit = 0, 9 do
  local ws  = digit == 0 and 10 or digit
  local key = tostring(digit)
  hl.bind(mod .. " + " .. key,         hl.dsp.focus({ workspace = ws }))
  hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = ws }))
end
hl.bind(mod .. " + Tab",         hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mod .. " + SHIFT + Tab", hl.dsp.focus({ workspace = "e-1" }))
hl.bind(mod .. " + CTRL + Tab",  hl.dsp.focus({ workspace = "previous" }))

-- Special workspace (scratchpad)
hl.bind(mod .. " + S",         hl.dsp.workspace.toggle_special("magic"))
hl.bind(mod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }))

-- Scroll through workspaces
hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-- Mouse bindings
hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Screenshots (save to ~/Pictures/Screenshots/ and copy to clipboard)
local function screenshot(grab)
  return hl.dsp.exec_cmd([[sh -c 'f=~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && mkdir -p ~/Pictures/Screenshots && ]] .. grab .. [[ "$f" && wl-copy < "$f"']])
end
hl.bind("Print",         screenshot('grim -g "$(slurp)"'))
hl.bind("SHIFT + Print", screenshot("grim"))
hl.bind(mod .. " + Print", hl.dsp.exec_cmd("hyprpicker -a"))

-- Laptop function keys
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl set +5%"),                       { repeating = true, locked = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl set 5%-"),                       { repeating = true, locked = true })
hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"), { repeating = true, locked = true })
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),    { repeating = true, locked = true })
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),   { repeating = true, locked = true })
hl.bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { repeating = true, locked = true })
hl.bind("XF86AudioPlay",         hl.dsp.global("quickshell:media-playpause"), { locked = true })
hl.bind("XF86AudioPause",        hl.dsp.global("quickshell:media-playpause"), { locked = true })
hl.bind("XF86AudioNext",         hl.dsp.global("quickshell:media-next"),      { locked = true })
hl.bind("XF86AudioPrev",         hl.dsp.global("quickshell:media-prev"),      { locked = true })

