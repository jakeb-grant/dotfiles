-- ==============================================================================
-- Hyprland Configuration
-- Hand-edited chezmoi template — Go-template blocks carry machine-specific GPU
-- config; palette colors come from require("palette"), generated by theme-switch.
-- ==============================================================================

-- ------------------------------------------------------------------------------
-- Programs
-- ------------------------------------------------------------------------------
local terminal     = "kitty -1"
local editor       = "zeditor"
local file_manager = terminal .. " yazi"
local mod          = "SUPER"

-- ------------------------------------------------------------------------------
-- Environment Variables
-- ------------------------------------------------------------------------------
hl.env("TERMINAL",                     "term")   -- ~/.local/bin/term, Kitty's single instance: Strand runs Terminal=true apps with it
hl.env("EDITOR",                       "zeditor")
hl.env("VISUAL",                       "zeditor")
hl.env("GIT_EDITOR",                   "zeditor --wait")
hl.env("GDK_BACKEND",                  "wayland,x11")
hl.env("XCURSOR_THEME",                "phinger-cursors-light")  -- cursor.sync_gsettings_theme hands it to GTK
hl.env("XCURSOR_SIZE",                 "24")
hl.env("HYPRCURSOR_SIZE",              "24")
-- once: a reload re-runs this with the PATH it set last time
local path, bin = os.getenv("PATH") or "", os.getenv("HOME") .. "/.local/bin"
if not (":" .. path .. ":"):find(":" .. bin .. ":", 1, true) then hl.env("PATH", bin .. ":" .. path) end
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

{{ if eq .graphics "intel" -}}
-- Intel iGPU
hl.env("LIBVA_DRIVER_NAME", "iHD")
{{ end -}}
{{ if or (eq .graphics "nvidia") (eq .graphics "prime") -}}
-- NVIDIA environment variables
hl.env("LIBVA_DRIVER_NAME",             "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME",     "nvidia")
hl.env("NVD_BACKEND",                   "direct")
{{ if eq .graphics "prime" -}}
-- Multi-monitor support for hybrid graphics
hl.env("AQ_DRM_DEVICES", "/dev/dri/igpu:/dev/dri/dgpu")  -- stable names from run_onchange_setup-gpu-symlinks
{{ end -}}
{{ end -}}

-- ------------------------------------------------------------------------------
-- Palette (generated by theme-switch from ~/.config/palette/active.json)
-- ------------------------------------------------------------------------------
local p = require("palette")

-- ------------------------------------------------------------------------------
-- Monitor Configuration
-- ------------------------------------------------------------------------------
-- Loaded from external file to persist across theme changes. A load failure
-- (usually a syntax error in a hand-edited monitors.lua) would otherwise
-- silently fall back to Hyprland's default auto-detection — surface it, in
-- Hyprland's own overlay, since at login no notification daemon is up yet.
local mon_ok, mon_err = pcall(require, "monitors")
if not mon_ok then
  local msg = "monitors.lua failed to load: " .. tostring(mon_err)
  print(msg)
  hl.notification.create({ text = msg, duration = 15000, icon = 3 })
end

-- ------------------------------------------------------------------------------
-- Autostart
-- ------------------------------------------------------------------------------
local autostart = {
  "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_ID XDG_SESSION_TYPE",
  "awww-daemon",
  -- The power key opens Strand's power page (bound below) instead of logind powering off
  "systemd-inhibit --what=handle-power-key --who=Hyprland --why='The power key opens the power page' sleep infinity",
  "strand run",
  "hypridle",
  "hyprpier daemon",
}
hl.on("hyprland.start", function()
  for _, cmd in ipairs(autostart) do hl.exec_cmd(cmd) end
end)

-- ------------------------------------------------------------------------------
-- Keybindings
-- ------------------------------------------------------------------------------
-- Each bind's description, "Group: what it does", is what the Strand launcher's
-- Keys page lists (it reads `hyprctl binds -j`): binds sharing one are shown as
-- one line. A bind without one is listed under Other.

-- Applications
hl.bind(mod .. " + Space",         hl.dsp.exec_cmd("strand toggle launcher.open"), { description = "Shell: Launcher" })
hl.bind(mod .. " + V",             hl.dsp.exec_cmd("strand toggle launcher.clipboard_key"), { description = "Shell: Clipboard" })
hl.bind("XF86PowerOff",            hl.dsp.exec_cmd("strand toggle launcher.power_key"), { description = "Shell: Power" })
hl.bind(mod .. " + Return",        hl.dsp.exec_cmd(terminal), { description = "Apps: Terminal" })
hl.bind(mod .. " + SHIFT + B",     hl.dsp.exec_cmd("xdg-open https://"), { description = "Apps: Browser" })
hl.bind(mod .. " + SHIFT + F",     hl.dsp.exec_cmd(file_manager), { description = "Apps: Files" })
hl.bind(mod .. " + SHIFT + Z",     hl.dsp.exec_cmd(editor), { description = "Apps: Editor" })

-- Window management
hl.bind(mod .. " + W", hl.dsp.window.close(), { description = "Windows: Close" })
hl.bind(mod .. " + T", hl.dsp.window.float({ action = "toggle" }), { description = "Windows: Float or tile" })
hl.bind(mod .. " + O", hl.dsp.window.pin(), { description = "Windows: Pin to every workspace" })
hl.bind(mod .. " + P", hl.dsp.window.pseudo(), { description = "Windows: Pseudo-tile" })
hl.bind(mod .. " + J", hl.dsp.layout("togglesplit"), { description = "Windows: Turn the split" })
hl.bind(mod .. " + F", hl.dsp.window.fullscreen(), { description = "Windows: Fullscreen" })
hl.bind(mod .. " + U", hl.dsp.focus({ urgent_or_last = true }), { description = "Windows: Go to the one asking for attention" })
hl.bind(mod .. " + L", hl.dsp.exec_cmd("loginctl lock-session"), { description = "Shell: Lock" })

-- Notifications (Strand: the one showing, or every one waiting)
hl.bind(mod .. " + comma",         hl.dsp.exec_cmd("strand toggle notify.clear_key"), { description = "Shell: Clear the notification" })
hl.bind(mod .. " + SHIFT + comma", hl.dsp.exec_cmd("strand toggle notify.clear_all_key"), { description = "Shell: Clear every notification" })

-- Focus, move and swap windows with arrow keys. Move carries a window past the
-- last tile onto the next monitor, even an empty one; swap needs a window there.
local dirs = { left = "l", right = "r", up = "u", down = "d" }
for key, d in pairs(dirs) do
  hl.bind(mod .. " + " .. key,         hl.dsp.focus({ direction = d }), { description = "Arrange: Focus" })
  hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ direction = d }), { description = "Arrange: Move" })
  hl.bind(mod .. " + CTRL + " .. key,  hl.dsp.window.swap({ direction = d }), { description = "Arrange: Swap" })
end

-- Resize windows (relative = true for delta-style resize, matching the legacy
-- `resizeactive 50 0` behavior; without the flag, x/y are treated as absolute).
hl.bind(mod .. " + equal",         hl.dsp.window.resize({ x =  50, y =   0, relative = true }), { description = "Arrange: Wider or narrower", repeating = true })
hl.bind(mod .. " + minus",         hl.dsp.window.resize({ x = -50, y =   0, relative = true }), { description = "Arrange: Wider or narrower", repeating = true })
hl.bind(mod .. " + SHIFT + equal", hl.dsp.window.resize({ x =   0, y =  50, relative = true }), { description = "Arrange: Taller or shorter", repeating = true })
hl.bind(mod .. " + SHIFT + minus", hl.dsp.window.resize({ x =   0, y = -50, relative = true }), { description = "Arrange: Taller or shorter", repeating = true })

-- Switch workspaces + move active window to workspace
for digit = 0, 9 do
  local ws  = digit == 0 and 10 or digit
  local key = tostring(digit)
  hl.bind(mod .. " + " .. key,         hl.dsp.focus({ workspace = ws }), { description = "Workspaces: Go to" })
  hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = ws }), { description = "Workspaces: Send the window to" })
end
hl.bind(mod .. " + Tab",         hl.dsp.focus({ workspace = "e+1" }), { description = "Workspaces: Next" })
hl.bind(mod .. " + SHIFT + Tab", hl.dsp.focus({ workspace = "e-1" }), { description = "Workspaces: Previous" })
hl.bind(mod .. " + CTRL + Tab",  hl.dsp.focus({ workspace = "previous" }), { description = "Workspaces: Last one" })

-- Special workspace (scratchpad)
hl.bind(mod .. " + S",         hl.dsp.workspace.toggle_special("magic"), { description = "Workspaces: Scratchpad" })
hl.bind(mod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }), { description = "Workspaces: Send the window to the scratchpad" })

-- Scroll through workspaces
hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }), { description = "Workspaces: Next" })
hl.bind(mod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }), { description = "Workspaces: Previous" })

-- Mouse bindings
hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(),   { description = "Arrange: Move", mouse = true })
hl.bind(mod .. " + mouse:273", hl.dsp.window.resize(), { description = "Arrange: Resize", mouse = true })

-- Screenshots (~/.local/bin/screenshot: capture, clipboard, notification)
hl.bind("Print",         hl.dsp.exec_cmd("screenshot region"), { description = "Screen: Screenshot of an area" })
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("screenshot full"), { description = "Screen: Screenshot of everything" })
hl.bind(mod .. " + Print", hl.dsp.exec_cmd("hyprpicker -a"), { description = "Screen: Pick a colour" })

-- Laptop function keys
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl set +5%"),                       { description = "Screen: Brightness", repeating = true, locked = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl set 5%-"),                       { description = "Screen: Brightness", repeating = true, locked = true })
hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"), { description = "Sound: Volume", repeating = true, locked = true })
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),    { description = "Sound: Volume", repeating = true, locked = true })
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),   { description = "Sound: Mute", locked = true })
hl.bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { description = "Sound: Mute the microphone", locked = true })
hl.bind("XF86AudioPlay",         hl.dsp.exec_cmd("strand toggle island.play_key"), { description = "Sound: Play or pause", locked = true })
hl.bind("XF86AudioPause",        hl.dsp.exec_cmd("strand toggle island.play_key"), { description = "Sound: Play or pause", locked = true })
hl.bind("XF86AudioNext",         hl.dsp.exec_cmd("strand toggle island.next_key"), { description = "Sound: Next track", locked = true })
hl.bind("XF86AudioPrev",         hl.dsp.exec_cmd("strand toggle island.prev_key"), { description = "Sound: Previous track", locked = true })

-- ------------------------------------------------------------------------------
-- General Settings
-- ------------------------------------------------------------------------------
hl.config({
  general = {
    -- Tiles sit 2 * gaps_in apart; the top gap plus island.strand's gap_low
    -- puts the island that far above the windows too
    gaps_in     = 3,
    gaps_out    = { top = 4, right = 10, bottom = 10, left = 10 },
    border_size = 2,
    col = {
      active_border   = p.accent_rgba(1.0),
      inactive_border = p.surface1_rgba(0.8),
    },
    layout = "dwindle",
  },
})

-- ------------------------------------------------------------------------------
-- Decoration
-- ------------------------------------------------------------------------------
hl.config({
  decoration = {
    rounding = 5,
    blur = {
      enabled  = true,
      size     = 3,
      passes   = 1,
      vibrancy = 0.1696,
    },
    shadow = {
      enabled      = true,
      range        = 4,
      render_power = 3,
      -- crust on a dark palette; on a light one its crust is pale, so a soft black
      color        = p.dark and p.crust_rgba(0.93) or "rgba(00000040)",
    },
  },
})

-- ------------------------------------------------------------------------------
-- Animations
-- ------------------------------------------------------------------------------
-- Spaces inside `{ {` are intentional: chezmoi parses paired braces as Go template
-- delimiters, so Lua's nested-table syntax must keep them visually separated.
hl.curve("easeOutQuint",   { type = "bezier", points = { {0.23, 1},    {0.32, 1} } })
hl.curve("linear",         { type = "bezier", points = { {0, 0},       {1, 1} } })
hl.curve("almostLinear",   { type = "bezier", points = { {0.5, 0.5},   {0.75, 1.0} } })
hl.curve("quick",          { type = "bezier", points = { {0.15, 0},    {0.1, 1} } })

local anim = {
  { "global",        speed = 10,   bezier = "default" },
  { "border",        speed = 5.39, bezier = "easeOutQuint" },
  { "windows",       speed = 4.79, bezier = "easeOutQuint" },
  { "windowsIn",     speed = 4.1,  bezier = "easeOutQuint", style = "popin 87%" },
  { "windowsOut",    speed = 1.49, bezier = "linear",       style = "popin 87%" },
  { "fadeIn",        speed = 1.73, bezier = "almostLinear" },
  { "fadeOut",       speed = 1.46, bezier = "almostLinear" },
  { "fade",          speed = 3.03, bezier = "quick" },
  -- Layer animations reach only awww and slurp/hyprpicker: Strand animates its
  -- own surfaces and is exempt (the strand-no-anim rule below)
  { "layers",        speed = 3.81, bezier = "easeOutQuint" },
  { "layersIn",      speed = 4,    bezier = "easeOutQuint", style = "fade" },
  { "layersOut",     speed = 1.5,  bezier = "linear",       style = "fade" },
  { "fadeLayersIn",  speed = 1.79, bezier = "almostLinear" },
  { "fadeLayersOut", speed = 1.39, bezier = "almostLinear" },
  { "workspaces",    speed = 1.94, bezier = "almostLinear", style = "fade" },
  { "workspacesIn",  speed = 1.21, bezier = "almostLinear", style = "fade" },
  { "workspacesOut", speed = 1.94, bezier = "almostLinear", style = "fade" },
}
for _, a in ipairs(anim) do
  hl.animation({ leaf = a[1], enabled = true, speed = a.speed, bezier = a.bezier, style = a.style })
end

-- ------------------------------------------------------------------------------
-- Layouts
