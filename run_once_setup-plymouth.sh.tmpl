#!/bin/bash
# Setup Plymouth boot splash (runs once on new machines)

set -e

# Check if plymouth is installed
if ! command -v plymouth &> /dev/null; then
    echo "Plymouth is not installed."
    echo "Install it first: sudo pacman -S plymouth"
    exit 1
fi

echo "Configuring Plymouth boot splash..."
echo "This requires sudo access."

# Install custom minimal theme
THEME_DIR="/usr/share/plymouth/themes/minimal"
SOURCE_DIR="$HOME/.config/plymouth-theme"

echo "Installing minimal Plymouth theme..."
sudo mkdir -p "$THEME_DIR"
sudo cp "$SOURCE_DIR"/*.plymouth "$THEME_DIR/"
sudo cp "$SOURCE_DIR"/*.png "$THEME_DIR/"
sudo chmod 644 "$THEME_DIR"/*

# Configure Plymouth to use minimal theme
PLYMOUTH_CONF="/etc/plymouth/plymouthd.conf"
echo "Setting Plymouth theme to minimal..."
sudo mkdir -p /etc/plymouth
sudo tee "$PLYMOUTH_CONF" > /dev/null << 'EOF'
[Daemon]
Theme=minimal
ShowDelay=0
EOF

# Add plymouth hook to mkinitcpio if not present
MKINITCPIO_CONF="/etc/mkinitcpio.conf"
if ! grep -q "plymouth" "$MKINITCPIO_CONF"; then
    echo "Adding plymouth hook to mkinitcpio.conf..."
    # Insert plymouth before encrypt (required for encrypted systems)
    sudo sed -i 's/\bencrypt\b/plymouth encrypt/' "$MKINITCPIO_CONF"
fi

# Add splash to GRUB kernel parameters if not present
GRUB_CONF="/etc/default/grub"
if ! grep -q "splash" "$GRUB_CONF"; then
    echo "Adding splash to GRUB kernel parameters..."
    sudo sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="\([^"]*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 splash"/' "$GRUB_CONF"
fi

# Configure GRUB for silent boot (hide menu and loading messages)
echo "Configuring GRUB for silent boot..."
sudo sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' "$GRUB_CONF"
if grep -q "^GRUB_TIMEOUT_STYLE=" "$GRUB_CONF"; then
    sudo sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' "$GRUB_CONF"
else
    echo 'GRUB_TIMEOUT_STYLE=hidden' | sudo tee -a "$GRUB_CONF" > /dev/null
fi

# Install dark GRUB background and dim text colors
echo "Installing dark GRUB background..."
sudo cp "$HOME/.config/grub/background.png" /boot/grub/background.png

# Set background
if grep -q "^GRUB_BACKGROUND=" "$GRUB_CONF"; then
    sudo sed -i 's|^GRUB_BACKGROUND=.*|GRUB_BACKGROUND="/boot/grub/background.png"|' "$GRUB_CONF"
else
    echo 'GRUB_BACKGROUND="/boot/grub/background.png"' | sudo tee -a "$GRUB_CONF" > /dev/null
fi

# Set dim text colors (dark-gray on black to minimize visibility)
if grep -q "^GRUB_COLOR_NORMAL=" "$GRUB_CONF"; then
    sudo sed -i 's/^GRUB_COLOR_NORMAL=.*/GRUB_COLOR_NORMAL="dark-gray\/black"/' "$GRUB_CONF"
else
    echo 'GRUB_COLOR_NORMAL="dark-gray/black"' | sudo tee -a "$GRUB_CONF" > /dev/null
fi
if grep -q "^GRUB_COLOR_HIGHLIGHT=" "$GRUB_CONF"; then
    sudo sed -i 's/^GRUB_COLOR_HIGHLIGHT=.*/GRUB_COLOR_HIGHLIGHT="dark-gray\/black"/' "$GRUB_CONF"
else
    echo 'GRUB_COLOR_HIGHLIGHT="dark-gray/black"' | sudo tee -a "$GRUB_CONF" > /dev/null
fi

# Regenerate GRUB config
echo "Regenerating GRUB config..."
sudo grub-mkconfig -o /boot/grub/grub.cfg

# Regenerate initramfs
echo "Regenerating initramfs..."
sudo mkinitcpio -P

echo "Plymouth setup complete!"
echo "Reboot to see the boot splash."
