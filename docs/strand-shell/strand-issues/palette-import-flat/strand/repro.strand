// A flat file of Catppuccin colour names, as a palette: a service reads it, and
// `palette(...)` says which name is which role. The square should draw the file's
// own text colour.
service file from file "~/palette.json" { text: color? }
use palette palette(fg: file.text) ?? material(seed: #ff00ff)
panel P { screens: all; anchor: top_left; size: auto
  row { pad: 8; bg: #000000
    box { size: 24; bg: $fg }
  }
}
